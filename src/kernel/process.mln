export Option<i32> get_exit_code(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            case p.state of {
                Zombie(code) -> ({
                    Option<i32> ret = Some(code);
                    return ret;
                });
                _ -> ({
                    return None;
                });
            };
        });
        None -> ({
            return None;
        });
    };
}

export Result<_, ProcessError> set_exit_code(i32 pid, i32 code) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    ProcessState zombie_state = Zombie(code);
    case g_procs[idx] of {
        Some(p) -> ({
            p.state = zombie_state;
            return Ok(_);
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
}

export Option<i32> get_task_id(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    case g_procs[idx] of {
        Some(p) -> ({ return p.task_id; });
        None -> ({ return None; });
    };
}

export Result<_, ProcessError> set_task_id(i32 pid, i32 tid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            Option<i32> otid = Some(tid);
            p.task_id = otid;
            return Ok(_);
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
}

// Returns Some(target_fd) if open, None if closed, or Err on invalid pid/fd.
export Result<Option<i32>, ProcessError> get_fd(i32 pid, i32 fd) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    if (fd < 0 || fd >= MAX_FDS) {
        return Err(ProcessError::InvalidFd(fd));
    }
    i32 val = g_proc_fds[idx * MAX_FDS + fd];
    if (val < 0) {
        return Ok(None);
    }
    return Ok(Some(val));
}

export Result<_, ProcessError> set_fd(i32 pid, i32 fd, Option<i32> val) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    if (fd < 0 || fd >= MAX_FDS) {
        return Err(ProcessError::InvalidFd(fd));
    }
    case val of {
        Some(v) -> ({ g_proc_fds[idx * MAX_FDS + fd] = v; });
        None -> ({ g_proc_fds[idx * MAX_FDS + fd] = -1; });
    };
    return Ok(_);
}
