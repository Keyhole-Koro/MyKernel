// A descriptor value of -1 means "closed"; it is valid data, not an API
// failure.  Therefore this is Result rather than Option.
export Result<i32, ProcessError> get_fd(i32 pid, i32 fd) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    if (fd < 0 || fd >= MAX_FDS) {
        return Err(ProcessError::InvalidFd(fd));
    }
    return Ok(g_proc_fds[idx * MAX_FDS + fd]);
}

export Result<_, ProcessError> set_fd(i32 pid, i32 fd, i32 val) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    if (fd < 0 || fd >= MAX_FDS) {
        return Err(ProcessError::InvalidFd(fd));
    }
    g_proc_fds[idx * MAX_FDS + fd] = val;
    return Ok(_);
}
