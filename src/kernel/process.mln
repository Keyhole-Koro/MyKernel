package process;

import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { Pid, ProcessExitStatus } from "@contracts/process/control.contract.mln";
import irq from "@kernel/arch/irq.mln";
import kernel_config from "kernel_config.mln";

/** Failure cases returned by process-table operations. */
export enum ProcessError {
    NoFreeSlot,
    InvalidPid(Pid),
}

/**
 * Process lifecycle; CPU scheduling states intentionally belong to ThreadState.
 * @property Loading Reserved slot whose address space and main TCB are not yet public.
 * @property Alive Committed process accepting normal syscalls and thread creation.
 * @property Exiting Final status fixed while TCB and resource cleanup is in progress.
 * @property Zombie Kernel resources are gone; the OS still holds state under this PID.
 * @property Released All that is left is the exit record, waiting to be reaped.
 */
export enum ProcessState {
    Loading,
    Alive,
    Exiting(ProcessExitStatus),
    Zombie(ProcessExitStatus),
    Released(ProcessExitStatus),
}

/**
 * Process-owned address-space and shared-resource accounting.
 * @property pid Positive process identifier associated with this table entry.
 * @property parent Process that may control and reap this one; None is the OS itself.
 * @property state Lifecycle state.
 * @property pdbr Physical page-directory base; zero after resource cleanup.
 * @property heap_break Process-wide end of the user heap.
 * @property user_stack_slots Bit n is set while a TCB owns stack slot n.
 * @property live_threads Count of Runnable, Running, and Blocked owned TCBs.
 * @property retained_threads Live plus unreaped Zombie TCB count.
 * @property cpu_ticks Timer ticks that found one of its threads running, ended
 *           threads included.
 */
export struct Process {
    Pid pid;
    Option<Pid> parent;
    ProcessState state;
    i32 pdbr;
    i32 heap_break;
    i32 user_stack_slots;
    i32 live_threads;
    i32 retained_threads;
    i32 cpu_ticks;
};

Option<Process> g_procs[16];
i32 g_slot_generations[16];
bool g_procs_initialized = false;

// A pid is `generation << 5 | slot + 1`, one word. The low bits find the table
// slot, and the generation counts how often that slot has been freed, so a pid
// kept past its reap names nobody instead of the slot's next process. The first
// process in each slot has generation 0, so those pids are simply 1 to 16.
const i32 PID_SLOT_BITS = 5;
const i32 PID_SLOT_MASK = 31;
const i32 PID_GENERATION_MASK = 0x03FFFFFF;

/** Clears all process slots. */
export void init() {
    i32 i = 0;
    while (i < kernel_config.MAX_PROCS) {
        Option<Process> empty = None;
        g_procs[i] = empty;
        g_slot_generations[i] = 0;
        i++;
    }
    g_procs_initialized = true;
}

/**
 * Finds the table slot a pid points at, without asking whether it is still there.
 * @param pid Any process identifier.
 * @return Some(zero-based slot), or None when no pid could name a slot this way.
 */
export Option<i32> slot_of(Pid pid) {
    i32 number = (i32)pid;
    if (number <= 0) { return None; }
    i32 slot = number & PID_SLOT_MASK;
    if (slot == 0 || slot > kernel_config.MAX_PROCS) { return None; }
    return Some(slot - 1);
}

/**
 * Walks the process table.
 * @param slot Zero-based slot, below kernel_config.MAX_PROCS.
 * @return Some(pid) of the process there, or None for a free slot.
 */
export Option<Pid> pid_at(i32 slot) {
    return case g_procs[slot] of { Some(p) -> Some(p.pid); None -> None; };
}

/**
 * Validates a PID and resolves it to an occupied process-table index.
 * @param pid Positive process identifier to resolve.
 * @return Ok(zero-based index), or Err(InvalidPid(pid)).
 */
Result<i32, ProcessError> index_for_pid(Pid pid) {
    i32 idx = case slot_of(pid) of {
        Some(value) -> value;
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    bool matches = case g_procs[idx] of {
        Some(p) -> p.pid == pid;
        None -> false;
    };
    if (!matches) { return Err(ProcessError::InvalidPid(pid)); }
    return Ok(idx);
}

/**
 * Reserves a process table entry in Loading state.
 * Interrupts stay off: the server task and syscalls both spawn, and a slot found
 * free must still be free when it is taken.
 * @param parent Process that will own this one; None for the OS itself.
 * @return Ok(new PID), or Err(NoFreeSlot) when all process slots are occupied.
 */
export Result<Pid, ProcessError> reserve_process(Option<Pid> parent) {
    if (!g_procs_initialized) { init(); }
    bool was_enabled = irq.save_disable();
    defer irq.restore(was_enabled);
    i32 i = 0;
    while (i < kernel_config.MAX_PROCS) {
        bool free = case g_procs[i] of { None -> true; Some(_) -> false; };
        if (free) {
            Pid pid = Pid((g_slot_generations[i] << PID_SLOT_BITS) | (i + 1));
            Process value = Process {
                pid: pid,
                parent: parent,
                state: ProcessState::Loading,
                pdbr: 0,
                heap_break: 0,
                user_stack_slots: 0,
                live_threads: 0,
                retained_threads: 0,
                cpu_ticks: 0,
            };
            Option<Process> entry = Some(value);
            g_procs[i] = entry;
            return Ok(pid);
        }
        i++;
    }
    return Err(ProcessError::NoFreeSlot);
}

/**
 * Commits a completely built address space and makes a Loading process Alive.
 * @param pid Reserved Loading process.
 * @param pdbr Fully initialized physical page-directory base.
 * @param heap_break Initial user heap break following loaded segments.
 * @return Ok(_) on commit, or Err(InvalidPid) for a missing/non-Loading process.
 */
export Result<_, ProcessError> commit_process(Pid pid, i32 pdbr, i32 heap_break) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({
            bool loading = case p.state of { Loading -> true; _ -> false; };
            if (!loading) { return Err(ProcessError::InvalidPid(pid)); }
            p.pdbr = pdbr;
            p.heap_break = heap_break;
            p.state = ProcessState::Alive;
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Releases a process-table slot, which ends its pid for good.
 * Callers use this after Loading rollback or a reap, when everything held under
 * the PID is gone: the slot is what the next process takes, so it goes last, and
 * with interrupts off, since a spawn may be waiting to take it.
 * @param pid Process slot to release.
 * @return Ok(_) on release, or Err(InvalidPid) when no such slot exists.
 */
export Result<_, ProcessError> free_proc(Pid pid) {
    bool was_enabled = irq.save_disable();
    defer irq.restore(was_enabled);
    i32 idx = index_for_pid(pid)?;
    Option<Process> empty = None;
    g_procs[idx] = empty;
    g_slot_generations[idx] = (g_slot_generations[idx] + 1) & PID_GENERATION_MASK;
    return Ok(_);
}

/**
 * @param pid Process identifier to inspect.
 * @param parent Claimed parent; None is the OS itself.
 * @return true only when the process exists and that is its parent.
 */
export bool is_child_of(Pid pid, Option<Pid> parent) {
    i32 idx = case index_for_pid(pid) of { Ok(value) -> value; Err(_) -> ({ return false; }); };
    return case g_procs[idx] of {
        Some(p) -> case p.parent of {
            Some(held) -> case parent of { Some(claimed) -> held == claimed; None -> false; };
            None -> case parent of { Some(_) -> false; None -> true; };
        };
        None -> false;
    };
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(parent), where the parent is None for the OS itself; None if absent.
 */
export Option<Option<Pid>> parent_of(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of { Some(p) -> Some(p.parent); None -> None; };
}

/**
 * Charges one timer tick to a process. The scheduler calls this from the tick
 * handler, for the process whose thread the tick interrupted.
 * @param pid Process that was running.
 */
export void charge_tick(Pid pid) {
    i32 idx = case index_for_pid(pid) of { Ok(value) -> value; Err(_) -> ({ return; }); };
    case g_procs[idx] of {
        Some(p) -> ({ p.cpu_ticks = p.cpu_ticks + 1; });
        None -> _;
    };
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(timer ticks charged to its threads so far), or None if absent.
 */
export Option<i32> cpu_ticks(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of { Some(p) -> Some(p.cpu_ticks); None -> None; };
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(lifecycle state) for an allocated process; otherwise None.
 */
export Option<ProcessState> get_state(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of { Some(p) -> Some(p.state); None -> None; };
}

/**
 * @param pid Process identifier to inspect.
 * @return true only when the process exists in Alive state.
 */
export bool accepts_threads(Pid pid) {
    return case get_state(pid) of {
        Some(state) -> case state of { Alive -> true; _ -> false; };
        None -> false;
    };
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(physical PDBR) for an allocated process; otherwise None.
 */
export Option<i32> get_pdbr(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of { Some(p) -> Some(p.pdbr); None -> None; };
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(current user heap break) for an allocated process; otherwise None.
 */
export Option<i32> get_heap_break(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of { Some(p) -> Some(p.heap_break); None -> None; };
}

/**
 * Replaces the process-wide heap break after a successful mapping update.
 * @param pid Process whose address space was extended.
 * @param heap_break New end-exclusive user heap address.
 * @return Ok(_) on update, or Err(InvalidPid) when the process is absent.
 */
export Result<_, ProcessError> set_heap_break(Pid pid, i32 heap_break) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({ p.heap_break = heap_break; });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Reserves one of the process's fixed user-stack virtual-address slots.
 * @param pid Process whose stack bitmap is updated.
 * @return Ok(Some(slot)) on success, Ok(None) when all per-process slots are used,
 *         or Err(InvalidPid) when the process is absent.
 */
export Result<Option<i32>, ProcessError> reserve_user_stack_slot(Pid pid) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({
            i32 slot = 0;
            while (slot < kernel_config.MAX_THREADS_PER_PROC) {
                i32 bit = 1 << slot;
                if ((p.user_stack_slots & bit) == 0) {
                    p.user_stack_slots = p.user_stack_slots | bit;
                    return Ok(Some(slot));
                }
                slot++;
            }
            return Ok(None);
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
}

/**
 * Releases a process-local user-stack slot after its mapping is removed.
 * @param pid Process whose stack bitmap is updated.
 * @param slot Slot index in 0..MAX_THREADS_PER_PROC.
 * @return Ok(_) on release, or Err when PID/slot is invalid.
 */
export Result<_, ProcessError> release_user_stack_slot(Pid pid, i32 slot) {
    i32 idx = index_for_pid(pid)?;
    if (slot < 0 || slot >= kernel_config.MAX_THREADS_PER_PROC) {
        return Err(ProcessError::InvalidPid(pid));
    }
    case g_procs[idx] of {
        Some(p) -> ({ p.user_stack_slots = p.user_stack_slots & (~(1 << slot)); });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Accounts for a newly published TCB as both live and retained.
 * @param pid Owner process.
 * @return Ok(_) on increment, or Err(InvalidPid) when the owner disappeared.
 */
export Result<_, ProcessError> retain_thread(Pid pid) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({ p.live_threads++; p.retained_threads++; });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Removes one TCB from the live count while retaining its join record.
 * @param pid Owner process.
 * @return Ok(_) on update, or Err(InvalidPid) when the owner is absent.
 */
export Result<_, ProcessError> mark_thread_exited(Pid pid) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({ if (p.live_threads > 0) { p.live_threads--; } });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Removes one retained TCB after join or process-wide cleanup.
 * @param pid Owner process.
 * @return Ok(_) on update, or Err(InvalidPid) when the owner is absent.
 */
export Result<_, ProcessError> release_thread(Pid pid) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({ if (p.retained_threads > 0) { p.retained_threads--; } });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(number of Runnable, Running, or Blocked TCBs), or None if absent.
 */
export Option<i32> live_thread_count(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of { Some(p) -> Some(p.live_threads); None -> None; };
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(live plus unreaped Zombie TCB count), or None if absent.
 */
export Option<i32> retained_thread_count(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of { Some(p) -> Some(p.retained_threads); None -> None; };
}

/**
 * Moves a process to Exiting while preserving its final status.
 * @param pid Process beginning irreversible cleanup.
 * @param status Exit code or fatal-fault reason retained for the parent.
 * @return Ok(_) on transition, or Err(InvalidPid) when absent.
 */
export Result<_, ProcessError> begin_exit(Pid pid, ProcessExitStatus status) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({ p.state = ProcessState::Exiting(status); });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Converts an Exiting process into a resource-free Zombie.
 * @param pid Process whose TCBs and owned resources have all been released.
 * @return Ok(_) on transition, or Err(InvalidPid) unless the process is Exiting.
 */
export Result<_, ProcessError> finish_exit(Pid pid) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({
            case p.state of {
                Exiting(status) -> ({ p.state = ProcessState::Zombie(status); });
                _ -> ({ return Err(ProcessError::InvalidPid(pid)); });
            };
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Records that the OS holds nothing under this PID any more, so it may be reaped.
 * Interrupts stay off because a parent's reap can run the moment this is visible.
 * @param pid Zombie whose OS state has been released.
 * @return Ok(_) on transition, or Err(InvalidPid) unless the process is a Zombie.
 */
export Result<_, ProcessError> mark_released(Pid pid) {
    bool was_enabled = irq.save_disable();
    defer irq.restore(was_enabled);
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({
            case p.state of {
                Zombie(status) -> ({ p.state = ProcessState::Released(status); });
                _ -> ({ return Err(ProcessError::InvalidPid(pid)); });
            };
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * Clears resource handles and counters after lifecycle code physically frees them.
 * The ProcessState and final exit status are intentionally preserved.
 * @param pid Exiting process whose owned resources are gone.
 * @return Ok(_) on reset, or Err(InvalidPid) when absent.
 */
export Result<_, ProcessError> clear_owned_resources(Pid pid) {
    i32 idx = index_for_pid(pid)?;
    case g_procs[idx] of {
        Some(p) -> ({
            p.pdbr = 0;
            p.heap_break = 0;
            p.user_stack_slots = 0;
            p.live_threads = 0;
            p.retained_threads = 0;
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
    return Ok(_);
}

/**
 * @param pid Process identifier to inspect.
 * @return Some(final status) for Exiting, Zombie or Released, otherwise None.
 */
export Option<ProcessExitStatus> get_exit_status(Pid pid) {
    i32 idx = index_for_pid(pid).ok()?;
    return case g_procs[idx] of {
        Some(p) -> case p.state of {
            Exiting(status) -> Some(status);
            Zombie(status) -> Some(status);
            Released(status) -> Some(status);
            _ -> None;
        };
        None -> None;
    };
}
