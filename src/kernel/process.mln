/**
 * Retrieves the current heap break virtual address of a process.
 * @param pid Process ID.
 * @return Some(heap_break) if found, or None if invalid.
 */
export Option<i32> get_heap_break(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            Option<i32> ret = Some(p.heap_break);
            return ret;
        });
        None -> ({ return None; });
    };
}

/**
 * Updates the current heap break virtual address of a process.
 * @param pid Process ID.
 * @param brk New heap break virtual address.
 * @return Ok(_) on success, or Err(InvalidPid) if invalid.
 */
export Result<_, ProcessError> set_heap_break(i32 pid, i32 brk) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            p.heap_break = brk;
            return Ok(_);
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
}

/**
 * Retrieves the exit status code of a Zombie process.
 * @param pid Process ID.
 * @return Some(code) if process is in Zombie state, or None otherwise.
 */
export Option<i32> get_exit_code(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            case p.state of {
                Zombie(code) -> ({
                    Option<i32> ret = Some(code);
                    return ret;
                });
                _ -> ({
                    return None;
                });
            };
        });
        None -> ({
            return None;
        });
    };
}

/**
 * Marks a process as Zombie with the given exit code.
 * @param pid Process ID.
 * @param code Process exit code.
 * @return Ok(_) on success, or Err(InvalidPid) if invalid.
 */
export Result<_, ProcessError> set_exit_code(i32 pid, i32 code) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    ProcessState zombie_state = Zombie(code);
    case g_procs[idx] of {
        Some(p) -> ({
            p.state = zombie_state;
            return Ok(_);
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
}

/**
 * Retrieves the associated scheduler task ID for a process.
 * @param pid Process ID.
 * @return Some(task_id) if linked, or None if unlinked/invalid.
 */
export Option<i32> get_task_id(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    case g_procs[idx] of {
        Some(p) -> ({ return p.task_id; });
        None -> ({ return None; });
    };
}

/**
 * Links a scheduler task ID to a process.
 * @param pid Process ID.
 * @param tid Scheduler task ID.
 * @return Ok(_) on success, or Err(InvalidPid) if invalid.
 */
export Result<_, ProcessError> set_task_id(i32 pid, i32 tid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            Option<i32> otid = Some(tid);
            p.task_id = otid;
            return Ok(_);
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
}

/**
 * Returns the underlying descriptor for an open process file descriptor slot.
 * @param pid Process ID.
 * @param fd Process file descriptor index (0..7).
 * @return Ok(Some(target_fd)) if open, Ok(None) if slot is closed, or Err on invalid pid/fd.
 */
export Result<Option<i32>, ProcessError> get_fd(i32 pid, i32 fd) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    if (fd < 0 || fd >= kernel_config.MAX_FDS) {
        return Err(ProcessError::InvalidFd(fd));
    }
    i32 val = g_proc_fds[idx * kernel_config.MAX_FDS + fd];
    if (val < 0) {
        return Ok(None);
    }
    return Ok(Some(val));
}

/**
 * Updates or closes a file descriptor slot in a process table.
 * @param pid Process ID.
 * @param fd Process file descriptor index (0..7).
 * @param val Some(target_fd) to set target descriptor, or None to close slot.
 * @return Ok(_) on success, or Err on invalid pid/fd.
 */
export Result<_, ProcessError> set_fd(i32 pid, i32 fd, Option<i32> val) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    if (fd < 0 || fd >= kernel_config.MAX_FDS) {
        return Err(ProcessError::InvalidFd(fd));
    }
    case val of {
        Some(v) -> ({ g_proc_fds[idx * kernel_config.MAX_FDS + fd] = v; });
        None -> ({ g_proc_fds[idx * kernel_config.MAX_FDS + fd] = -1; });
    };
    return Ok(_);
}
