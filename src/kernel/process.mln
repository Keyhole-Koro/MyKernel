package process;

import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

export enum ProcessError {
    NoFreeSlot,         // Process slot table exhausted
    InvalidPid(i32),    // PID is out of range or not found
    InvalidFd(i32),     // File-descriptor index is outside this process table
}

// Process States
export enum ProcessState {
    Unused,
    Ready,
    Running,
    Blocked,
    Zombie,
}

i32 MAX_PROCS = 16;
i32 MAX_FDS   = 8;

export struct Process {
    i32 pid;              // Process ID (1..16, 0 = Unused)
    ProcessState state;
    i32 pdbr;             // Physical address of Page Directory
    i32 kernel_stack_top; // Physical top of dedicated kernel stack
    i32 kernel_sp;        // Saved kernel stack pointer
    i32 user_sp;          // Saved user stack pointer
    i32 user_entry;       // Virtual entry point (0x40000000)
    i32 heap_break;       // Current user heap break (starts at 0x41000000)
    i32 exit_code;        // Exit code
    i32 task_id;          // Associated scheduler task index
};

Process g_procs[16];
i32 g_proc_fds[128]; // 16 procs * 8 fds
i32 g_current_pid = 0;
i32 g_procs_initialized = 0;

export void init() {
    i32 i = 0;
    while (i < MAX_PROCS) {
        g_procs[i] = Process {
            pid: 0,
            state: Unused,
            pdbr: 0,
            kernel_stack_top: 0,
            kernel_sp: 0,
            user_sp: 0,
            user_entry: 0,
            heap_break: 0,
            exit_code: 0,
            task_id: -1,
        };

        i32 f = 0;
        while (f < MAX_FDS) {
            g_proc_fds[i * MAX_FDS + f] = -1;
            f = f + 1;
        }
        i = i + 1;
    }
    g_current_pid = 0;
    g_procs_initialized = 1;
}

// Allocate a new process slot. Returns Ok(pid) or Err(NoFreeSlot) if table is full.
export Result<i32, ProcessError> alloc_proc() {
    if (g_procs_initialized == 0) {
        init();
    }

    i32 i = 0;
    while (i < MAX_PROCS) {
        if (g_procs[i].state == Unused) {
            i32 pid = i + 1;
            g_procs[i].pid = pid;
            g_procs[i].state = Ready;
            g_procs[i].exit_code = 0;
            g_procs[i].task_id = -1;

            // Default standard streams
            g_proc_fds[i * MAX_FDS + 0] = 0; // stdin
            g_proc_fds[i * MAX_FDS + 1] = 1; // stdout
            g_proc_fds[i * MAX_FDS + 2] = 2; // stderr
            i32 f = 3;
            while (f < MAX_FDS) {
                g_proc_fds[i * MAX_FDS + f] = -1;
                f = f + 1;
            }
            return Ok(pid);
        }
        i = i + 1;
    }
    return Err(ProcessError::NoFreeSlot);
}

// Converts a public PID into a live process-table index.  Keeping this check
// in one place is what lets the public API distinguish a real zero-valued
// field from an invalid/deallocated process instead of relying on sentinels.
Result<i32, ProcessError> index_for_pid(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) {
        return Err(ProcessError::InvalidPid(pid));
    }
    i32 idx = pid - 1;
    if (g_procs[idx].pid != pid || g_procs[idx].state == Unused) {
        return Err(ProcessError::InvalidPid(pid));
    }
    return Ok(idx);
}

export Result<_, ProcessError> free_proc(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    g_procs[idx] = Process {
        pid: 0,
        state: Unused,
        pdbr: 0,
        kernel_stack_top: 0,
        kernel_sp: 0,
        user_sp: 0,
        user_entry: 0,
        heap_break: 0,
        exit_code: 0,
        task_id: -1,
    };

    i32 f = 0;
    while (f < MAX_FDS) {
        g_proc_fds[idx * MAX_FDS + f] = -1;
        f = f + 1;
    }

    if (g_current_pid == pid) {
        g_current_pid = 0;
    }
    return Ok(_);
}

// The kernel task/idle context has no process.  Represent that fact directly
// instead of leaking PID 0 as a special public value.
export Option<i32> get_current_pid() {
    if (g_current_pid == 0) {
        return None;
    }
    return Some(g_current_pid);
}

export Result<_, ProcessError> set_current_pid(i32 pid) {
    i32 ignored = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    g_current_pid = pid;
    return Ok(_);
}

export void clear_current_pid() {
    g_current_pid = 0;
}

export Option<ProcessState> get_state(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    return Some(g_procs[idx].state);
}

export Result<_, ProcessError> set_state(i32 pid, ProcessState state) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    g_procs[idx].state = state;
    return Ok(_);
}

