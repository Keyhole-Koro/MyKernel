package process;

import mem from "../mm/mem.mln";
import heap from "../mm/heap.mln";
import debug from "../debug/debug.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";

export enum ProcessError {
    NoFreeSlot,         // Process slot table exhausted
    InvalidPid(i32),    // PID is out of range or not found
}

// Process States
i32 PROC_UNUSED  = 0;
i32 PROC_READY   = 1;
i32 PROC_RUNNING = 2;
i32 PROC_BLOCKED = 3;
i32 PROC_ZOMBIE  = 4;

export i32 state_unused()  { return 0; }
export i32 state_ready()   { return 1; }
export i32 state_running() { return 2; }
export i32 state_blocked() { return 3; }
export i32 state_zombie()  { return 4; }

i32 MAX_PROCS = 16;
i32 MAX_FDS   = 8;

typedef struct {
    i32 pid;              // Process ID (1..16, 0 = Unused)
    i32 state;            // PROC_*
    i32 pdbr;             // Physical address of Page Directory
    i32 kernel_stack_top; // Physical top of dedicated kernel stack
    i32 kernel_sp;        // Saved kernel stack pointer
    i32 user_sp;          // Saved user stack pointer
    i32 user_entry;       // Virtual entry point (0x40000000)
    i32 heap_break;       // Current user heap break (starts at 0x41000000)
    i32 exit_code;        // Exit code
    i32 task_id;          // Associated scheduler task index
} Process;

Process g_procs[16];
i32 g_proc_fds[128]; // 16 procs * 8 fds
i32 g_current_pid = 0;
i32 g_procs_initialized = 0;

export void init() {
    i32 i = 0;
    while (i < MAX_PROCS) {
        g_procs[i] = Process {
            pid: 0,
            state: PROC_UNUSED,
            pdbr: 0,
            kernel_stack_top: 0,
            kernel_sp: 0,
            user_sp: 0,
            user_entry: 0,
            heap_break: 0,
            exit_code: 0,
            task_id: -1,
        };

        i32 f = 0;
        while (f < MAX_FDS) {
            g_proc_fds[i * MAX_FDS + f] = -1;
            f = f + 1;
        }
        i = i + 1;
    }
    g_current_pid = 0;
    g_procs_initialized = 1;
}

// Allocate a new process slot. Returns Ok(pid) or Err(NoFreeSlot) if table is full.
export Result<i32, ProcessError> alloc_proc() {
    if (g_procs_initialized == 0) {
        init();
    }

    i32 i = 0;
    while (i < MAX_PROCS) {
        if (g_procs[i].state == PROC_UNUSED) {
            i32 pid = i + 1;
            g_procs[i].pid = pid;
            g_procs[i].state = PROC_READY;
            g_procs[i].exit_code = 0;
            g_procs[i].task_id = -1;

            // Default standard streams
            g_proc_fds[i * MAX_FDS + 0] = 0; // stdin
            g_proc_fds[i * MAX_FDS + 1] = 1; // stdout
            g_proc_fds[i * MAX_FDS + 2] = 2; // stderr
            i32 f = 3;
            while (f < MAX_FDS) {
                g_proc_fds[i * MAX_FDS + f] = -1;
                f = f + 1;
            }
            return Ok(pid);
        }
        i = i + 1;
    }
    return Err(ProcessError::NoFreeSlot);
}

export void free_proc(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) {
        return;
    }
    i32 idx = pid - 1;
    g_procs[idx] = Process {
        pid: 0,
        state: PROC_UNUSED,
        pdbr: 0,
        kernel_stack_top: 0,
        kernel_sp: 0,
        user_sp: 0,
        user_entry: 0,
        heap_break: 0,
        exit_code: 0,
        task_id: -1,
    };

    i32 f = 0;
    while (f < MAX_FDS) {
        g_proc_fds[idx * MAX_FDS + f] = -1;
        f = f + 1;
    }

    if (g_current_pid == pid) {
        g_current_pid = 0;
    }
}

export i32 get_current_pid() {
    return g_current_pid;
}

export void set_current_pid(i32 pid) {
    g_current_pid = pid;
}

export i32 get_state(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return PROC_UNUSED; }
    return g_procs[pid - 1].state;
}

export void set_state(i32 pid, i32 state) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].state = state;
}

export i32 get_pdbr(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return 0; }
    return g_procs[pid - 1].pdbr;
}

export void set_pdbr(i32 pid, i32 pdbr) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].pdbr = pdbr;
}

export i32 get_kernel_stack_top(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return 0; }
    return g_procs[pid - 1].kernel_stack_top;
}

export void set_kernel_stack_top(i32 pid, i32 top) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].kernel_stack_top = top;
}

export i32 get_kernel_sp(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return 0; }
    return g_procs[pid - 1].kernel_sp;
}

export void set_kernel_sp(i32 pid, i32 sp) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].kernel_sp = sp;
}

export i32 get_user_sp(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return 0; }
    return g_procs[pid - 1].user_sp;
}

export void set_user_sp(i32 pid, i32 usp) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].user_sp = usp;
}

export i32 get_user_entry(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return 0; }
    return g_procs[pid - 1].user_entry;
}

export void set_user_entry(i32 pid, i32 entry) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].user_entry = entry;
}

export i32 get_heap_break(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return 0; }
    return g_procs[pid - 1].heap_break;
}

export void set_heap_break(i32 pid, i32 brk) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].heap_break = brk;
}

export i32 get_exit_code(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return 0; }
    return g_procs[pid - 1].exit_code;
}

export void set_exit_code(i32 pid, i32 code) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].exit_code = code;
}

export i32 get_task_id(i32 pid) {
    if (pid <= 0 || pid > MAX_PROCS) { return -1; }
    return g_procs[pid - 1].task_id;
}

export void set_task_id(i32 pid, i32 tid) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    g_procs[pid - 1].task_id = tid;
}

export i32 get_fd(i32 pid, i32 fd) {
    if (pid <= 0 || pid > MAX_PROCS) { return -1; }
    if (fd < 0 || fd >= MAX_FDS) { return -1; }
    return g_proc_fds[(pid - 1) * MAX_FDS + fd];
}

export void set_fd(i32 pid, i32 fd, i32 val) {
    if (pid <= 0 || pid > MAX_PROCS) { return; }
    if (fd < 0 || fd >= MAX_FDS) { return; }
    g_proc_fds[(pid - 1) * MAX_FDS + fd] = val;
}
