package process;

import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

export enum ProcessError {
    NoFreeSlot,         // Process slot table exhausted
    InvalidPid(i32),    // PID is out of range or not found
    InvalidFd(i32),     // File-descriptor index is outside this process table
}

// Process States
export enum ProcessState {
    Ready,
    Running,
    Blocked,
    Zombie(i32),
}

import kernel_config from "kernel_config.mln";

export struct Process {
    i32 pid;              // Process ID (1..16)
    ProcessState state;
    i32 pdbr;             // Physical address of Page Directory
    i32 kernel_stack_top; // Physical top of dedicated kernel stack
    i32 kernel_sp;        // Saved kernel stack pointer
    i32 user_sp;          // Saved user stack pointer
    i32 user_entry;       // Virtual entry point (0x40000000)
    i32 heap_break;       // Current user heap break (starts at 0x41000000)
    Option<i32> task_id;  // Associated scheduler task index, if spawned
};

Option<Process> g_procs[16];
i32 g_proc_fds[128]; // 16 procs * 8 fds
i32 g_current_pid = 0;
i32 g_procs_initialized = 0;

/**
 * Initializes the process table and file descriptor arrays to clean default state.
 */
export void init() {
    i32 i = 0;
    while (i < kernel_config.MAX_PROCS) {
        Option<Process> empty = None;
        g_procs[i] = empty;

        i32 f = 0;
        while (f < kernel_config.MAX_FDS) {
            g_proc_fds[i * kernel_config.MAX_FDS + f] = -1;
            f++;
        }
        i++;
    }
    g_current_pid = 0;
    g_procs_initialized = 1;
}

/**
 * Allocates a new process slot and initializes standard file descriptors (stdin, stdout, stderr).
 * @return Ok(pid) with allocated process ID (1-based), or Err(NoFreeSlot) if table is full.
 */
export Result<i32, ProcessError> alloc_proc() {
    if (g_procs_initialized == 0) {
        init();
    }

    i32 i = 0;
    while (i < kernel_config.MAX_PROCS) {
        i32 is_empty = case g_procs[i] of {
            None -> 1;
            _ -> 0;
        };
        if (is_empty != 0) {
            i32 pid = i + 1;
            ProcessState ready_state = Ready;
            Process proc = Process {
                pid: pid,
                state: ready_state,
                pdbr: 0,
                kernel_stack_top: 0,
                kernel_sp: 0,
                user_sp: 0,
                user_entry: 0,
                heap_break: 0,
                task_id: None,
            };
            Option<Process> entry = Some(proc);
            g_procs[i] = entry;

            // Default standard streams
            g_proc_fds[i * kernel_config.MAX_FDS + 0] = 0; // stdin
            g_proc_fds[i * kernel_config.MAX_FDS + 1] = 1; // stdout
            g_proc_fds[i * kernel_config.MAX_FDS + 2] = 2; // stderr
            i32 f = 3;
            while (f < kernel_config.MAX_FDS) {
                g_proc_fds[i * kernel_config.MAX_FDS + f] = -1;
                f++;
            }
            return Ok(pid);
        }
        i++;
    }
    return Err(ProcessError::NoFreeSlot);
}

/**
 * Converts a 1-based PID into a live process table index.
 * @param pid Process ID to look up.
 * @return Ok(index) if PID is valid and currently allocated, or Err(InvalidPid) otherwise.
 */
Result<i32, ProcessError> index_for_pid(i32 pid) {
    if (pid <= 0 || pid > kernel_config.MAX_PROCS) {
        return Err(ProcessError::InvalidPid(pid));
    }
    i32 idx = pid - 1;
    i32 matches = case g_procs[idx] of {
        Some(p) -> ({
            if (p.pid == pid) { 1; } else { 0; }
        });
        None -> 0;
    };
    if (matches == 0) {
        return Err(ProcessError::InvalidPid(pid));
    }
    return Ok(idx);
}

/**
 * Frees an allocated process slot and resets its file descriptors.
 * @param pid Process ID to free.
 * @return Ok(_) on success, or Err(InvalidPid) if process does not exist.
 */
export Result<_, ProcessError> free_proc(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    Option<Process> empty = None;
    g_procs[idx] = empty;

    i32 f = 0;
    while (f < kernel_config.MAX_FDS) {
        g_proc_fds[idx * kernel_config.MAX_FDS + f] = -1;
        f++;
    }

    if (g_current_pid == pid) {
        g_current_pid = 0;
    }
    return Ok(_);
}

/**
 * Returns the PID of the currently executing user process.
 * @return Some(pid) if a user process is active, or None if executing kernel task.
 */
export Option<i32> get_current_pid() {
    if (g_current_pid == 0) {
        return None;
    }
    return Some(g_current_pid);
}

/**
 * Sets the PID of the currently executing process.
 * @param pid Process ID to mark as current.
 * @return Ok(_) on success, or Err(InvalidPid) if PID is invalid.
 */
export Result<_, ProcessError> set_current_pid(i32 pid) {
    i32 ignored = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    g_current_pid = pid;
    return Ok(_);
}

/**
 * Clears the active process ID, indicating kernel/idle context.
 */
export void clear_current_pid() {
    g_current_pid = 0;
}

/**
 * Retrieves the lifecycle state of a process.
 * @param pid Process ID.
 * @return Some(state) if found, or None if PID is invalid/unallocated.
 */
export Option<ProcessState> get_state(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            Option<ProcessState> ret = Some(p.state);
            return ret;
        });
        None -> ({ return None; });
    };
}

/**
 * Updates the lifecycle state of a process.
 * @param pid Process ID.
 * @param state New process state.
 * @return Ok(_) on success, or Err(InvalidPid) if process not found.
 */
export Result<_, ProcessError> set_state(i32 pid, ProcessState state) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(error) -> ({ return Err(error); });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            p.state = state;
            return Ok(_);
        });
        None -> ({ return Err(ProcessError::InvalidPid(pid)); });
    };
}

/**
 * Retrieves the page directory base register (physical address) of a process.
 * @param pid Process ID.
 * @return Some(pdbr) if found, or None if invalid.
 */
export Option<i32> get_pdbr(i32 pid) {
    i32 idx = case index_for_pid(pid) of {
        Ok(index) -> index;
        Err(_) -> ({ return None; });
    };
    case g_procs[idx] of {
        Some(p) -> ({
            Option<i32> ret = Some(p.pdbr);
            return ret;
        });
        None -> ({ return None; });
    };
}

