import debug from "../debug/debug.mln";
import heap from "../mm/heap.mln";
import dom from "../ui/dom.mln";
import graphics from "../ui/graphics.mln";
import fs from "../fs/fs.mln";
import scheduler from "scheduler.mln";

void kernel_boot_banner() {
    debug.println("kernel: boot");
}

void kernel_arch_init() {
    debug.println("kernel: arch init");
    heap.init();
    debug.println("kernel: heap ready");
}

void kernel_init() {
    kernel_boot_banner();
    kernel_arch_init();

    dom.init();
    debug.println("kernel: dom ready");
    dom.dump();

    debug.println("graphics: start");

    // Draw background (blue)
    graphics.fill_rect(0, 0, 1024, 768, graphics.rgb(0, 0, 255));
    // Draw a window (white with gray border)
    graphics.fill_rect(100, 100, 600, 400, graphics.rgb(255, 255, 255));
    graphics.draw_rect(100, 100, 600, 400, graphics.rgb(136, 136, 136));
    // Draw a button inside
    graphics.fill_rect(120, 130, 150, 60, graphics.rgb(204, 204, 204));
    graphics.draw_rect(120, 130, 150, 60, 0);

    // Window title and button label.
    i32 black = graphics.rgb(0, 0, 0);
    i32 white = graphics.rgb(255, 255, 255);
    i32 button = graphics.rgb(204, 204, 204);
    graphics.draw_text(120, 108, "MyKernel Window", black, white);
    graphics.draw_text(150, 152, "OK", black, button);

    // Showcase the new primitives inside the window.
    i32 red = graphics.rgb(220, 40, 40);
    i32 green = graphics.rgb(40, 180, 40);
    i32 blue = graphics.rgb(40, 90, 220);

    // A diagonal line and a filled + outlined circle.
    graphics.draw_line(320, 140, 660, 300, red);
    graphics.fill_circle(420, 260, 50, green);
    graphics.draw_circle(560, 260, 60, blue);

    // Scaled heading and a live counter value.
    graphics.draw_text_scaled(320, 340, "GRAPHICS", blue, white, 3);
    graphics.draw_text(320, 400, "irq count:", black, white);
    graphics.draw_int(410, 400, 12345, red, white);

    debug.println("graphics: done");

    fs.init();

    // Hand off to the scheduler: it sets up the demo tasks, enables
    // interrupts, and turns this thread into task 0 (never returns).
    scheduler.start();
}

i32 kernel_main() {
    kernel_init();
    return 0;
}
