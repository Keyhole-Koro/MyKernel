import debug from "../debug/debug.mln";
import heap from "../mm/heap.mln";
import dom from "../../../MyOS/src/ui/dom.mln";
import fs from "../../../MyOS/src/fs/fs.mln";
import scheduler from "scheduler.mln";
import irq_dispatch from "irq_dispatch.mln";
import irq from "../arch/irq.mln";
import shell from "../../../MyOS/src/apps/shell.mln";
import compositor from "../../../MyOS/src/ui/compositor.mln";
import counter from "../../../MyOS/src/apps/counter.dom.mln";

void kernel_boot_banner() {
    debug.println("kernel: boot");
}

void kernel_arch_init() {
    debug.println("kernel: arch init");
    heap.init();
    debug.println("kernel: heap ready");
}

void kernel_init() {
    kernel_boot_banner();
    kernel_arch_init();

    dom.init();
    debug.println("kernel: dom ready");

    // Apps own their windows; the kernel only starts them. counter.mount()
    // builds its tree and attaches it to the desktop.
    counter.mount();
    dom.dump();

    fs.init();

    debug.println("kernel: enabling interrupts for event queue");
    scheduler.init();
    irq.set_handler();
    irq.enable();

    debug.println("kernel: spawning shell task");
    scheduler.spawn_task(shell.run);

    debug.println("ui: click the button (window must have focus)");
    compositor.run();
}

i32 kernel_main() {
    kernel_init();
    return 0;
}
