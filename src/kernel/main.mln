import debug from "../debug/debug.mln";
import heap from "../mm/heap.mln";
import dom from "../../../MyOS/src/ui/dom.mln";
import graphics from "../../../MyOS/src/ui/graphics.mln";
import mouse from "../io/mouse.mln";
import fs from "../../../MyOS/src/fs/fs.mln";
import scheduler from "scheduler.mln";
import irq_dispatch from "irq_dispatch.mln";
import irq from "../arch/irq.mln";
import shell from "../../../MyOS/src/apps/shell.mln";

void kernel_boot_banner() {
    debug.println("kernel: boot");
}

void kernel_arch_init() {
    debug.println("kernel: arch init");
    heap.init();
    debug.println("kernel: heap ready");
}

// Click state, owned by the kernel UI. The handler updates these; the renderer
// reads the DOM nodes the handler mutates.
i32 g_clicks = 0;
i32 g_label_id = 0;

// Button click handler. dom.dispatch_click invokes this indirectly with the
// button id. It bumps the counter and rewrites the label text; the next render
// picks up the new text from the node.
char g_click_buf[32];

void on_button_click(i32 id) {
    g_clicks = g_clicks + 1;
    
    g_click_buf[0] = 99; g_click_buf[1] = 108; g_click_buf[2] = 105; 
    g_click_buf[3] = 99; g_click_buf[4] = 107; g_click_buf[5] = 115; 
    g_click_buf[6] = 58; g_click_buf[7] = 32; 

    if (g_clicks == 0) {
        g_click_buf[8] = 48;
        g_click_buf[9] = 0;
    } else {
        i32 temp = g_clicks;
        i32 num_digits = 0;
        while (temp > 0) {
            num_digits = num_digits + 1;
            temp = temp / 10;
        }

        temp = g_clicks;
        i32 i = 8 + num_digits - 1;
        g_click_buf[8 + num_digits] = 0;

        while (temp > 0) {
            i32 d = temp % 10;
            g_click_buf[i] = 48 + d;
            temp = temp / 10;
            i = i - 1;
        }
    }
    dom.set_text(g_label_id, &g_click_buf[0]);
}

// Build the window / button / text tree under the desktop and return the button
// id so the loop can hit-test and drive its state.
i32 build_ui() {
    i32 desktop = dom.desktop_id();

    i32 win = dom.create_window("MyKernel Window", 100, 100, 600, 400);
    dom.append_child(desktop, win);

    i32 btn = dom.create_button("CLICK ME", 120, 130, 150, 60);
    dom.append_child(win, btn);
    dom.set_on_click(btn, on_button_click);

    g_label_id = dom.create_text("clicks: 0", 320, 150);
    dom.append_child(win, g_label_id);

    return btn;
}

// Draw a small arrow cursor at (mx, my). A white edge keeps it visible on any
// background. Drawn last, after the DOM scene, so it sits on top of everything.
void draw_cursor(i32 mx, i32 my) {
    i32 black = graphics.rgb(0, 0, 0);
    i32 white = graphics.rgb(255, 255, 255);
    graphics.draw_line(mx, my, mx + 10, my + 10, white);
    graphics.draw_line(mx, my, mx + 8, my + 12, black);
    graphics.draw_line(mx, my, mx + 12, my + 8, black);
    graphics.fill_rect(mx, my, 2, 2, black);
}

// Render the DOM scene, overlay the cursor at (mx, my), then flip the frame.
void present_frame(i32 mx, i32 my) {
    dom.render_scene();
    draw_cursor(mx, my);
    graphics.present();
}

// Interactive loop, event-driven. The mouse IRQ handler drains the hardware
// event FIFO into mouse's software queue; each pass consumes every queued
// event and edge-detects the button per event, so a click whose press and
// release both happened since the last pass still dispatches (nothing shorter
// than a display frame is lost anymore). The live registers stay authoritative
// for the cursor position and hover state, so a dropped event can delay a
// repaint but never wedge the button.
void ui_loop(i32 btn) {
    i32 prev_left = 0;
    i32 prev_over = 0;
    i32 prev_mx = -1;
    i32 prev_my = -1;

    while (1) {
        i32 dirty = 0;

        // Consume all queued events. Clicks are dispatched at the event's own
        // coordinates: where the press happened, not where the pointer is now.
        while (mouse.has_event() != 0) {
            i32 ex = mouse.event_x();
            i32 ey = mouse.event_y();
            i32 eb = mouse.event_btn() & 1;
            mouse.pop_event();

            if (eb != 0) {
                if (prev_left == 0) {
                    // Press edge: a fresh click on the button.
                    if (dom.find_at(ex, ey) == btn) {
                        dom.set_pressed(btn, 1);
                        dom.dispatch_click(btn); // may change the label text
                        dirty = 1;
                    }
                }
            } else {
                if (prev_left != 0) { dirty = 1; } // release: repaint un-pressed
                dom.set_pressed(btn, 0);
            }
            prev_left = eb;
        }

        // Live state drives the cursor and hover.
        i32 mx = mouse.x();
        i32 my = mouse.y();
        i32 over_button = 0;
        if (dom.find_at(mx, my) == btn) { over_button = 1; }
        dom.set_hovered(btn, over_button);

        if (mx != prev_mx) { dirty = 1; }
        if (my != prev_my) { dirty = 1; }
        if (over_button != prev_over) { dirty = 1; }

        if (dirty != 0) {
            present_frame(mx, my);
            prev_mx = mx;
            prev_my = my;
            prev_over = over_button;
        }

        scheduler.sleep(1); // yield the CPU to other tasks between passes
    }
}

void kernel_init() {
    kernel_boot_banner();
    kernel_arch_init();

    dom.init();
    debug.println("kernel: dom ready");

    i32 btn = build_ui();
    dom.dump();

    fs.init();

    debug.println("kernel: enabling interrupts for event queue");
    scheduler.init();
    irq.set_handler();
    irq.enable();
    debug.println("kernel: spawning shell task");
    scheduler.spawn_task(shell.run);

    debug.println("ui: click the button (window must have focus)");
    ui_loop(btn);
}

i32 kernel_main() {
    kernel_init();
    return 0;
}
