package loader;

import mem from "../mm/mem.mln";
import mmu from "../mm/mmu.mln";
import heap from "../mm/heap.mln";
import debug from "../debug/debug.mln";
import process from "process.mln";
import { ProcessState } from "process.mln";
import scheduler from "scheduler.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { MmuError } from "../mm/mmu.mln";
import { ProcessError } from "process.mln";
import { SchedulerError } from "scheduler.mln";

export enum LoaderError {
    ProcSlotFull,        // Process slot table exhausted
    OutOfMemory,         // Memory allocation failed (page directory / frame / stack)
    Mmu(MmuError),       // Wrapped MMU failure (invalid directory / unaligned address)
    InvalidHeader(i32),  // Invalid MBIN header or unsupported version
    InvalidBounds(i32),  // Section boundaries exceed binary buffer
    SpawnTaskFailed,     // Task scheduler spawn failed
}

i32 USER_CODE_BASE  = 0x40000000;
// The user stack: USER_STACK_PAGES pages ending just below the top of the
// address space. A GUI app's view() and handlers build markup and copy
// text on the stack, which one page does not hold.
i32 USER_STACK_PAGES = 4;
export i32 USER_STACK_BASE = 0x7FFFC000; // Heap must stay below this (see syscall.sys_sbrk)
i32 USER_STACK_TOP  = 0x7FFFFFE0;
i32 USER_HEAP_BASE  = 0x41000000;

// MMU Page Table Entry flags:
// Bit 0: Valid, Bit 1: Writable, Bit 2: Executable, Bit 3: User
i32 PTE_USER_RX     = 0x0D; // VALID | EXEC | USER (0x01 | 0x04 | 0x08)
i32 PTE_USER_RW     = 0x0B; // VALID | WRITABLE | USER (0x01 | 0x02 | 0x08)
i32 PTE_USER_RWX    = 0x0F; // Legacy / flat fallback: VALID | WRITABLE | EXEC | USER

i32 MBIN_MAGIC      = 0x4D42494E; // 'MBIN'

/**
 * Reads a 32-bit big-endian unsigned integer from memory.
 * @param addr Memory address to read from.
 * @return 32-bit integer decoded from big-endian bytes.
 */
i32 read_be32(i32 addr) {
    i32 b0 = mem.read_byte(addr);
    i32 b1 = mem.read_byte(addr + 1);
    i32 b2 = mem.read_byte(addr + 2);
    i32 b3 = mem.read_byte(addr + 3);
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

/**
 * Rounds an address or size up to the nearest 4 KiB page boundary.
 * @param val Address or size to align.
 * @return 4 KiB aligned value.
 */
i32 align_up_4k(i32 val) {
    i32 rem = val & 4095;
    if (rem == 0) {
        return val;
    }
    return (val - rem) + 4096;
}

/**
 * Allocates physical frames and maps them into virtual memory at vaddr_base.
 *
 * If src_ptr is non-zero, copies `size` bytes from src_ptr into the allocated frames.
 * If src_ptr is 0, the frames remain zero-filled (for BSS sections).
 * @param pd Page directory physical address.
 * @param vaddr_base Base virtual address for the mapping.
 * @param src_ptr Pointer to source data, or 0 for zeroed pages.
 * @param size Segment size in bytes.
 * @param pte_flags Page table entry permission flags (e.g. PTE_USER_RX, PTE_USER_RW).
 * @return Ok(_) on success, or Err(LoaderError) on allocation/MMU failure.
 */
Result<_, LoaderError> map_segment(i32 pd, i32 vaddr_base, i32 src_ptr, i32 size, i32 pte_flags) {
    i32 offset = 0;
    while (offset < size) {
        i32 chunk = 4096;
        if (offset + chunk > size) {
            chunk = size - offset;
        }
        // A page the copy fills completely need not be cleared first.
        Option<i32> got = None;
        if (src_ptr != 0 && chunk == 4096) { got = mmu.alloc_page_uninitialized(); }
        else { got = mmu.alloc_page(); }
        i32 frame = case got of {
            Some(f) -> f;
            None -> ({
                debug.println("loader: out of memory for frame");
                return Err(LoaderError::OutOfMemory);
            });
        };

        if (src_ptr != 0) {
            i32 b = 0;
            if (((src_ptr + offset) & 3) == 0) {
                // Word copies where the source allows: a byte loop over a
                // 60 KB image is a visible part of an app's start-up time.
                while (b + 4 <= chunk) {
                    mem.write_word(frame + b, mem.read_word(src_ptr + offset + b));
                    b = b + 4;
                }
            }
            while (b < chunk) {
                i32 byte_val = mem.read_byte(src_ptr + offset + b);
                mem.write_byte(frame + b, byte_val);
                b++;
            }
        }

        Result<_, MmuError> map_res = mmu.map_page(pd, vaddr_base + offset, frame, pte_flags);
        case map_res of {
            Ok(_) -> 0;
            Err(AllocFailed) -> ({
                debug.println("loader: out of memory for page table");
                return Err(LoaderError::OutOfMemory);
            });
            Err(e) -> ({
                debug.println("loader: mmu error mapping segment");
                return Err(LoaderError::Mmu(e));
            });
        };
        offset = offset + 4096;
    }
    return Ok(_);
}

/**
 * Releases an allocated process during error cleanup.
 * @param pid Process ID to release.
 */
void release_proc(i32 pid) {
    Result<_, ProcessError> release = process.free_proc(pid);
    case release of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared during cleanup"); });
    };
}

/**
 * Spawns a new user process from raw binary instructions in memory.
 *
 * Automatically detects an MBIN header (version 1 or 2) for segment separation (W^X) or falls back
 * to flat binary loading for legacy compatibility.
 * @param code_ptr Memory pointer to executable binary.
 * @param code_size Binary size in bytes.
 * @return Ok(pid) with allocated process ID on success, or Err(LoaderError) on failure.
 */
export Result<i32, LoaderError> spawn_from_buffer(i32 code_ptr, i32 code_size) {
    Result<i32, ProcessError> proc_res = process.alloc_proc();
    i32 pid = case proc_res of {
        Ok(p) -> p;
        Err(NoFreeSlot) -> ({
            debug.println("loader: failed to allocate process slot");
            return Err(LoaderError::ProcSlotFull);
        });
        Err(InvalidPid(p)) -> ({
            debug.println("loader: invalid pid allocated");
            return Err(LoaderError::ProcSlotFull);
        });
        Err(InvalidFd(fd)) -> ({
            debug.panic("loader: alloc_proc returned an invalid file descriptor error");
        });
    };

    // 1. Create Page Directory and map kernel regions identity
    i32 pd = case mmu.create_page_directory() of {
        Some(d) -> d;
        None -> ({
            debug.println("loader: failed to allocate page directory");
            release_proc(pid);
            return Err(LoaderError::OutOfMemory);
        });
    };
    Result<_, MmuError> id_res = mmu.setup_identity_kernel_mapping(pd);
    case id_res of {
        Ok(_) -> 0;
        Err(AllocFailed) -> ({
            debug.println("loader: failed to setup identity kernel mapping");
            release_proc(pid);
            return Err(LoaderError::OutOfMemory);
        });
        Err(e) -> ({
            debug.printf("loader: mmu error setting up identity mapping, pd=0x%x\n", pd);
            release_proc(pid);
            return Err(LoaderError::Mmu(e));
        });
    };
    Result<_, ProcessError> set_pdbr = process.set_pdbr(pid, pd);
    case set_pdbr of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while setting pdbr"); });
    };

    // 2. Check for an MBIN executable header
    i32 entry_point = USER_CODE_BASE;
    i32 initial_brk = USER_HEAP_BASE;
    i32 is_mbin = 0;
    // Where the text segment is mapped. A v2 image is mapped at the address
    // it was linked at (the page holding its entry point): MyLang loads
    // symbol addresses with a 21-bit immediate, so compiled programs must
    // be linked below 2 MB (qa/runners/build_user_apps.py uses 0x20000,
    // unused RAM below the kernel image) rather than at USER_CODE_BASE.
    // Their pages replace the kernel identity mapping of that range in the
    // process's own page directory only, so isolation is unchanged.
    i32 code_base = USER_CODE_BASE;

    if (code_size >= 32) {
        i32 magic = read_be32(code_ptr);
        if (magic == MBIN_MAGIC) {
            is_mbin = 1;
        }
    }

    if (is_mbin == 1) {
        i32 version     = read_be32(code_ptr + 4);
        entry_point     = read_be32(code_ptr + 8);
        i32 text_offset = read_be32(code_ptr + 12);
        i32 text_size   = read_be32(code_ptr + 16);
        i32 data_offset = read_be32(code_ptr + 20);
        i32 data_size   = read_be32(code_ptr + 24);
        i32 bss_size    = read_be32(code_ptr + 28);

        // Header version 2 adds a section directory offset after bss_size;
        // the segments are laid out the same, so both load alike.
        if (version != 1 && version != 2) {
            debug.println("loader: unsupported MBIN version");
            release_proc(pid);
            LoaderError cause = InvalidHeader(version);
            return Err(cause);
        }
        if (text_offset + text_size > code_size) {
            debug.println("loader: invalid text section bounds");
            release_proc(pid);
            LoaderError cause = InvalidBounds(code_size);
            return Err(cause);
        }
        if (data_offset + data_size > code_size) {
            debug.println("loader: invalid data section bounds");
            release_proc(pid);
            LoaderError cause = InvalidBounds(code_size);
            return Err(cause);
        }

        debug.printf("loader: loading MBIN v%d (entry=0x%x, text_sz=%d, data_sz=%d, bss_sz=%d)\n",
                     version, entry_point, text_size, data_size, bss_size);
        code_base = entry_point & 0xFFFFF000;

        // Map Text segment as RX (Read + Execute, No Write). Globals live
        // in the data segment (the compiler's `.data`), so text is code only.
        Result<_, LoaderError> map_text = map_segment(pd, code_base, code_ptr + text_offset, text_size, PTE_USER_RX);
        case map_text of {
            Ok(_)  -> 0;
            Err(e) -> ({
                release_proc(pid);
                return Err(e);
            });
        };

        // Map Data segment as RW (Read + Write, No Execute)
        i32 data_vaddr = code_base + align_up_4k(text_size);
        if (data_size > 0) {
            Result<_, LoaderError> map_data = map_segment(pd, data_vaddr, code_ptr + data_offset, data_size, PTE_USER_RW);
            case map_data of {
                Ok(_)  -> 0;
                Err(e) -> ({
                    release_proc(pid);
                    return Err(e);
                });
            };
        }

        // Map BSS segment as RW (Read + Write, No Execute)
        if (bss_size > 0) {
            i32 bss_vaddr = data_vaddr + align_up_4k(data_size);
            Result<_, LoaderError> map_bss = map_segment(pd, bss_vaddr, 0, bss_size, PTE_USER_RW);
            case map_bss of {
                Ok(_)  -> 0;
                Err(e) -> ({
                    release_proc(pid);
                    return Err(e);
                });
            };
        }

        // Calculate heap break after loaded segments
        i32 seg_end = data_vaddr + align_up_4k(data_size + bss_size);
        if (seg_end > initial_brk) {
            initial_brk = seg_end;
        }
    } else {
        // Legacy flat binary fallback: map entire buffer as RWX
        debug.println("loader: legacy flat binary detected, mapping as RWX");
        Result<_, LoaderError> map_flat = map_segment(pd, USER_CODE_BASE, code_ptr, code_size, PTE_USER_RWX);
        case map_flat of {
            Ok(_)  -> 0;
            Err(e) -> ({
                release_proc(pid);
                return Err(e);
            });
        };
    }

    // 3. Allocate the user stack pages (RW, No Execute), zero-filled
    Result<_, LoaderError> map_stack = map_segment(pd, USER_STACK_BASE, 0, USER_STACK_PAGES * 4096, PTE_USER_RW);
    case map_stack of {
        Ok(_)  -> 0;
        Err(e) -> ({
            debug.println("loader: cannot map the user stack");
            release_proc(pid);
            return Err(e);
        });
    };

    // 4. Allocate kernel stack. Syscalls run on it: the OS_CALL handler
    // reaches the filesystem (SSD I/O) and the UI channels from there, so
    // it is sized for a real call chain of MyLang frames, not a bare
    // dispatcher -- an overflow here silently corrupts whatever heap block
    // sits below it.
    i32 KSTACK_BYTES = 16384;
    i32 kstack = heap.alloc(KSTACK_BYTES);
    if (kstack == 0) {
        debug.println("loader: out of memory for kernel stack");
        release_proc(pid);
        return Err(LoaderError::OutOfMemory);
    }
    i32 kstack_top = kstack + KSTACK_BYTES;
    Result<_, ProcessError> set_kstack_top = process.set_kernel_stack_top(pid, kstack_top);
    case set_kstack_top of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while setting kernel stack"); });
    };

    // 5. Initialize process registers and state
    Result<_, ProcessError> set_user_sp = process.set_user_sp(pid, USER_STACK_TOP);
    case set_user_sp of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while setting user stack"); });
    };
    Result<_, ProcessError> set_user_entry = process.set_user_entry(pid, entry_point);
    case set_user_entry of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while setting entry point"); });
    };
    Result<_, ProcessError> set_heap_break = process.set_heap_break(pid, initial_brk);
    case set_heap_break of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while setting heap break"); });
    };

    // 6. Build initial interrupt stack frame for iret to resume
    i32 sp = kstack_top;
    sp = sp - 4; mem.write_word(sp, entry_point);     // PC
    sp = sp - 4; mem.write_word(sp, 0x21);            // SR (SR_USER=0x20 | SR_IE=0x01)
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry PC slot
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry SR slot
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry lr slot
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry bp slot
    sp = sp - 4; mem.write_word(sp, 0);               // lr
    sp = sp - 4; mem.write_word(sp, 0);               // bp
    sp = sp - 4; mem.write_word(sp, 0);               // r0
    sp = sp - 4; mem.write_word(sp, 0);               // r1
    sp = sp - 4; mem.write_word(sp, 0);               // r2
    sp = sp - 4; mem.write_word(sp, 0);               // r3
    sp = sp - 4; mem.write_word(sp, 0);               // r4
    sp = sp - 4; mem.write_word(sp, 0);               // r5
    sp = sp - 4; mem.write_word(sp, 0);               // r6
    sp = sp - 4; mem.write_word(sp, 0);               // r7

    Result<_, ProcessError> set_kernel_sp = process.set_kernel_sp(pid, sp);
    case set_kernel_sp of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while setting kernel context"); });
    };

    // 7. Spawn task in scheduler
    Result<i32, SchedulerError> spawn_res = scheduler.spawn_proc_task(pid, sp);
    case spawn_res of {
        Ok(_) -> 0;
        Err(_) -> ({
            debug.println("loader: failed to spawn task");
            release_proc(pid);
            return Err(LoaderError::SpawnTaskFailed);
        });
    };

    ProcessState ready_state = Ready;
    Result<_, ProcessError> set_ready = process.set_state(pid, ready_state);
    case set_ready of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while marking ready"); });
    };
    return Ok(pid);
}
