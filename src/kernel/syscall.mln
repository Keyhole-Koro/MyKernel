package syscall;

import mem from "../mm/mem.mln";
import mmu from "../mm/mmu.mln";
import serial from "../io/serial.mln";
import debug from "../debug/debug.mln";
import process from "process.mln";
import { ProcessState, ProcessError } from "process.mln";
import scheduler from "scheduler.mln";
import loader from "loader.mln";
import { Result, result_take_ok, result_take_err } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { MmuError } from "../mm/mmu.mln";

// Syscall numbers
export enum Syscall {
    EXIT = 1,
    READ,
    WRITE,
    OPEN,
    CLOSE,
    SEEK,
    SBRK,
    YIELD,
    SPAWN,
}

// Typed failure reasons for syscalls that do real work (multi-step, can fail
// for more than one reason). Consumed only via Result<T, SyscallError>/case,
// same as MmuError/LoaderError/ProcessError -- never accessed as a bare
// cross-package member, so the enum-linking pitfall in dom.mln doesn't apply.
// InvalidDirectory/UnalignedAddress deliberately aren't here: sys_sbrk only
// ever hands the MMU a pdbr from a live process and page-aligned addresses
// it computed itself, so those MmuError variants can't legitimately occur --
// if they ever do, that's a kernel invariant broken, not a recoverable
// syscall error, and is handled by panicking on the spot (see sys_sbrk).
export enum SyscallError {
    NoProcess,      // No process is currently executing
    OutOfMemory,    // Physical frame allocation failed
    HeapOverflow,   // New heap break would collide with the stack
    BadFd,          // Unsupported file descriptor
    UnknownSyscall, // sys_nr doesn't match any dispatched syscall
}

// Typed result of syscall dispatch. It keeps the user-visible return value
// together with the frame to resume; SYS_EXIT/SYS_YIELD may choose another
// frame through the scheduler.
export struct DispatchOutcome {
    i32 next_sp;
    i32 return_value;
};

export i32 outcome_next_sp(DispatchOutcome *outcome) {
    return outcome->next_sp;
}

export i32 outcome_return_value(DispatchOutcome *outcome) {
    return outcome->return_value;
}

// Raw return values are an ABI detail of the final user-space boundary.
// Keep the mapping next to the typed error definition; irq_dispatch invokes it
// only after handling Result<i32, SyscallError>.
export i32 error_code(SyscallError error) {
    return case error of {
        NoProcess -> -1;
        OutOfMemory -> -2;
        HeapOverflow -> -3;
        BadFd -> -4;
        UnknownSyscall -> -5;
    };
}

i32 PTE_USER_RW = 0x0B; // VALID | WRITABLE | USER

// --- console and spawn hooks (MYOS-015) ---
// The kernel owns the syscall boundary but not the desktop: where a
// process's stdout goes and how a path becomes an executable image are
// MyOS decisions. MyOS registers handlers here at boot; without them the
// syscalls fall back to the serial port and SPAWN fails with UnknownSyscall.
//   console_write(pid, buf, count) -> bytes written (buf is a user address)
//   console_read(pid, buf, count)  -> bytes read, 0 when no input is pending
//   spawn(path)                    -> pid > 0, or 0 on failure
i32 g_console_write = 0;
i32 g_console_read = 0;
i32 g_spawn_handler = 0;

export void set_console(i32 write_handler, i32 read_handler) {
    g_console_write = write_handler;
    g_console_read = read_handler;
}

export void set_spawn_handler(i32 handler) {
    g_spawn_handler = handler;
}

// The pid of the process issuing the current syscall, or 0.
i32 current_pid_or_zero() {
    return case process.get_current_pid() of {
        Some(value) -> value;
        None -> 0;
    };
}

export void sys_exit(i32 code) {
    i32 pid = case process.get_current_pid() of {
        Some(value) -> value;
        None -> ({ return; });
    };
    Result<_, ProcessError> mark_zombie = process.set_state(pid, Zombie);
    case mark_zombie of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("sys_exit: current process disappeared"); });
    };
    Result<_, ProcessError> set_exit_code = process.set_exit_code(pid, code);
    case set_exit_code of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("sys_exit: current process disappeared"); });
    };
    Option<i32> task_id = process.get_task_id(pid);
    case task_id of {
        Some(tid) -> scheduler.terminate_task(tid);
        None -> ({ debug.panic("sys_exit: current process has no scheduler task"); });
    };
}

export Result<i32, SyscallError> sys_write(i32 fd, i32 buf, i32 count) {
    if (count <= 0) {
        return Ok(0);
    }
    if (fd == 1 || fd == 2) {
        i32 handler = g_console_write;
        if (handler != 0) {
            i32 pid = current_pid_or_zero();
            i32 written = handler(pid, buf, count);
            return Ok(written);
        }
        i32 i = 0;
        while (i < count) {
            i32 c = mem.read_byte(buf + i);
            serial.putc(c);
            i = i + 1;
        }
        return Ok(count);
    }
    SyscallError cause = BadFd;
    return Err(cause);
}

export Result<i32, SyscallError> sys_read(i32 fd, i32 buf, i32 count) {
    if (count <= 0) {
        return Ok(0);
    }
    if (fd == 0) {
        i32 handler = g_console_read;
        if (handler != 0) {
            i32 pid = current_pid_or_zero();
            i32 got = handler(pid, buf, count);
            return Ok(got);
        }
        i32 i = 0;
        while (i < count) {
            case serial.read_input() of {
                Some(c) -> ({
                    mem.write_byte(buf + i, c);
                    i = i + 1;
                });
                None -> ({ break; });
            };
        }
        return Ok(i);
    }
    SyscallError cause = BadFd;
    return Err(cause);
}

// SYS_SPAWN: start the executable at `path` (a NUL-terminated user-space
// string) as a new process. The pid comes back to the caller; a failure is
// reported as 0 so a user shell can print its own message.
export Result<i32, SyscallError> sys_spawn(i32 path) {
    i32 handler = g_spawn_handler;
    if (handler == 0) {
        return Err(SyscallError::UnknownSyscall);
    }
    i32 pid = handler(path);
    return Ok(pid);
}

export Result<i32, SyscallError> sys_sbrk(i32 increment) {
    i32 pid = case process.get_current_pid() of {
        Some(current) -> current;
        None -> ({ return Err(SyscallError::NoProcess); });
    };
    i32 cur_brk = case process.get_heap_break(pid) of {
        Some(value) -> value;
        None -> ({ return Err(SyscallError::NoProcess); });
    };
    if (increment == 0) {
        return Ok(cur_brk);
    }
    if (increment < 0) {
        // Shrinking not supported yet
        return Ok(cur_brk);
    }

    i32 new_brk = cur_brk + increment;
    if (new_brk >= loader.USER_STACK_BASE) {
        return Err(SyscallError::HeapOverflow);
    }

    // Map pages if new_brk crosses page boundaries
    i32 cur_page = (cur_brk + 4095) & ~4095;
    i32 target_page = (new_brk + 4095) & ~4095;
    i32 pd = case process.get_pdbr(pid) of {
        Some(value) -> value;
        None -> ({ return Err(SyscallError::NoProcess); });
    };

    while (cur_page < target_page) {
        i32 frame = case mmu.alloc_page() of {
            Some(f) -> f;
            None -> ({
                return Err(SyscallError::OutOfMemory);
            });
        };
        Result<_, MmuError> map_res = mmu.map_page(pd, cur_page, frame, PTE_USER_RW);
        case map_res of {
            Ok(_) -> 0;
            Err(AllocFailed) -> ({
                return Err(SyscallError::OutOfMemory);
            });
            Err(e) -> ({
                // InvalidDirectory/UnalignedAddress here mean a kernel
                // invariant broke: `pd` comes from a live process's pdbr
                // (always set from a real create_page_directory() success),
                // and `cur_page`/`frame` are always page-aligned by
                // construction. Not a recoverable syscall error -- panic
                // while we still have the pid for the diagnostic.
                debug.printf("sys_sbrk: unexpected MMU error for pid=%d\n", pid);
                debug.panic("kernel invariant broken -- MMU rejected an address sys_sbrk computed itself");
            });
        };
        cur_page = cur_page + 4096;
    }

    Result<_, ProcessError> set_heap_break = process.set_heap_break(pid, new_brk);
    case set_heap_break of {
        Ok(_) -> 0;
        Err(_) -> ({ return Err(SyscallError::NoProcess); });
    };
    return Ok(cur_brk);
}

// The syscall layer keeps both successes and failures typed. irq_dispatch is
// the only layer that writes the raw ABI result into the interrupted r1 frame.
Result<DispatchOutcome, SyscallError> resume_after_syscall(i32 sp, Result<i32, SyscallError> *result) {
    i32 ret = 0;
    if (result_take_ok<i32, SyscallError>(result, &ret) != 0) {
        DispatchOutcome outcome;
        outcome.next_sp = sp;
        outcome.return_value = ret;
        return Ok(outcome);
    }

    SyscallError error;
    result_take_err<i32, SyscallError>(result, &error);
    return Err(error);
}

export Result<DispatchOutcome, SyscallError> dispatch(i32 sp) {
    // Stack frame layout (from irq_trampoline.masm):
    // [sp+0]:  r7 (arg3)
    // [sp+4]:  r6 (arg2)
    // [sp+8]:  r5 (arg1)
    // [sp+12]: r4
    // [sp+16]: r3
    // [sp+20]: r2
    // [sp+24]: r1 (sys_nr / ret)
    // [sp+28]: r0
    // [sp+32]: bp
    // [sp+36]: lr
    // [sp+40]: SR
    // [sp+44]: PC
    i32 sys_nr = mem.read_word(sp + 24);
    i32 arg1   = mem.read_word(sp + 8);
    i32 arg2   = mem.read_word(sp + 4);
    i32 arg3   = mem.read_word(sp + 0);
    if (sys_nr == Syscall::EXIT) {
        sys_exit(arg1);
        DispatchOutcome outcome;
        outcome.next_sp = scheduler.tick(sp);
        outcome.return_value = 0;
        return Ok(outcome);
    }
    if (sys_nr == Syscall::READ) {
        Result<i32, SyscallError> result = sys_read(arg1, arg2, arg3);
        return resume_after_syscall(sp, &result);
    }
    if (sys_nr == Syscall::WRITE) {
        Result<i32, SyscallError> result = sys_write(arg1, arg2, arg3);
        return resume_after_syscall(sp, &result);
    }
    if (sys_nr == Syscall::SBRK) {
        Result<i32, SyscallError> result = sys_sbrk(arg1);
        return resume_after_syscall(sp, &result);
    }
    if (sys_nr == Syscall::YIELD) {
        DispatchOutcome outcome;
        outcome.next_sp = scheduler.tick(sp);
        outcome.return_value = 0;
        return Ok(outcome);
    }
    if (sys_nr == Syscall::SPAWN) {
        Result<i32, SyscallError> result = sys_spawn(arg1);
        return resume_after_syscall(sp, &result);
    }

    return Err(SyscallError::UnknownSyscall);
}
