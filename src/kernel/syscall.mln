package syscall;

import mem from "../mm/mem.mln";
import mmu from "../mm/mmu.mln";
import serial from "../io/serial.mln";
import debug from "../debug/debug.mln";
import process from "process.mln";
import scheduler from "scheduler.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { MmuError } from "../mm/mmu.mln";

// Syscall numbers
export i32 SYS_EXIT  = 1;
export i32 SYS_READ  = 2;
export i32 SYS_WRITE = 3;
export i32 SYS_OPEN  = 4;
export i32 SYS_CLOSE = 5;
export i32 SYS_SEEK  = 6;
export i32 SYS_SBRK  = 7;
export i32 SYS_YIELD = 8;
export i32 SYS_SPAWN = 9;

i32 PTE_USER_RW = 0x0B; // VALID | WRITABLE | USER

export void sys_exit(i32 code) {
    i32 pid = process.get_current_pid();
    if (pid > 0) {
        process.set_state(pid, process.state_zombie());
        process.set_exit_code(pid, code);
        i32 tid = process.get_task_id(pid);
        scheduler.terminate_task(tid);
    }
}

export i32 sys_write(i32 fd, i32 buf, i32 count) {
    if (count <= 0) {
        return 0;
    }
    if (fd == 1 || fd == 2) {
        i32 i = 0;
        while (i < count) {
            i32 c = mem.read_byte(buf + i);
            serial.putc(c);
            i = i + 1;
        }
        return count;
    }
    return -1;
}

export i32 sys_read(i32 fd, i32 buf, i32 count) {
    if (count <= 0) {
        return 0;
    }
    if (fd == 0) {
        i32 i = 0;
        while (i < count) {
            if (serial.has_input() == 0) {
                break;
            }
            i32 c = serial.read_input();
            mem.write_byte(buf + i, c);
            i = i + 1;
        }
        return i;
    }
    return -1;
}

export i32 sys_sbrk(i32 increment) {
    i32 pid = process.get_current_pid();
    if (pid <= 0) {
        return -1;
    }
    i32 cur_brk = process.get_heap_break(pid);
    if (increment == 0) {
        return cur_brk;
    }
    if (increment < 0) {
        // Shrinking not supported yet
        return cur_brk;
    }

    i32 new_brk = cur_brk + increment;
    // Map pages if new_brk crosses page boundaries
    i32 cur_page = (cur_brk + 4095) & ~4095;
    i32 target_page = (new_brk + 4095) & ~4095;
    i32 pd = process.get_pdbr(pid);

    while (cur_page < target_page) {
        Result<i32, MmuError> frame_res = mmu.alloc_page();
        i32 frame = case frame_res of {
            Ok(f) -> f;
            Err(AllocFailed) -> ({
                return -1;
            });
            Err(InvalidDirectory) -> ({
                return -1;
            });
            Err(UnalignedAddress(a)) -> ({
                return -1;
            });
        };
        Result<_, MmuError> map_res = mmu.map_page(pd, cur_page, frame, PTE_USER_RW);
        case map_res of {
            Ok(_) -> 0;
            Err(AllocFailed) -> ({
                return -1;
            });
            Err(InvalidDirectory) -> ({
                return -1;
            });
            Err(UnalignedAddress(a)) -> ({
                return -1;
            });
        };
        cur_page = cur_page + 4096;
    }

    process.set_heap_break(pid, new_brk);
    return cur_brk;
}

export i32 dispatch(i32 sp) {
    // Stack frame layout (from irq_trampoline.masm):
    // [sp+0]:  r7 (arg3)
    // [sp+4]:  r6 (arg2)
    // [sp+8]:  r5 (arg1)
    // [sp+12]: r4
    // [sp+16]: r3
    // [sp+20]: r2
    // [sp+24]: r1 (sys_nr / ret)
    // [sp+28]: r0
    // [sp+32]: bp
    // [sp+36]: lr
    // [sp+40]: SR
    // [sp+44]: PC
    i32 sys_nr = mem.read_word(sp + 24);
    i32 arg1   = mem.read_word(sp + 8);
    i32 arg2   = mem.read_word(sp + 4);
    i32 arg3   = mem.read_word(sp + 0);
    i32 ret    = -1;

    if (sys_nr == SYS_EXIT) {
        sys_exit(arg1);
        return scheduler.tick(sp);
    }
    if (sys_nr == SYS_READ) {
        ret = sys_read(arg1, arg2, arg3);
    }
    if (sys_nr == SYS_WRITE) {
        ret = sys_write(arg1, arg2, arg3);
    }
    if (sys_nr == SYS_SBRK) {
        ret = sys_sbrk(arg1);
    }
    if (sys_nr == SYS_YIELD) {
        ret = 0;
        mem.write_word(sp + 24, ret);
        return scheduler.tick(sp);
    }

    mem.write_word(sp + 24, ret);
    return sp;
}
