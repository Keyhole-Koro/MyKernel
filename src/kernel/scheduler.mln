package scheduler;

import debug from "../debug/debug.mln";
import serial from "../io/serial.mln";
import mem from "../mm/mem.mln";
import heap from "../mm/heap.mln";
import irq from "../arch/irq.mln";
import { get_task0_addr, get_task1_addr } from "../arch/task_funcs.masm";
import { halt_cpu } from "../arch/halt.masm";

// Bumped by the timer interrupt handler.
i32 g_irq_count = 0;

i32 task_sps[2];
i32 current_task = 0;
i32 tasks_initialized = 0;

// Interrupt handler invoked (via irq_trampoline.masm) on each timer interrupt.
// It receives the current stack pointer as an argument, saves it for the
// current task, and returns the stack pointer of the next task to resume.
//
// Exported so the trampoline can resolve the label; MyLang mangles it to
// `scheduler_irq_handler`, which irq_trampoline.masm imports.
export i32 irq_handler(i32 sp) {
    g_irq_count = g_irq_count + 1;

    // Serial RX: drain all received bytes and echo them back. 'q' (0x71) quits.
    while (serial.rx_ready() != 0) {
        i32 c = serial.read_rx();
        if (c == 113) {
            serial.putc(10); // newline
            halt_cpu();
        }
        serial.putc(c);
    }

    if (tasks_initialized == 0) {
        return sp;
    }

    // Save current task's SP
    task_sps[current_task] = sp;

    // Switch to next task
    current_task = (current_task + 1) % 2;

    // Return new task's SP
    return task_sps[current_task];
}

// Demo tasks. Exported so task_funcs.masm can take their addresses; MyLang
// mangles them to `scheduler_task0` / `scheduler_task1`.
export void task0() {
    i32 i = 0;
    while (1) {
        if (i % 1000 == 0) {
            debug.println("Task 0 is running...");
        }
        i = i + 1;
    }
}

export void task1() {
    i32 i = 0;
    while (1) {
        if (i % 1000 == 0) {
            debug.println("Task 1 is running...");
        }
        i = i + 1;
    }
}

void init_task(i32 task_idx, i32 func_ptr, i32 stack_bottom) {
    i32 sp = stack_bottom;

    // Construct initial stack frame.
    // Pushed in reverse order of pops: r7..r0, bp, lr, SR, PC.

    sp = sp - 4; mem.write_word(sp, func_ptr); // PC
    sp = sp - 4; mem.write_word(sp, 1);        // SR (IE=1)
    sp = sp - 4; mem.write_word(sp, 0);        // lr
    sp = sp - 4; mem.write_word(sp, stack_bottom); // bp
    sp = sp - 4; mem.write_word(sp, 0);        // r0
    sp = sp - 4; mem.write_word(sp, 0);        // r1
    sp = sp - 4; mem.write_word(sp, 0);        // r2
    sp = sp - 4; mem.write_word(sp, 0);        // r3
    sp = sp - 4; mem.write_word(sp, 0);        // r4
    sp = sp - 4; mem.write_word(sp, 0);        // r5
    sp = sp - 4; mem.write_word(sp, 0);        // r6
    sp = sp - 4; mem.write_word(sp, 0);        // r7

    task_sps[task_idx] = sp;
}

// Set up the demo tasks, enable interrupts, and turn the current thread of
// execution into task 0. Never returns.
export void start() {
    // Set up task 1.
    i32 stack1 = heap.alloc(1024);
    init_task(1, get_task1_addr(), stack1 + 1024);

    // Task 0 is the current context: the first timer interrupt saves our SP
    // into task_sps[0], so tasks_initialized must be set before we enter the
    // loop below.
    tasks_initialized = 1;

    irq.set_handler();
    irq.enable();
    debug.println("kernel: irq/task on");
    debug.println("kernel: type to echo (q to quit)");

    task0(); // Main loop becomes task 0.
}
