package scheduler;

import debug from "@kernel/debug/debug.mln";
import mem from "@kernel/mm/mem.mln";
import heap from "@kernel/mm/heap.mln";
import process from "process.mln";
import thread from "thread.mln";
import mmu from "@kernel/mm/mmu.mln";
import { wfi_cpu } from "@kernel/arch/wfi.masm";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";

/** Failure cases returned by kernel-thread creation. */
export enum SchedulerError {
    OutOfMemory,
    TaskSlotFull,
}

i32 g_irq_count = 0;
i32 g_initialized = 0;
i32 idle_sp = 0;
i32 deferred_cleanup_slot = -1;
i32 MMU_PDBR_ADDR = 0x24000104;
i32 KERNEL_SP_ADDR = 0x24000110;

/** Runs the non-returning WFI fallback context while no TCB is runnable. */
void idle_main() {
    while (1) { wfi_cpu(); }
}

/** @return Scheduler timer-tick count used by sleep and futex deadlines. */
export i32 ticks() { return g_irq_count; }

/**
 * Exposes a stable nonzero execution-context index to the mocking runtime.
 * @return Current TCB slot plus one; zero represents the idle context.
 */
export i32 current_context() { return thread.current_slot() + 1; }

/**
 * Finds the next Runnable TCB by round-robin slot order.
 * @param start First slot to inspect.
 * @param count Number of slots within the current high-water range.
 * @return Some(runnable slot), or None when every candidate is unavailable.
 */
Option<i32> find_next_runnable(i32 start, i32 count) {
    if (count <= 0) { return None; }
    i32 slot = start;
    i32 checked = 0;
    while (checked < count) {
        if (thread.runnable(slot)) { return Some(slot); }
        slot = (slot + 1) % count;
        checked++;
    }
    return None;
}

/**
 * Advances scheduler time and chooses the context to resume after a timer IRQ.
 * @param sp Saved interrupt-frame SP of the interrupted context.
 * @return Saved kernel SP of the next TCB, or the idle frame when none is runnable.
 */
export i32 tick(i32 sp) {
    g_irq_count++;
    return reschedule(sp);
}

/**
 * Saves the current TCB, performs safe deferred cleanup, and selects a next TCB.
 * Switch-in also installs the owner Process PDBR and per-thread user SP.
 * @param sp Saved interrupt-frame SP of the context being switched out.
 * @return Saved kernel SP that irq_resume must restore.
 */
export i32 reschedule(i32 sp) {
    if (!g_initialized) { return sp; }

    // This invocation runs on a different stack from the TCB retired by the
    // preceding switch, so its stack can finally be released safely.
    if (deferred_cleanup_slot >= 0) {
        i32 retired = deferred_cleanup_slot;
        deferred_cleanup_slot = -1;
        thread.finish_deferred_cleanup(retired);
    }

    i32 count = thread.high_water();
    i32 i = 0;
    while (i < count) {
        if (thread.sleeping_until(i, g_irq_count)) { thread.make_runnable(i); }
        thread.wake_futex_timeout(i, g_irq_count);
        i++;
    }

    i32 current = thread.current_slot();
    if (current >= 0) {
        thread.switch_out(current, sp, mem.read_word(KERNEL_SP_ADDR));
        if (thread.exiting(current)) { deferred_cleanup_slot = current; }
    } else {
        idle_sp = sp;
    }

    i32 start = 0;
    if (current >= 0 && count > 0) { start = (current + 1) % count; }
    Option<i32> next = find_next_runnable(start, count);
    return case next of {
        Some(slot) -> ({
            thread.set_current_slot(slot);
            case thread.owner_pid_at(slot) of {
                Some(pid) -> ({
                    Option<i32> pdbr = process.get_pdbr(pid);
                    case pdbr of {
                        Some(value) -> ({ mem.write_word(MMU_PDBR_ADDR, value); });
                        None -> ({ debug.panic("scheduler: thread owner process is missing"); });
                    };
                    mem.write_word(KERNEL_SP_ADDR, thread.saved_user_sp(slot));
                });
                None -> ({
                    i32 kernel_pdbr = mmu.kernel_page_directory();
                    if (kernel_pdbr != 0) { mem.write_word(MMU_PDBR_ADDR, kernel_pdbr); }
                    mem.write_word(KERNEL_SP_ADDR, 0);
                });
            };
            thread.make_running(slot);
            thread.saved_kernel_sp(slot);
        });
        None -> ({
            thread.set_current_slot(-1);
            idle_sp;
        });
    };
}

/**
 * Blocks the current TCB until the next tick and schedules another context.
 * @param sp Saved interrupt-frame SP of the yielding TCB.
 * @return Saved kernel SP of the next context to resume.
 */
export i32 yield_until_tick(i32 sp) {
    i32 current = thread.current_slot();
    if (current >= 0) { thread.sleep_until(current, g_irq_count + 1); }
    return reschedule(sp);
}

/** @param mask Nonzero notification bits to arm on the current TCB. */
export void arm_notification(i32 mask) {
    thread.arm_notification(thread.current_slot(), mask);
}

/** @param mask Notification bits to clear from armed and pending state. */
export void disarm_notification(i32 mask) {
    thread.disarm_notification(thread.current_slot(), mask);
}

/**
 * Returns immediately for pending bits or blocks the current TCB for a notification.
 * @param sp Saved syscall interrupt-frame SP.
 * @param mask Notification bits accepted by the caller.
 * @param notification_out Kernel pointer receiving immediately consumed bits.
 * @return sp for an immediate result, or the next scheduled context's SP after blocking.
 */
export i32 wait_notification(i32 sp, i32 mask, i32 *notification_out) {
    *notification_out = 0;
    i32 current = thread.current_slot();
    if (current < 0 || mask == 0) { return sp; }
    i32 ready = thread.take_notification(current, mask);
    if (ready) {
        *notification_out = ready;
        return sp;
    }
    thread.block_notification(current, mask);
    return reschedule(sp);
}

/**
 * Delivers notification bits to every TCB owned by a process.
 * @param pid Destination process.
 * @param mask Notification bits produced by the event source.
 */
export void notify_pid(i32 pid, i32 mask) {
    i32 i = 0;
    while (i < thread.high_water()) {
        case thread.owner_pid_at(i) of {
            Some(owner) -> ({ if (owner == pid) { thread.notify(i, mask); } });
            None -> _;
        };
        i++;
    }
}

/** @param mask Notification bits broadcast to every TCB that armed them. */
export void notify_armed(i32 mask) {
    i32 i = 0;
    while (i < thread.high_water()) {
        thread.notify(i, mask);
        i++;
    }
}

/** Kernel-side sleep used outside the syscall frame path. */
/**
 * Sleeps the current kernel context for at least the requested tick count.
 * Timer IRQ scheduling switches away while this function waits in WFI.
 * @param ticks_to_sleep Relative nonnegative scheduler tick count.
 */
export void sleep(i32 ticks_to_sleep) {
    i32 current = thread.current_slot();
    if (current < 0) { return; }
    thread.sleep_until(current, g_irq_count + ticks_to_sleep);
    while (thread.blocked(current)) { wfi_cpu(); }
}

/** Constructs the interrupt-style frame consumed by irq_trampoline. */
/**
 * Builds the interrupt-style initial frame for a kernel thread.
 * @param entry Initial kernel PC.
 * @param stack_top Exclusive top of the allocated kernel stack.
 * @return Saved SP pointing at the completed register frame.
 */
i32 build_context(fn() -> void entry, i32 stack_top) {
    i32 sp = stack_top;
    sp = sp - 4; mem.write_word(sp, (i32)entry);
    sp = sp - 4; mem.write_word(sp, 1);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, stack_top);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    sp = sp - 4; mem.write_word(sp, 0);
    return sp;
}

/**
 * Allocates a stack, builds an initial frame, and publishes a kernel TCB.
 * @param entry Non-returning kernel-thread entry function.
 * @param stack_bytes Requested kernel-stack allocation size.
 * @return Ok(global TCB slot), Err(OutOfMemory), or Err(TaskSlotFull).
 */
export Result<i32, SchedulerError> spawn_kernel_thread(fn() -> void entry, i32 stack_bytes) {
    i32 slot = case thread.find_free_slot() of {
        Some(value) -> value;
        None -> ({ return Err(SchedulerError::TaskSlotFull); });
    };
    i32 stack = case heap.alloc(stack_bytes) of {
        Ok(value) -> value;
        Err(_) -> ({ return Err(SchedulerError::OutOfMemory); });
    };
    i32 sp = build_context(entry, stack + stack_bytes);
    thread.publish_kernel(slot, sp, stack, stack_bytes);
    return Ok(slot);
}

/** Initializes the TCB table and creates the scheduler's boot and idle contexts. */
export void init() {
    thread.init();
    g_irq_count = 0;
    deferred_cleanup_slot = -1;

    i32 idle_bytes = 8192;
    i32 idle_stack = case heap.alloc(idle_bytes) of {
        Ok(value) -> value;
        Err(_) -> ({ debug.panic("scheduler: no memory for idle stack"); 0; });
    };
    idle_sp = build_context(idle_main, idle_stack + idle_bytes);

    thread.publish_boot(0);
    thread.set_current_slot(0);
    g_initialized = 1;
}
