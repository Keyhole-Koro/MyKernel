package scheduler;

import debug from "../debug/debug.mln";
import mem from "../mm/mem.mln";
import heap from "../mm/heap.mln";
import serial from "../io/serial.mln";
import mouse from "../io/mouse.mln";
import process from "process.mln";
import { ProcessState, ProcessError } from "process.mln";
import mmu from "../mm/mmu.mln";
import { wfi_cpu } from "../arch/wfi.masm";
import { halt_cpu } from "../arch/halt.masm";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// Typed failure reasons for scheduler operations.
export enum SchedulerError {
    OutOfMemory,   // Memory allocation failed for task stack
    TaskSlotFull,  // Task slots exhausted (MAX_TASKS reached)
}

// Bumped by the timer interrupt handler.
i32 g_irq_count = 0;

import kernel_config from "kernel_config.mln";

i32 task_sps[256];
i32 task_pid[256]; // 0 = kernel task, >0 = user process PID
i32 current_task = 0;
i32 tasks_initialized = 0;

i32 MMU_PDBR_ADDR  = 0x24000104;
i32 KERNEL_SP_ADDR = 0x24000110;

// Task state constants
enum TaskState {
    TASK_RUNNABLE = 0,
    TASK_SLEEPING = 1,
    TASK_EMPTY = 2
}

// Task state management
i32 task_state[256];
i32 task_wake_tick[256];  // Tick when the task should wake up

// Dedicated idle context. When no task is runnable the scheduler switches to
// this context (a wfi loop) instead of resuming a sleeping task's stack, so
// "some task is always current" is no longer an implicit assumption.
// current_task == IDLE_TASK while it runs.
i32 IDLE_TASK = -1;
i32 idle_sp = 0;

/**
 * Asserts that a process state update succeeded, panicking if invalid.
 * @param update Result of the process table update.
 */
void require_process_update(Result<_, ProcessError> update) {
    case update of {
        Ok(_) -> 0;
        Err(_) -> ({ debug.panic("scheduler: task references an invalid process"); });
    };
}

/**
 * Unwraps an optional process table value, panicking if None.
 * @param value Optional process attribute value.
 * @return Unwrapped integer value.
 */
i32 require_process_value(Option<i32> value) {
    return case value of {
        Some(result) -> result;
        None -> ({
            debug.panic("scheduler: task references an invalid process");
            0;
        });
    };
}

/**
 * Main function for the idle kernel task (wfi in an infinite loop).
 */
void idle_main() {
    while (1) {
        wfi_cpu();
    }
}

// Interrupt handler invoked (via irq_trampoline.masm) on each timer interrupt.
// It receives the current stack pointer as an argument, saves it for the
// current task, and returns the stack pointer of the next task to resume.
//
// Exported so the trampoline can resolve the label; MyLang mangles it to
// `scheduler_irq_handler`, which irq_trampoline.masm imports.
/**
 * Returns the current elapsed timer tick count.
 * @return Number of timer interrupts since boot.
 */
export i32 ticks() {
    return g_irq_count;
}

/**
 * Returns a stable identifier for the current execution context.
 *
 * Used primarily by tests to distinguish between contexts.
 * @return Context index (0 for idle, >0 for normal tasks).
 */
export i32 current_context() {
    return current_task + 1;
}

// Number of task slots actually in use (highest spawned index + 1). The tick
// handler runs at every timer interrupt (1 kHz real time), so it must not scan
// all MAX_TASKS slots: with MyLang's verbose codegen a 256-slot double scan
// costs tens of thousands of instructions, and once the handler exceeds one
// timer period the CPU does nothing but service interrupts (total starvation).
// Scanning only the live slots keeps the handler a few hundred instructions.
i32 g_task_count = 0;

/**
 * Finds the index of the next runnable task in the scheduler table.
 * @param start Starting index to search from.
 * @param count Number of task slots to scan.
 * @return Some(task_idx) if a runnable task is found, or None if all are sleeping/empty.
 */
Option<i32> find_next_runnable(i32 start, i32 count) {
    i32 next_task = start;
    i32 checked = 0;
    while (checked < count) {
        if (task_state[next_task] == TASK_RUNNABLE) {
            return Some(next_task);
        }
        next_task = (next_task + 1) % count;
        checked++;
    }
    return None;
}

/**
 * Timer interrupt handler that performs preemptive round-robin scheduling.
 *
 * Updates tick count, wakes sleeping tasks, saves current task context, switches MMU page directories if necessary, and returns the next task's stack pointer.
 * @param sp Stack pointer of the interrupted context frame.
 * @return Stack pointer of the next task to resume.
 */
export i32 tick(i32 sp) {
    g_irq_count++;
    return reschedule(sp);
}

/**
 * Picks the next task without counting a tick: what a syscall that gives
 * the CPU away (YIELD, EXIT) calls, so the clock only advances on real
 * timer interrupts.
 * @param sp Stack pointer of the interrupted context frame.
 * @return Stack pointer of the next task to resume.
 */
export i32 reschedule(i32 sp) {
    if (tasks_initialized == 0) {
        return sp;
    }

    // Check if any sleeping tasks should be woken up
    i32 count = g_task_count;
    i32 i = 0;
    while (i < count) {
        if (task_state[i] == TASK_SLEEPING) {
            if (g_irq_count >= task_wake_tick[i]) {
                task_state[i] = TASK_RUNNABLE; // Wake up!
            }
        }
        i++;
    }

    // Save the interrupted context: a real task's slot, or the idle context.
    if (current_task >= 0) {
        task_sps[current_task] = sp;
        i32 cur_pid = task_pid[current_task];
        if (cur_pid > 0) {
            Result<_, ProcessError> save_user_sp = process.set_user_sp(cur_pid, mem.read_word(KERNEL_SP_ADDR));
            require_process_update(save_user_sp);
            Option<ProcessState> current_state = process.get_state(cur_pid);
            case current_state of {
                Some(state) -> ({
                    case state of {
                        Running -> ({
                            ProcessState ready_state = Ready;
                            Result<_, ProcessError> make_ready = process.set_state(cur_pid, ready_state);
                            require_process_update(make_ready);
                        });
                        _ -> 0;
                    };
                });
                None -> ({ debug.panic("scheduler: current task references an invalid process"); });
            };
        }
    } else {
        idle_sp = sp;
    }

    // Round-robin scan starting after the current task (from 0 when idle).
    i32 start = 0;
    if (current_task >= 0) { start = (current_task + 1) % count; }
    Option<i32> next_opt = find_next_runnable(start, count);
    case next_opt of {
        Some(next_task) -> ({
            current_task = next_task; // Switch to next task
            i32 next_pid = task_pid[next_task];
            if (next_pid > 0) {
                mem.write_word(KERNEL_SP_ADDR, require_process_value(process.get_user_sp(next_pid)));
                mem.write_word(MMU_PDBR_ADDR, require_process_value(process.get_pdbr(next_pid)));
                Result<_, ProcessError> select_process = process.set_current_pid(next_pid);
                require_process_update(select_process);
                ProcessState running_state = Running;
                Result<_, ProcessError> make_running = process.set_state(next_pid, running_state);
                require_process_update(make_running);
            } else {
                process.clear_current_pid();
            }
            return task_sps[next_task];
        });
        None -> 0;
    };

    // Nothing is runnable: run the dedicated idle context until a wake-up.
    current_task = IDLE_TASK;
    process.clear_current_pid();
    return idle_sp;
}

/**
 * A YIELD syscall: the calling process sleeps until the next tick rather
 * than running again as soon as the round-robin comes back to it -- a
 * polling loop (an app waiting for a reply or an event) would otherwise
 * burn every slice the CPU has. Called from the syscall path with the
 * interrupted frame; returns the frame to resume, like tick().
 * @param sp Stack pointer of the interrupted context frame.
 * @return Stack pointer of the next task to resume.
 */
export i32 yield_until_tick(i32 sp) {
    if (current_task >= 0) {
        task_wake_tick[current_task] = g_irq_count + 1;
        task_state[current_task] = TASK_SLEEPING;
    }
    return reschedule(sp);
}

/**
 * Suspends execution of the current task for a specified duration in timer ticks.
 * @param ticks Number of timer ticks to sleep.
 */
export void sleep(i32 ticks) {
    // Capture our own slot: current_task changes under us once the scheduler
    // switches away, and only our own state says when we may run on.
    i32 me = current_task;
    i32 target = g_irq_count + ticks;
    task_wake_tick[me] = target;
    task_state[me] = TASK_SLEEPING; // Set state to SLEEPING

    // The next timer interrupt switches away (to another runnable task or the
    // idle context); a SLEEPING task is never resumed, so we return from the
    // wfi only after the scheduler marked us RUNNABLE again. The loop guards
    // the race where the tick fires between the store above and the wfi.
    while (task_state[me] == TASK_SLEEPING) {
        wfi_cpu(); // Idle until next interrupt instead of busy-spinning
    }
}

// (Demo tasks have been removed. You can use spawn_task() to launch apps here!)

/**
 * Constructs an initial interrupt-style register frame at the top of a stack.
 * @param func_ptr Function entry point address.
 * @param stack_bottom Top address of the allocated stack area (stack grows downward).
 * @return Initial stack pointer pointing to the prepared frame.
 */
i32 build_context(i32 func_ptr, i32 stack_bottom) {
    i32 sp = stack_bottom;

    sp = sp - 4; mem.write_word(sp, func_ptr); // PC
    sp = sp - 4; mem.write_word(sp, 1);        // SR (IE=1)
    sp = sp - 4; mem.write_word(sp, 0);        // IRQ entry PC slot
    sp = sp - 4; mem.write_word(sp, 0);        // IRQ entry SR slot
    sp = sp - 4; mem.write_word(sp, 0);        // IRQ entry lr slot
    sp = sp - 4; mem.write_word(sp, 0);        // IRQ entry bp slot
    sp = sp - 4; mem.write_word(sp, 0);        // lr
    sp = sp - 4; mem.write_word(sp, stack_bottom); // bp
    sp = sp - 4; mem.write_word(sp, 0);        // r0
    sp = sp - 4; mem.write_word(sp, 0);        // r1
    sp = sp - 4; mem.write_word(sp, 0);        // r2
    sp = sp - 4; mem.write_word(sp, 0);        // r3
    sp = sp - 4; mem.write_word(sp, 0);        // r4
    sp = sp - 4; mem.write_word(sp, 0);        // r5
    sp = sp - 4; mem.write_word(sp, 0);        // r6
    sp = sp - 4; mem.write_word(sp, 0);        // r7

    return sp;
}

/**
 * Initializes a task's saved context on its initial stack.
 * @param task_idx Index in the task table.
 * @param func_ptr Entry point function pointer.
 * @param stack_bottom Top address of the allocated stack memory.
 */
void init_task(i32 task_idx, i32 func_ptr, i32 stack_bottom) {
    task_sps[task_idx] = build_context(func_ptr, stack_bottom);
}

/**
 * Spawns a new kernel task running the given function with a 1 KiB heap-allocated stack.
 * @param func_ptr Function entry point address.
 * @return Ok(task_id) on success, or Err(SchedulerError) on OOM or slot exhaustion.
 */
export Result<i32, SchedulerError> spawn_task(i32 func_ptr) {
    return spawn_task_sized(func_ptr, 1024);
}

/**
 * Spawns a new kernel task with a stack of the given size (bytes, heap-allocated).
 * A task that runs application code -- deep call chains, buffers on the
 * stack -- needs more than the 1 KiB a polling loop gets by.
 * @param func_ptr Function entry point address.
 * @param stack_bytes Stack size in bytes.
 * @return Ok(task_id) on success, or Err(SchedulerError) on OOM or slot exhaustion.
 */
export Result<i32, SchedulerError> spawn_task_sized(i32 func_ptr, i32 stack_bytes) {
    i32 i = 0;
    while (i < kernel_config.MAX_TASKS) {
        if (task_state[i] == TASK_EMPTY) {
            i32 stack = heap.alloc(stack_bytes);
            if (stack == 0) {
                debug.println("Error: Out of memory for task stack!");
                return Err(SchedulerError::OutOfMemory);
            }
            init_task(i, func_ptr, stack + stack_bytes);
            task_state[i] = TASK_RUNNABLE;
            task_pid[i] = 0; // Kernel task
            if (i >= g_task_count) {
                g_task_count = i + 1; // grow the live-slot range the tick scans
            }
            return Ok(i);
        }
        i++;
    }
    
    debug.println("Error: Task slots exhausted! (MAX_TASKS reached)");
    return Err(SchedulerError::TaskSlotFull);
}

/**
 * Registers a user process task in the scheduler with a pre-configured stack pointer.
 * @param pid Associated process ID.
 * @param initial_sp Prepared initial kernel stack pointer.
 * @return Ok(task_id) on success, or Err(SchedulerError) on slot exhaustion.
 */
export Result<i32, SchedulerError> spawn_proc_task(i32 pid, i32 initial_sp) {
    i32 i = 0;
    while (i < kernel_config.MAX_TASKS) {
        if (task_state[i] == TASK_EMPTY) {
            task_sps[i] = initial_sp;
            task_state[i] = TASK_RUNNABLE;
            task_pid[i] = pid;
            Result<_, ProcessError> set_task = process.set_task_id(pid, i);
            require_process_update(set_task);
            if (i >= g_task_count) {
                g_task_count = i + 1;
            }
            return Ok(i);
        }
        i++;
    }
    debug.println("scheduler: out of task slots for process");
    return Err(SchedulerError::TaskSlotFull);
}

/**
 * Terminates a task slot and marks it as empty.
 * @param task_idx Task index to terminate.
 */
export void terminate_task(i32 task_idx) {
    if (task_idx >= 0 && task_idx < kernel_config.MAX_TASKS) {
        task_state[task_idx] = TASK_EMPTY;
        task_pid[task_idx] = 0;
    }
}

/**
 * Initializes the round-robin scheduler, sets up the dedicated idle context, and marks the current thread as Task 0.
 */
export void init() {
    // Initialize task states to EMPTY
    i32 i = 0;
    while (i < kernel_config.MAX_TASKS) {
        task_state[i] = TASK_EMPTY;
        task_pid[i] = 0;
        i++;
    }

    // Build the dedicated idle context. 512 bytes is plenty: the wfi loop
    // itself is a leaf, and an interrupt frame (PC/SR + 10 registers) is the
    // only thing ever pushed on top of it.
    i32 idle_stack = heap.alloc(512);
    if (idle_stack == 0) {
        debug.println("scheduler: FATAL: no memory for the idle stack");
        return;
    }
    idle_sp = build_context(idle_main, idle_stack + 512);

    // Task 0 is the current context: the first timer interrupt saves our SP
    // into task_sps[0], so tasks_initialized must be set before we enter the loop.
    task_state[0] = TASK_RUNNABLE;
    task_pid[0] = 0;
    current_task = 0;
    g_task_count = 1; // task 0 (this context) is live; spawn_task grows this
    tasks_initialized = 1;

    // Interrupts can now safely context-switch!
}
