package irq_dispatch;

import mem from "../mm/mem.mln";
import scheduler from "scheduler.mln";
import serial from "../io/serial.mln";
import mouse from "../io/mouse.mln";
import debug from "../debug/debug.mln";
import process from "process.mln";
import syscall from "syscall.mln";
import mmu from "../mm/mmu.mln";

i32 IRQ_CAUSE_ADDR = 0x24000084;
i32 IRQ_CAUSE_TIMER  = 1;
i32 IRQ_CAUSE_MOUSE  = 2;
i32 IRQ_CAUSE_SERIAL = 4;
i32 IRQ_CAUSE_SSD    = 8;
i32 IRQ_CAUSE_SYSCALL = 16;
i32 IRQ_CAUSE_PAGE_FAULT = 32;
i32 IRQ_CAUSE_PRIVILEGE_VIOLATION = 64;

export i32 dispatch(i32 sp) {
    i32 cause = mem.read_word(IRQ_CAUSE_ADDR);
    
    // Ack the handled interrupts to hardware
    mem.write_word(IRQ_CAUSE_ADDR, cause);

    if ((cause & IRQ_CAUSE_SERIAL) != 0) {
        // Drain the hardware RX register into the software input queue.
        while (serial.rx_ready() != 0) {
            i32 c = serial.read_rx();
            serial.input_push(c);
        }
    }

    if ((cause & IRQ_CAUSE_MOUSE) != 0) {
        mouse.drain_hw();
    }

    // Handle synchronous traps first
    if ((cause & IRQ_CAUSE_PRIVILEGE_VIOLATION) != 0) {
        debug.println("irq: privilege violation in user process");
        debug.printf("irq: fault addr: 0x%x status: %i\n", mmu.get_fault_address(), mmu.get_fault_status());
        i32 cur_pid = process.get_current_pid();
        if (cur_pid > 0) {
            syscall.sys_exit(-1);
            sp = scheduler.tick(sp);
            return sp;
        }
    }

    if ((cause & IRQ_CAUSE_PAGE_FAULT) != 0) {
        debug.println("irq: unhandled page fault in user process");
        i32 cur_pid = process.get_current_pid();
        if (cur_pid > 0) {
            syscall.sys_exit(-14);
            sp = scheduler.tick(sp);
            return sp;
        }
    }

    if ((cause & IRQ_CAUSE_SYSCALL) != 0) {
        sp = syscall.dispatch(sp);
    }

    if ((cause & IRQ_CAUSE_TIMER) != 0) {
        sp = scheduler.tick(sp);
    }

    return sp;
}
