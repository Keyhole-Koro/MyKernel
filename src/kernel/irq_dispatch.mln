package irq_dispatch;

import mem from "../mm/mem.mln";
import scheduler from "scheduler.mln";
import serial from "../io/serial.mln";
import mouse from "../io/mouse.mln";

i32 IRQ_CAUSE_ADDR = 0x24000084;
i32 IRQ_CAUSE_TIMER  = 1;
i32 IRQ_CAUSE_MOUSE  = 2;
i32 IRQ_CAUSE_SERIAL = 4;
i32 IRQ_CAUSE_SSD    = 8;

export i32 dispatch(i32 sp) {
    i32 cause = mem.read_word(IRQ_CAUSE_ADDR);
    
    // Ack the handled interrupts to hardware
    mem.write_word(IRQ_CAUSE_ADDR, cause);

    if ((cause & IRQ_CAUSE_SERIAL) != 0) {
        // Drain the hardware RX register into the software input queue. Tasks
        // (the shell) read from that queue, so bytes are never consumed here in a
        // way that starves the reader. Echo happens in the reader, not here.
        while (serial.rx_ready() != 0) {
            i32 c = serial.read_rx();
            serial.input_push(c);
        }
    }

    if ((cause & IRQ_CAUSE_MOUSE) != 0) {
        // Drain the hardware event FIFO into the software queue the UI task
        // reads. Every transition survives, so a click that presses and
        // releases within one display frame still dispatches.
        mouse.drain_hw();
    }

    // SSD IRQ: completion is signalled through the STATUS register, which the
    // waiting driver re-reads after its wfi; the ack above is all that's needed.

    if ((cause & IRQ_CAUSE_TIMER) != 0) {
        sp = scheduler.tick(sp);
    }

    return sp;
}
