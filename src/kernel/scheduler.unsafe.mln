namespace scheduler;

import debug from "@kernel/debug/debug.mln";
import mem from "@kernel/mm/mem.mln";
import heap from "@kernel/mm/heap.mln";
import process from "process.mln";
import thread from "thread.mln";
import mmu from "@kernel/mm/mmu.mln";
import irq from "@kernel/arch/irq.mln";
import irq_frame from "@kernel/arch/irq_frame.mln";
import { SyscallStatus } from "@contracts/myos/syscall.contract.mln";
import { wfi_cpu } from "@kernel/arch/wfi.masm";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { Pid, ProcessExitStatus } from "@contracts/process/control.contract.mln";

/** Failure cases returned by kernel-thread creation. */
export enum SchedulerError {
    OutOfMemory,
    TaskSlotFull,
}

// Scheduler ticks since init: the ticks the timer's clock has passed. Each
// timer interrupt brings it up to the clock, and so does the end of a hold.
i32 g_irq_count = 0;
bool g_initialized = false;
i32 idle_sp = 0;
Option<i32> deferred_cleanup_slot;
// thread.ready_epoch() when the scheduler last found nothing to run; None
// until it first does.
Option<i32> g_idle_epoch;
i32 MMU_PDBR_ADDR = 0x24000104;
i32 KERNEL_SP_ADDR = 0x24000110;
// The timer, a clock of 256 units a tick. Read: the ticks so far in the high
// 24 bits, how far the current tick has got in the low 8; it wraps at 2^24
// ticks. Write: a clock value to interrupt next at, the ticks before it
// passing without an interrupt; 0 for every tick.
i32 TIMER_ADDR = 0x24000088;
i32 CLOCK_SHIFT = 8;
i32 CLOCK_TICK_MASK = 0xFFFFFF;
// The clock's ticks when g_irq_count last caught up with them.
i32 g_clock_ticks = 0;
// The timer holds its interrupts back until a wake tick: idle set one, having
// nothing to do before it (hold_until_due).
bool g_held = false;
// The furthest a hold reaches, and the wake tick of one with no deadline to
// wake for: 2^22 ticks, 70 minutes at the usual 1 ms tick. The clock's 2^24
// ticks tell a tick ahead from one behind only within half of them.
i32 HOLD_LONGEST = 0x400000;

// Where the CPU's time went, in clock units: the clock when the scheduler
// started, the clock up to which time has been charged, and what the time
// since then belongs to -- a thread's slot, or None for idle.
i32 g_clock_base = 0;
i32 g_clock_charged = 0;
Option<i32> g_charge_to;
i32 g_idle_time = 0;
i32 g_kernel_time = 0;

/**
 * Runs the non-returning WFI fallback context while no TCB is runnable. Each
 * time it is about to wait, it holds the timer's interrupts back until the next
 * deadline: no tick before it has anything to do.
 */
void idle_main() {
    while (1) {
        hold_until_due();
        wfi_cpu();
    }
}

/** Brings g_irq_count up to the ticks the timer's clock has passed. */
void catch_up_ticks() {
    i32 now = (mem.read_word(TIMER_ADDR) >> CLOCK_SHIFT) & CLOCK_TICK_MASK;
    g_irq_count = g_irq_count + ((now - g_clock_ticks) & CLOCK_TICK_MASK);
    g_clock_ticks = now;
}

/**
 * Ends a hold, if one is set: the timer interrupts at every tick again, and
 * the ticks it held back are counted. Their time was idle's, which charge_elapsed
 * gives it, idle being what it is charged to.
 */
void release_hold() {
    if (!g_held) { return; }
    g_held = false;
    mem.write_word(TIMER_ADDR, 0);
    catch_up_ticks();
}

/**
 * Charges `spent` to what the time since the last charge belongs to: the
 * process of a user thread, the kernel for a kernel thread, idle for none.
 * @param spent Timer clock units.
 */
export void charge(i32 spent) {
    case g_charge_to of {
        Some(slot) -> ({
            case thread.owner_pid_at(slot) of {
                Some(pid) -> ({ process.charge_time(pid, spent); });
                None -> ({ g_kernel_time = g_kernel_time + spent; });
            };
        });
        None -> ({ g_idle_time = g_idle_time + spent; });
    };
}

/** Charges the time up to the clock to what it belongs to. */
export void charge_elapsed() {
    i32 now = mem.read_word(TIMER_ADDR);
    charge(now - g_clock_charged);
    g_clock_charged = now;
}

/**
 * Says what the time from the last charge on belongs to: the scheduler sets
 * it when it switches, and a kernel thread hands its time to idle while it
 * waits in WFI.
 * @param context A thread's slot, or None for idle.
 */
export void charge_to(Option<i32> context) { g_charge_to = context; }

/**
 * A kernel thread blocked itself, with interrupts off, to wait in WFI on its
 * own stack: its time ends here, and the wait is idle's.
 */
void charge_wait() {
    charge_elapsed();
    charge_to(None);
}

/**
 * Waits in WFI on the current kernel thread's own stack until it is no longer
 * blocked, then takes its time back: the wait was idle's, unless a switch away
 * and back already says otherwise.
 * @param slot The thread, which has blocked itself and called charge_wait.
 */
void wait_in_wfi(i32 slot) {
    while (thread.blocked(slot)) { wfi_cpu(); }
    bool was_enabled = irq.save_disable();
    defer irq.restore(was_enabled);
    charge_elapsed();
    charge_to(Some(slot));
}

/**
 * Called by idle before it waits: holds the timer's interrupts back until the
 * earliest deadline a sleep, a futex timeout or a notification wait has, or
 * for good when none has one. An interrupt that wakes a thread before then
 * ends the hold (resume_after_interrupt), and so does the wake tick (tick).
 */
void hold_until_due() {
    bool was_enabled = irq.save_disable();
    defer irq.restore(was_enabled);
    release_hold();
    // The thread the last switch retired is cleaned up, and its joiner woken,
    // by the next reschedule: that has to come at the next tick.
    case deferred_cleanup_slot of {
        Some(_) -> ({ return; });
        None -> _;
    };
    catch_up_ticks();
    i32 ahead = case thread.next_due() of {
        Some(due) -> due - g_irq_count;
        None -> HOLD_LONGEST;
    };
    if (ahead <= 1) { return; }
    if (ahead > HOLD_LONGEST) { ahead = HOLD_LONGEST; }
    // The clock at the wake tick; the tick wraps with the clock.
    mem.write_word(TIMER_ADDR, (g_clock_ticks + ahead) << CLOCK_SHIFT);
    g_held = true;
}

/** @return Scheduler timer-tick count used by sleep and futex deadlines. */
@safe
export i32 ticks() { return g_irq_count; }

/**
 * @return Time since the scheduler started, up to the last charge, in timer
 *         clock units (256 a tick). It wraps, so read differences.
 */
@safe
export i32 cpu_total() { return g_clock_charged - g_clock_base; }

/** @return Clock units with no thread to run, or only a kernel thread waiting in WFI. */
@safe
export i32 idle_time() { return g_idle_time; }

/** @return Clock units kernel threads ran: the OS's own work. */
@safe
export i32 kernel_time() { return g_kernel_time; }

/**
 * Exposes a stable nonzero execution-context index to the mocking runtime.
 * @return Current TCB slot plus one; zero represents the idle context.
 */
export i32 current_context() {
    return case thread.current_slot() of { Some(slot) -> slot + 1; None -> 0; };
}

/**
 * Finds the next Runnable TCB by round-robin slot order.
 * @param start First slot to inspect.
 * @param count Number of slots within the current high-water range.
 * @return Some(runnable slot), or None when every candidate is unavailable.
 */
Option<i32> find_next_runnable(i32 start, i32 count) {
    if (count <= 0) { return None; }
    i32 slot = start;
    i32 checked = 0;
    while (checked < count) {
        if (thread.runnable(slot)) { return Some(slot); }
        slot = (slot + 1) % count;
        checked++;
    }
    return None;
}

/** Switches to the kernel's page directory, for a kernel thread or idle. */
void install_kernel_space() {
    case mmu.kernel_page_directory() of {
        Some(kernel_pdbr) -> ({ mem.write_word(MMU_PDBR_ADDR, kernel_pdbr); });
        None -> _;
    };
    mem.write_word(KERNEL_SP_ADDR, 0);
}

/**
 * Advances scheduler time and chooses the context to resume after a timer IRQ.
 * More than one tick can pass between two interrupts: a hold kept them back,
 * or interrupts were off across a tick.
 * @param sp Saved interrupt-frame SP of the interrupted context.
 * @return Saved kernel SP of the next TCB, or the idle frame when none is runnable.
 */
export i32 tick(i32 sp) {
    catch_up_ticks();
    if (g_held) {
        // The wake tick: it ended the hold. Every tick interrupts again.
        g_held = false;
        mem.write_word(TIMER_ADDR, 0);
    }
    return reschedule(sp);
}

/**
 * After an interrupt other than the timer's: one that found the CPU idle with
 * the timer held, and woke a thread, switches to that thread now. Without a
 * hold the next tick, at most one period away, does it.
 * @param sp Saved interrupt-frame SP of the interrupted context.
 * @return Saved kernel SP of the context to resume.
 */
export i32 resume_after_interrupt(i32 sp) {
    if (!g_held) { return sp; }
    bool unchanged = case g_idle_epoch of { Some(epoch) -> epoch == thread.ready_epoch(); None -> false; };
    if (unchanged) { return sp; }
    return reschedule(sp);
}

/**
 * Saves the current TCB, performs safe deferred cleanup, and selects a next TCB.
 * Switch-in also installs the owner Process PDBR and per-thread user SP.
 * @param sp Saved interrupt-frame SP of the context being switched out.
 * @return Saved kernel SP that irq_resume must restore.
 */
export i32 reschedule(i32 sp) {
    if (!g_initialized) { return sp; }
    // The clock first: the deadlines below are compared with it, and the time
    // up to now is what was running's.
    release_hold();
    charge_elapsed();

    // Save the context being left before anything can wake a thread: a wake
    // writes its result into the waiter's saved frame, and when the waiter is
    // the thread leaving now (it just blocked in a syscall), that frame is the
    // one saved here.
    Option<i32> leaving = thread.current_slot();
    case leaving of {
        Some(current) -> ({ thread.switch_out(current, sp, mem.read_word(KERNEL_SP_ADDR)); });
        None -> ({ idle_sp = sp; });
    };

    // This invocation runs on a different stack from the TCB retired by the
    // preceding switch, so its stack can finally be released safely. Its
    // joiner may be the thread leaving now.
    case deferred_cleanup_slot of {
        Some(retired) -> ({
            deferred_cleanup_slot = None;
            thread.finish_deferred_cleanup(retired);
        });
        None -> _;
    };
    thread.wake_due(g_irq_count);

    i32 count = thread.high_water();
    i32 start = 0;
    case leaving of {
        Some(current) -> ({
            if (thread.exiting(current)) { deferred_cleanup_slot = Some(current); }
            if (count > 0) { start = (current + 1) % count; }
        });
        None -> ({
            // Idle, and nothing was woken or published since it found nothing
            // to run: it still has nothing. Most ticks of an idle machine end here.
            bool unchanged = case g_idle_epoch of { Some(epoch) -> epoch == thread.ready_epoch(); None -> false; };
            if (unchanged) { return sp; }
        });
    };
    Option<i32> next = find_next_runnable(start, count);
    return case next of {
        Some(slot) -> ({
            thread.set_current_slot(slot);
            case thread.owner_pid_at(slot) of {
                Some(pid) -> ({
                    Option<i32> pdbr = process.get_pdbr(pid);
                    case pdbr of {
                        Some(value) -> ({ mem.write_word(MMU_PDBR_ADDR, value); });
                        None -> ({ debug.panic("scheduler: thread owner process is missing"); });
                    };
                    mem.write_word(KERNEL_SP_ADDR, thread.saved_user_sp(slot));
                });
                None -> ({ install_kernel_space(); });
            };
            thread.make_running(slot);
            charge_to(Some(slot));
            thread.saved_kernel_sp(slot);
        });
        None -> ({
            // Idle runs in the kernel's address space. The thread that just
            // stopped may be the last of a process whose page tables the next
            // reschedule frees, and idle can now wait for a long time.
            install_kernel_space();
            thread.set_idle();
            charge_to(None);
            g_idle_epoch = Some(thread.ready_epoch());
            idle_sp;
        });
    };
}

/**
 * Blocks the current TCB until the next tick and schedules another context.
 * @param sp Saved interrupt-frame SP of the yielding TCB.
 * @return Saved kernel SP of the next context to resume.
 */
export i32 yield_until_tick(i32 sp) {
    case thread.current_slot() of {
        Some(current) -> ({ thread.sleep_until(current, g_irq_count + 1); });
        None -> _;
    };
    return reschedule(sp);
}

/** @param mask Nonzero notification bits to arm on the current TCB. */
@safe
export void arm_notification(i32 mask) {
    case thread.current_slot() of {
        Some(current) -> ({ thread.arm_notification(current, mask); });
        None -> _;
    };
}

/** @param mask Notification bits to clear from armed and pending state. */
export void disarm_notification(i32 mask) {
    case thread.current_slot() of {
        Some(current) -> ({ thread.disarm_notification(current, mask); });
        None -> _;
    };
}

/**
 * Returns immediately for pending bits or blocks the current TCB for a notification.
 * @param sp Saved syscall interrupt-frame SP.
 * @param mask Notification bits accepted by the caller.
 * @param notification_out Kernel pointer receiving immediately consumed bits.
 * @return sp for an immediate result, or the next scheduled context's SP after blocking.
 */
export i32 wait_notification(i32 sp, i32 mask, i32 *notification_out) {
    *notification_out = 0;
    if (mask == 0) { return sp; }
    i32 current = case thread.current_slot() of {
        Some(slot) -> slot;
        None -> ({ return sp; });
    };
    i32 ready = thread.take_notification(current, mask);
    if (ready) {
        *notification_out = ready;
        return sp;
    }
    // The frame gets its result before anything can wake it; the wake's
    // replaces it (syscall.DispatchOutcome.parked).
    irq_frame.set_syscall_return(sp, SyscallStatus::Ok, 0);
    thread.block_notification(current, mask);
    return reschedule(sp);
}

/**
 * Delivers notification bits to every TCB owned by a process.
 * @param pid Destination process.
 * @param mask Notification bits produced by the event source.
 */
export void notify_pid(Pid pid, i32 mask) {
    i32 i = 0;
    while (i < thread.high_water()) {
        case thread.owner_pid_at(i) of {
            Some(owner) -> ({ if (owner == pid) { thread.notify(i, mask); } });
            None -> _;
        };
        i++;
    }
}

/** @param mask Notification bits broadcast to every TCB that armed them. */
export void notify_armed(i32 mask) { thread.notify_all(mask); }

/**
 * Waits, on the current kernel thread's own stack, until one of the bits
 * arrives or the deadline passes. Bits that arrived since the thread armed
 * them (arm_notification) return at once, so a loop that arms before it looks
 * at its queues loses nothing raised while it looked.
 * @param mask Notification bits to wait for.
 * @param deadline Absolute tick at which to give up, or zero for none.
 * @return The bits that arrived, or zero when the deadline came first.
 */
@safe
export i32 await_notification(i32 mask, i32 deadline) {
    i32 current = case thread.current_slot() of {
        Some(slot) -> slot;
        None -> ({ return 0; });
    };
    {
        bool was_enabled = irq.save_disable();
        defer irq.restore(was_enabled);
        i32 ready = thread.take_notification(current, mask);
        if (ready) { return ready; }
        if (deadline != 0 && deadline <= g_irq_count) { return 0; }
        thread.block_notification_until(current, mask, deadline);
        charge_wait();
    }
    wait_in_wfi(current);
    return thread.take_wake_result(current);
}

/**
 * Ends a process from outside it: an Alive process is a Zombie when this returns.
 * Its threads are switched out, so nothing is left to wait for and their stacks
 * can go at once. A process already Exiting finishes on its own next reschedule.
 * @param pid Process to end; the caller must not be one of its threads.
 * @param status Final status recorded in the Zombie.
 */
export void terminate(Pid pid, ProcessExitStatus status) {
    bool was_enabled = irq.save_disable();
    defer irq.restore(was_enabled);
    if (!process.accepts_threads(pid)) { return; }
    thread.exit_process_threads(pid, status);
    // One of its threads may be waiting here. Its slot is about to be cleared
    // and could be reused before the next reschedule would look at it.
    case deferred_cleanup_slot of {
        Some(retired) -> ({
            bool owned = case thread.owner_pid_at(retired) of { Some(owner) -> owner == pid; None -> false; };
            if (owned) { deferred_cleanup_slot = None; }
        });
        None -> _;
    };
    thread.finish_process_exit(pid);
}

/** Kernel-side sleep used outside the syscall frame path. */
/**
 * Sleeps the current kernel context for at least the requested tick count.
 * Timer IRQ scheduling switches away while this function waits in WFI.
 * @param ticks_to_sleep Relative nonnegative scheduler tick count.
 */
@safe
export void sleep(i32 ticks_to_sleep) {
    i32 current = case thread.current_slot() of {
        Some(slot) -> slot;
        None -> ({ return; });
    };
    {
        bool was_enabled = irq.save_disable();
        defer irq.restore(was_enabled);
        thread.sleep_until(current, g_irq_count + ticks_to_sleep);
        charge_wait();
    }
    wait_in_wfi(current);
}

/**
 * Allocates a stack, builds an initial frame, and publishes a kernel TCB.
 * @param entry Non-returning kernel-thread entry function.
 * @param stack_bytes Requested kernel-stack allocation size.
 * @return Ok(global TCB slot), Err(OutOfMemory), or Err(TaskSlotFull).
 */
export Result<i32, SchedulerError> spawn_kernel_thread(fn() -> void entry, i32 stack_bytes) {
    i32 slot = case thread.find_free_slot() of {
        Some(value) -> value;
        None -> ({ return Err(SchedulerError::TaskSlotFull); });
    };
    i32 stack = case heap.alloc(stack_bytes) of {
        Ok(value) -> value;
        Err(_) -> ({ return Err(SchedulerError::OutOfMemory); });
    };
    i32 sp = irq_frame.build_kernel(entry, stack + stack_bytes);
    thread.publish_kernel(slot, sp, stack, stack_bytes);
    return Ok(slot);
}

/** Initializes the TCB table and creates the scheduler's boot and idle contexts. */
export void init() {
    thread.init();
    mem.write_word(TIMER_ADDR, 0);
    g_held = false;
    i32 clock = mem.read_word(TIMER_ADDR);
    g_clock_ticks = (clock >> CLOCK_SHIFT) & CLOCK_TICK_MASK;
    g_clock_base = clock;
    g_clock_charged = clock;
    g_charge_to = Some(0); // the boot thread, below
    g_irq_count = 0;
    g_idle_time = 0;
    g_kernel_time = 0;
    deferred_cleanup_slot = None;
    g_idle_epoch = None;

    i32 idle_bytes = 8192;
    i32 idle_stack = case heap.alloc(idle_bytes) of {
        Ok(value) -> value;
        Err(_) -> ({ debug.panic("scheduler: no memory for idle stack"); 0; });
    };
    idle_sp = irq_frame.build_kernel(idle_main, idle_stack + idle_bytes);

    thread.publish_boot(0);
    thread.set_current_slot(0);
    g_initialized = true;
}
