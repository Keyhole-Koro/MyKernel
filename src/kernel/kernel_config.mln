package kernel_config;

// ============================================================================
// MyKernel System Configuration & Limits
// ============================================================================

// --- Process & Task Limits ---
/** Maximum number of simultaneously allocated process slots; PIDs are 1-based. */
export i32 MAX_PROCS = 16;
/** Number of descriptor slots maintained per process. */
export i32 MAX_FDS   = 8;
/** Maximum number of scheduler task slots, including kernel tasks. */
export i32 MAX_TASKS = 256;

// --- Memory Layout & Limits ---
/** Hardware and allocator page size in bytes; addresses are page-aligned to this value. */
export i32 PAGE_SIZE           = 4096;
/** Total kernel heap capacity in bytes. */
export i32 HEAP_SIZE           = 0x800000;   // 8 MiB kernel heap: process frames (text, stacks, page tables) come from it
/** Per-allocation heap block header size in bytes. */
export i32 HDR_SIZE            = 8;          // Heap allocation block header size
/** Reserved physical RAM range for kernel use, in bytes. */
export i32 KERNEL_RAM_SIZE     = 0x01000000; // 16 MB reserved for kernel RAM
/** Base virtual/physical address reserved for the kernel stack region. */
export i32 KERNEL_STACK_BASE   = 0x1F000000;
/** Size of the kernel stack region in bytes. */
export i32 KERNEL_STACK_SIZE   = 0x01000000; // 16 MB kernel stack

// --- User Space Bounds ---
/** Upper boundary used by the common user-space layout to keep heap below the stack. */
export i32 USER_STACK_BASE     = 0x7FFFF000; // Heap must stay below this
/** Initial user stack pointer near the top of the user address space. */
export i32 USER_STACK_TOP      = 0x7FFFFFE0;
/** Initial virtual address for a process heap. */
export i32 USER_HEAP_BASE      = 0x41000000;

// --- Hardware & Driver Buffers ---
/** Capacity in entries of the mouse and keyboard event FIFOs. */
export i32 QUEUE_SIZE          = 64;         // Mouse & Keyboard event FIFO depth
/** Size in bytes of the memory-mapped I/O region. */
export i32 MMIO_SIZE           = 0x00002000; // 8 KB
/** Size in bytes of the video-memory aperture. */
export i32 VRAM_SIZE           = 0x01000000; // 16 MB aperture
