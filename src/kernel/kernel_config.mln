package kernel_config;

// ============================================================================
// MyKernel System Configuration & Limits
// ============================================================================

// --- Process & Thread Limits ---
/** Maximum number of simultaneously allocated process slots; PIDs are 1-based. */
export const i32 MAX_PROCS = 16;
/** Number of descriptor slots maintained per process. */
export const i32 MAX_FDS   = 8;
/** Maximum number of schedulable kernel and user TCBs. */
export const i32 MAX_THREADS = 256;
export const i32 MAX_THREADS_PER_PROC = 8;
export const i32 DEFAULT_USER_STACK_BYTES = 16384;
export const i32 DEFAULT_KERNEL_STACK_BYTES = 16384;

/** Total kernel heap capacity in bytes. */
export const i32 HEAP_SIZE           = 0x800000;   // 8 MiB kernel heap: process frames (text, stacks, page tables) come from it

