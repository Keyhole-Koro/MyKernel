package loader;

import irq from "@kernel/arch/irq.mln";
import mem from "@kernel/mm/mem.mln";
import mmu from "@kernel/mm/mmu.mln";
import heap from "@kernel/mm/heap.mln";
import { HeapBlock } from "@kernel/mm/heap.mln";
import debug from "@kernel/debug/debug.mln";
import process from "process.mln";
import thread from "thread.mln";
import { KernelStack, UserStack } from "thread.mln";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { MmuError, LoaderError } from "@contracts/process/loader.contract.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { ProcessError } from "process.mln";
import { Drop } from "@std/core/drop.mln";

// The user stack: USER_STACK_PAGES pages ending just below the top of the
// address space. A GUI app's view() and handlers build markup and copy
// text on the stack, which one page does not hold.
/** Number of pages reserved for each process's user stack. */
i32 USER_STACK_PAGES = 4;
/** Lowest virtual address of the process user stack; the user heap must remain below it. */
export const i32 USER_STACK_BASE = 0x7FFFC000; // Heap must stay below this (see syscall.sys_sbrk)
/** Initial user stack pointer, positioned below the top of the address space. */
i32 USER_STACK_TOP  = 0x7FFFFFE0;
/** Initial virtual address of the process heap. */
i32 USER_HEAP_BASE  = 0x41000000;

// MMU Page Table Entry flags:
// Bit 0: Valid, Bit 1: Writable, Bit 2: Executable, Bit 3: User
/** Valid, executable, user-accessible page mapping (read/execute text). */
i32 PTE_USER_RX     = 0x0D; // VALID | EXEC | USER (0x01 | 0x04 | 0x08)
/** Valid, writable, user-accessible page mapping (data, heap, and stack). */
i32 PTE_USER_RW     = 0x0B; // VALID | WRITABLE | USER (0x01 | 0x02 | 0x08)

/** Big-endian magic value identifying an MBIN executable header. */
i32 MBIN_MAGIC      = 0x4D42494E; // 'MBIN'

/**
 * Reads a 32-bit big-endian unsigned integer from memory.
 * @param addr Memory address to read from.
 * @return 32-bit integer decoded from big-endian bytes.
 */
i32 read_be32(i32 addr) {
    i32 b0 = mem.read_byte(addr);
    i32 b1 = mem.read_byte(addr + 1);
    i32 b2 = mem.read_byte(addr + 2);
    i32 b3 = mem.read_byte(addr + 3);
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

/**
 * Rounds an address or size up to the nearest 4 KiB page boundary.
 * @param val Address or size to align.
 * @return 4 KiB aligned value.
 */
i32 align_up_4k(i32 val) {
    i32 rem = val & 4095;
    if (rem == 0) {
        return val;
    }
    return (val - rem) + 4096;
}

/**
 * Allocates physical frames and maps them into virtual memory at vaddr_base.
 *
 * If src_ptr is non-zero, copies `size` bytes from src_ptr into the allocated frames.
 * If src_ptr is 0, the frames remain zero-filled (for BSS sections).
 * @param pd Page directory physical address.
 * @param vaddr_base Base virtual address for the mapping.
 * @param src_ptr Pointer to source data, or 0 for zeroed pages.
 * @param size Segment size in bytes.
 * @param pte_flags Page table entry permission flags (e.g. PTE_USER_RX, PTE_USER_RW).
 * @return Ok(_) on success, or Err(LoaderError) on allocation/MMU failure.
 */
Result<_, LoaderError> map_segment(i32 pd, i32 vaddr_base, i32 src_ptr, i32 size, i32 pte_flags) {
    i32 offset = 0;
    while (offset < size) {
        i32 chunk = 4096;
        if (offset + chunk > size) {
            chunk = size - offset;
        }
        // A page the copy fills completely need not be cleared first.
        Option<i32> got = None;
        if (src_ptr != 0 && chunk == 4096) { got = mmu.alloc_page_uninitialized(); }
        else { got = mmu.alloc_page(); }
        i32 frame = case got of {
            Some(f) -> f;
            None -> ({
                debug.println("loader: out of memory for frame");
                return Err(LoaderError::OutOfMemory);
            });
        };

        if (src_ptr != 0) {
            i32 b = 0;
            if (((src_ptr + offset) & 3) == 0) {
                // Word copies where the source allows: a byte loop over a
                // 60 KB image is a visible part of an app's start-up time.
                while (b + 4 <= chunk) {
                    mem.write_word(frame + b, mem.read_word(src_ptr + offset + b));
                    b = b + 4;
                }
            }
            while (b < chunk) {
                i32 byte_val = mem.read_byte(src_ptr + offset + b);
                mem.write_byte(frame + b, byte_val);
                b++;
            }
        }

        // The address-space guard owns already-mapped pages.  A frame that
        // failed before publication must be returned explicitly.
        Result<_, MmuError> mapped = mmu.map_page(pd, vaddr_base + offset, frame, pte_flags);
        case mapped of {
            Ok(_) -> _;
            Err(error) -> ({
                Result<_, MmuError> freed = mmu.free_frame(frame);
                case freed of { Ok(_) -> _; Err(_) -> ({ debug.panic("loader: allocated frame could not be freed"); }); };
                return Err(LoaderError::from(error));
            });
        };
        offset = offset + 4096;
    }
    return Ok(_);
}

/**
 * A process slot claimed while a process is being loaded. Every failed load
 * returns its slot: the slot is released when the owner goes out of scope,
 * unless keep() hands the loaded process over first.
 * @property pid Process ID of the claimed slot, or None once kept.
 */
struct ProcessSlot {
    Option<Pid> pid;
};

impl Drop for ProcessSlot {
    /** Rolls back the pid reservation unless keep() already committed ownership. */
    void (borrow Self self) drop() {
        Pid pid = case self.pid of { Some(value) -> value; None -> ({ return; }); };
        Result<_, ProcessError> release = process.free_proc(pid);
        case release of {
            Ok(_) -> _;
            Err(_) -> ({ debug.panic("loader: allocated process disappeared during cleanup"); });
        };
        self.pid = None;
    }
}

/**
 * Owns an unpublished address space during transactional process loading.
 * @property pdbr Physical page-directory base, or zero after keep()/cleanup.
 */
struct AddressSpace {
    i32 pdbr;
};

impl Drop for AddressSpace {
    /** Destroys the unpublished address space unless keep() committed ownership. */
    void (borrow Self self) drop() {
        if (self.pdbr == 0) { return; }
        Result<_, MmuError> destroyed = mmu.destroy_user_address_space(self.pdbr);
        case destroyed of {
            Ok(_) -> _;
            Err(_) -> ({ debug.panic("loader: failed to roll back address space"); });
        };
        self.pdbr = 0;
    }
}

/**
 * Transfers the page directory out of its rollback guard.
 * @return Physical page-directory base now owned by the committed Process.
 */
i32 (borrow AddressSpace self) keep() {
    i32 pdbr = self.pdbr;
    self.pdbr = 0;
    return pdbr;
}

/** Hands the loaded process over; the slot is no longer released. */
void (borrow ProcessSlot self) keep() {
    self.pid = None;
}

/**
 * Spawns a new user process from an MBIN image (header version 1 or 2) in memory.
 *
 * Anything else is refused: a headerless buffer has no segments to keep apart,
 * so it could only be mapped writable and executable at once.
 * @param parent Process that will own the new one; None for the OS itself.
 * @param code_ptr Memory pointer to the MBIN image.
 * @param code_size Image size in bytes.
 * @return Ok(pid) with allocated process ID on success, or Err(LoaderError) on failure;
 *         InvalidHeader(0) when the buffer has no MBIN header.
 */
export Result<Pid, LoaderError> spawn_from_buffer(Option<Pid> parent, i32 code_ptr, i32 code_size) {
    Result<Pid, ProcessError> proc_res = process.reserve_process(parent);
    Pid pid = case proc_res of {
        Ok(p) -> p;
        Err(ProcessError::NoFreeSlot) -> ({
            debug.println("loader: failed to allocate process slot");
            return Err(LoaderError::ProcSlotFull);
        });
        Err(ProcessError::InvalidPid(p)) -> ({
            debug.println("loader: invalid pid allocated");
            return Err(LoaderError::ProcSlotFull);
        });
    };
    ProcessSlot slot = ProcessSlot { pid: Some(pid) };

    // 1. Create Page Directory and map kernel regions identity
    i32 pd = case mmu.create_page_directory() of {
        Some(d) -> d;
        None -> ({
            debug.println("loader: failed to allocate page directory");
            return Err(LoaderError::OutOfMemory);
        });
    };
    AddressSpace address_space = AddressSpace { pdbr: pd };
    mmu.setup_identity_kernel_mapping(pd)?;

    // 2. Read the MBIN header.
    if (code_size < 32 || read_be32(code_ptr) != MBIN_MAGIC) {
        debug.println("loader: not an MBIN executable");
        return Err(LoaderError::InvalidHeader(0));
    }
    i32 version     = read_be32(code_ptr + 4);
    i32 entry_point = read_be32(code_ptr + 8);
    i32 text_offset = read_be32(code_ptr + 12);
    i32 text_size   = read_be32(code_ptr + 16);
    i32 data_offset = read_be32(code_ptr + 20);
    i32 data_size   = read_be32(code_ptr + 24);
    i32 bss_size    = read_be32(code_ptr + 28);

    // Header version 2 adds a section directory offset after bss_size;
    // the segments are laid out the same, so both load alike.
    if (version != 1 && version != 2) {
        debug.println("loader: unsupported MBIN version");
        return Err(LoaderError::InvalidHeader(version));
    }
    if (text_offset + text_size > code_size) {
        debug.println("loader: invalid text section bounds");
        return Err(LoaderError::InvalidBounds(code_size));
    }
    if (data_offset + data_size > code_size) {
        debug.println("loader: invalid data section bounds");
        return Err(LoaderError::InvalidBounds(code_size));
    }

    debug.printf("loader: loading MBIN v%d (entry=0x%x, text_sz=%d, data_sz=%d, bss_sz=%d)\n",
                 version, entry_point, text_size, data_size, bss_size);
    // The text segment is mapped at the address it was linked at (the page
    // holding its entry point). MyLang loads symbol addresses with a 21-bit
    // immediate, so compiled programs must be linked below 2 MB
    // (qa/runners/build_user_apps.py uses 0x20000, unused RAM below the
    // kernel image). Their pages replace the kernel identity mapping of that
    // range in the process's own page directory only, so isolation is
    // unchanged.
    i32 code_base = entry_point & 0xFFFFF000;

    // Map Text segment as RX (Read + Execute, No Write). Globals live
    // in the data segment (the compiler's `.data`), so text is code only.
    map_segment(pd, code_base, code_ptr + text_offset, text_size, PTE_USER_RX)?;

    // Map Data segment as RW (Read + Write, No Execute)
    i32 data_vaddr = code_base + align_up_4k(text_size);
    if (data_size > 0) {
        map_segment(pd, data_vaddr, code_ptr + data_offset, data_size, PTE_USER_RW)?;
    }

    // Map BSS segment as RW (Read + Write, No Execute)
    if (bss_size > 0) {
        i32 bss_vaddr = data_vaddr + align_up_4k(data_size);
        map_segment(pd, bss_vaddr, 0, bss_size, PTE_USER_RW)?;
    }

    // Calculate heap break after loaded segments
    i32 initial_brk = USER_HEAP_BASE;
    i32 seg_end = data_vaddr + align_up_4k(data_size + bss_size);
    if (seg_end > initial_brk) {
        initial_brk = seg_end;
    }

    // 3. Allocate the user stack pages (RW, No Execute), zero-filled
    map_segment(pd, USER_STACK_BASE, 0, USER_STACK_PAGES * 4096, PTE_USER_RW)?;

    // 4. Allocate kernel stack. Syscalls run on it: the OS_CALL handler
    // reaches the filesystem (SSD I/O) and the UI channels from there, so
    // it is sized for a real call chain of MyLang frames, not a bare
    // dispatcher -- an overflow here silently corrupts whatever heap block
    // sits below it.
    i32 KSTACK_BYTES = 16384;
    i32 kstack = case heap.alloc(KSTACK_BYTES) of {
        Ok(p) -> p;
        Err(_) -> ({
            debug.println("loader: out of memory for kernel stack");
            return Err(LoaderError::OutOfMemory);
        });
    };
    // Freed if a later step fails; the process keeps it once it is ready.
    HeapBlock kstack_block = HeapBlock { addr: kstack };
    i32 kstack_top = kstack + KSTACK_BYTES;
    // 5. Build the main thread's initial interrupt frame for iret.
    i32 sp = kstack_top;
    sp = sp - 4; mem.write_word(sp, entry_point);     // PC
    sp = sp - 4; mem.write_word(sp, 0x21);            // SR (SR_USER=0x20 | SR_IE=0x01)
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry PC slot
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry SR slot
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry lr slot
    sp = sp - 4; mem.write_word(sp, 0);               // IRQ entry bp slot
    sp = sp - 4; mem.write_word(sp, 0);               // lr
    sp = sp - 4; mem.write_word(sp, 0);               // bp
    sp = sp - 4; mem.write_word(sp, 0);               // r0
    sp = sp - 4; mem.write_word(sp, 0);               // r1
    sp = sp - 4; mem.write_word(sp, 0);               // r2
    sp = sp - 4; mem.write_word(sp, 0);               // r3
    sp = sp - 4; mem.write_word(sp, 0);               // r4
    sp = sp - 4; mem.write_word(sp, 0);               // r5
    sp = sp - 4; mem.write_word(sp, 0);               // r6
    sp = sp - 4; mem.write_word(sp, 0);               // r7

    // 6. Publish the fully constructed TCB, then atomically make its Process
    // Alive. Before publication all resources above are rollback guards.
    i32 thread_slot = case thread.find_free_slot() of {
        Some(value) -> value;
        None -> ({
            debug.println("loader: thread table is full");
            return Err(LoaderError::SpawnTaskFailed);
        });
    };
    KernelStack kernel_stack = KernelStack { base: kstack, bytes: KSTACK_BYTES, owned: true };
    UserStack user_stack = UserStack {
        slot: 0,
        mapped_base: USER_STACK_BASE,
        mapped_bytes: USER_STACK_PAGES * 4096,
    };
    // The scheduler may pick this thread the moment it is published, and it
    // installs the owner's PDBR: no tick may land before commit_process has
    // set it, or the CPU runs on a zero page directory.
    bool irq_state = irq.save_disable();
    thread.publish_user(thread_slot, pid, sp, USER_STACK_TOP, kernel_stack, user_stack);

    Result<_, ProcessError> retained = process.retain_thread(pid);
    case retained of {
        Ok(_) -> _;
        Err(_) -> ({ debug.panic("loader: process disappeared while publishing main thread"); });
    };
    Result<Option<i32>, ProcessError> reserved_stack = process.reserve_user_stack_slot(pid);
    case reserved_stack of {
        Ok(Some(stack_slot)) -> ({
            if (stack_slot != 0) { debug.panic("loader: main thread did not receive stack slot zero"); }
        });
        Ok(None) -> ({ debug.panic("loader: new process has no user stack slot"); });
        Err(_) -> ({ debug.panic("loader: process disappeared while reserving main stack"); });
    };
    Result<_, ProcessError> committed = process.commit_process(pid, pd, initial_brk);
    case committed of {
        Ok(_) -> _;
        Err(_) -> ({ debug.panic("loader: allocated process disappeared while committing"); });
    };
    irq.restore(irq_state);
    kstack_block.keep();
    address_space.keep();
    slot.keep();
    return Ok(pid);
}
