package debug;

import { debug_putc } from "debug_putc.masm";

char hex_digit(i32 nibble) {
    char *digits = "0123456789abcdef";
    return digits[nibble & 15];
}

export void print(ref char s) {
    if (s) {
        while (*s) {
            debug_putc(*s);
            s = s + 1;
        }
    }
}

export void println(ref char s) {
    print(s);
    debug_putc('\n');
}

export void hex(i32 value) {
    i32 shift = 28;
    i32 started = 0;

    while (shift >= 0) {
        i32 nibble = (value >> shift) & 15;
        if (nibble != 0 || started || shift == 0) {
            debug_putc(hex_digit(nibble));
            started = 1;
        }
        shift = shift - 4;
    }
}

export void printf(ref char fmt, rest args) {
    i32 arg_index = 0;

    while (*fmt) {
        if (*fmt != '%') {
            debug_putc(*fmt);
            fmt = fmt + 1;
            continue;
        }

        fmt = fmt + 1;
        if (!*fmt) {
            debug_putc('%');
            break;
        }

        if (*fmt == '%') {
            debug_putc('%');
        } else if (*fmt == 's') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            ref char s = args[arg_index];
            arg_index = arg_index + 1;
            if (s) {
                print(s);
            } else {
                print("(null)");
            }
        } else if (*fmt == 'i') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index = arg_index + 1;

            // Handle negative numbers
            if (value < 0) {
                debug_putc('-');
                value = -value;
            }

            // Convert integer to string in reverse order
            char buffer[12]; // Enough for 32-bit int and sign
            i32 pos = 0;
            do {
                buffer[pos] = (char)('0' + (value % 10));
                value = value / 10;
                pos = pos + 1;
            } while (value > 0);

            // Print the number in correct order
            for (i32 i = pos - 1; i >= 0; i = i - 1) {
                debug_putc(buffer[i]);
            }
        } else if (*fmt == 'c') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 ch = args[arg_index];
            arg_index = arg_index + 1;
            debug_putc(ch);
        } else if (*fmt == 'x') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index = arg_index + 1;
            hex(value);
        } else {
            debug_putc('%');
            debug_putc(*fmt);
        }

        fmt = fmt + 1;
    }
}
