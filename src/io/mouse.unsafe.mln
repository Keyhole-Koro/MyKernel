package mouse;

import mem from "@kernel/mm/mem.mln";

// Memory-mapped mouse registers (must match constants.rs in the emulator).
// The emulator samples the host pointer every ~2 ms; every change raises an
// IRQ and is latched into the hardware event FIFO below. The live registers
// always hold the current state.
i32 MOUSE_X_ADDR = 0x24000040;
i32 MOUSE_Y_ADDR = 0x24000044;
i32 MOUSE_BUTTONS_ADDR = 0x24000048;

// Hardware event FIFO registers. EVT_STATUS is the queued-event count,
// EVT_X/Y/BTN read the head event, writing EVT_POP consumes it.
i32 MOUSE_EVT_STATUS_ADDR = 0x2400004C;
i32 MOUSE_EVT_X_ADDR      = 0x24000050;
i32 MOUSE_EVT_Y_ADDR      = 0x24000054;
i32 MOUSE_EVT_BTN_ADDR    = 0x24000058;
i32 MOUSE_EVT_POP_ADDR    = 0x2400005C;
i32 MOUSE_EVT_WHEEL_ADDR  = 0x240000B4; // signed wheel steps on the head event

/**
 * Reads the current mouse cursor X coordinate from hardware register.
 * @return Current X coordinate in pixels.
 */
@safe
export i32 x() {
    return mem.read_word(MOUSE_X_ADDR);
}

/**
 * Reads the current mouse cursor Y coordinate from hardware register.
 * @return Current Y coordinate in pixels.
 */
@safe
export i32 y() {
    return mem.read_word(MOUSE_Y_ADDR);
}

// --- software event queue ---
// The mouse IRQ handler drains the hardware FIFO into this ring buffer; the
// UI task consumes it. Because every transition (press, release, motion) is
// its own event, a click shorter than a display frame still arrives as a
// press event followed by a release event instead of vanishing.
i32 QUEUE_SIZE = 64;
struct MouseEvent {
    i32 x;
    i32 y;
    i32 btn;
    i32 wheel;
};
MouseEvent queue[64];
i32 q_head = 0;
i32 q_tail = 0;

/**
 * Drains all pending hardware mouse events into the software event ring buffer.
 *
 * Called by the mouse IRQ handler. Drops incoming events if the queue is full.
 */
export void drain_hw() {
    while (mem.read_word(MOUSE_EVT_STATUS_ADDR)) {
        i32 nx = mem.read_word(MOUSE_EVT_X_ADDR);
        i32 ny = mem.read_word(MOUSE_EVT_Y_ADDR);
        i32 nb = mem.read_word(MOUSE_EVT_BTN_ADDR);
        i32 nw = mem.read_word(MOUSE_EVT_WHEEL_ADDR);
        mem.write_word(MOUSE_EVT_POP_ADDR, 1);

        i32 next = (q_tail + 1) % QUEUE_SIZE;
        if (next != q_head) { // drop if full
            queue[q_tail] = MouseEvent { x: nx, y: ny, btn: nb, wheel: nw };
            q_tail = next;
        }
    }
}

/**
 * Checks whether the mouse event queue contains unread events.
 * @return True if at least one event is pending, false otherwise.
 */
@safe
export bool has_event() {
    if (q_head == q_tail) { return false; }
    return true;
}

/**
 * Returns the X coordinate of the current head event.
 * @return Event X coordinate in pixels.
 */
@safe
export i32 event_x() { return queue[q_head].x; }

/**
 * Returns the Y coordinate of the current head event.
 * @return Event Y coordinate in pixels.
 */
@safe
export i32 event_y() { return queue[q_head].y; }

/**
 * Returns the button bitmask of the current head event.
 * @return Event button bitmask.
 */
@safe
export i32 event_btn() { return queue[q_head].btn; }

/**
 * Returns the signed wheel scroll steps of the current head event.
 *
 * Positive values indicate scrolling up, negative scrolling down, 0 none.
 * @return Wheel scroll delta.
 */
@safe
export i32 event_wheel() { return queue[q_head].wheel; }

/**
 * Consumes and pops the head event from the queue.
 */
@safe
export void pop_event() {
    if (q_head != q_tail) {
        q_head = (q_head + 1) % QUEUE_SIZE;
    }
}

