package keyboard;

import mem from "../mm/mem.mln";

// Memory-mapped keyboard registers (must match constants.rs in the emulator).
// The host window's key presses, releases and translated characters arrive
// in one hardware FIFO in the order they happened; every arrival raises the
// keyboard IRQ. EVT_STATUS is the queued-event count, EVT_TYPE/CODE/MODS read
// the head event, writing EVT_POP consumes it.
i32 KBD_EVT_STATUS_ADDR = 0x240000A0;
i32 KBD_EVT_TYPE_ADDR   = 0x240000A4;
i32 KBD_EVT_CODE_ADDR   = 0x240000A8;
i32 KBD_EVT_MODS_ADDR   = 0x240000AC;
i32 KBD_EVT_POP_ADDR    = 0x240000B0;

// Event types. A shifted keystroke arrives as DOWN 'a', CHAR 'A', UP 'a':
// text fields consume CHAR events (already shifted by the host), shortcut
// handling looks at DOWN events and the modifier bits.
export i32 EVT_DOWN = 1;
export i32 EVT_UP   = 2;
export i32 EVT_CHAR = 3;

export i32 MOD_SHIFT = 1;
export i32 MOD_CTRL  = 2;
export i32 MOD_ALT   = 4;

// Key codes carried by DOWN/UP events. Printable keys use their lowercase
// ASCII; everything else is >= 0x100. Exported as functions because another
// package cannot read this package's globals, only call it.
/** Key code for Backspace (8). */
export i32 KEY_BACKSPACE() { return 8; }
/** Key code for Tab (9). */
export i32 KEY_TAB()       { return 9; }
/** Key code for Enter (13). */
export i32 KEY_ENTER()     { return 13; }
/** Key code for Escape (27). */
export i32 KEY_ESCAPE()    { return 27; }
/** Key code for Space (32). */
export i32 KEY_SPACE()     { return 32; }
/** Key code for Delete (127). */
export i32 KEY_DELETE()    { return 127; }
/** Key code for Left Arrow (0x101). */
export i32 KEY_LEFT()      { return 0x101; }
/** Key code for Right Arrow (0x102). */
export i32 KEY_RIGHT()     { return 0x102; }
/** Key code for Up Arrow (0x103). */
export i32 KEY_UP()        { return 0x103; }
/** Key code for Down Arrow (0x104). */
export i32 KEY_DOWN()      { return 0x104; }
/** Key code for Home (0x105). */
export i32 KEY_HOME()      { return 0x105; }
/** Key code for End (0x106). */
export i32 KEY_END()       { return 0x106; }
/** Key code for Page Up (0x107). */
export i32 KEY_PAGE_UP()   { return 0x107; }
/** Key code for Page Down (0x108). */
export i32 KEY_PAGE_DOWN() { return 0x108; }
/** Key code for Shift (0x110). */
export i32 KEY_SHIFT()     { return 0x110; }
/** Key code for Ctrl (0x111). */
export i32 KEY_CTRL()      { return 0x111; }
/** Key code for Alt (0x112). */
export i32 KEY_ALT()       { return 0x112; }
/** Key code for F1 (0x121). */
export i32 KEY_F1()        { return 0x121; }

// --- software event queue ---
// The keyboard IRQ handler drains the hardware FIFO into this ring buffer;
// the UI task consumes it. Same shape as mouse.mln's queue.
i32 QUEUE_SIZE = 64;
i32 q_type[64];
i32 q_code[64];
i32 q_mods[64];
i32 q_head = 0;
i32 q_tail = 0;

/**
 * Drains all pending hardware events into the software event ring buffer.
 *
 * Called by the keyboard IRQ handler. Drops events if the ring buffer is full.
 */
export void drain_hw() {
    while (mem.read_word(KBD_EVT_STATUS_ADDR)) {
        i32 t = mem.read_word(KBD_EVT_TYPE_ADDR);
        i32 c = mem.read_word(KBD_EVT_CODE_ADDR);
        i32 m = mem.read_word(KBD_EVT_MODS_ADDR);
        mem.write_word(KBD_EVT_POP_ADDR, 1);

        i32 next = (q_tail + 1) % QUEUE_SIZE;
        if (next != q_head) { // drop if full
            q_type[q_tail] = t;
            q_code[q_tail] = c;
            q_mods[q_tail] = m;
            q_tail = next;
        }
    }
}

/**
 * Checks whether the keyboard event queue contains unread events.
 * @return True if at least one event is pending, false otherwise.
 */
export bool has_event() {
    if (q_head == q_tail) { return false; }
    return true;
}

/**
 * Returns the event type of the current head event.
 * @return Event type (EVT_DOWN, EVT_UP, or EVT_CHAR).
 */
export i32 event_type() { return q_type[q_head]; }

/**
 * Returns the key code or character code of the current head event.
 * @return Key code or ASCII value.
 */
export i32 event_code() { return q_code[q_head]; }

/**
 * Returns the modifier bitmask of the current head event.
 * @return Modifier flags bitwise OR'd (MOD_SHIFT, MOD_CTRL, MOD_ALT).
 */
export i32 event_mods() { return q_mods[q_head]; }

/**
 * Consumes and pops the head event from the queue.
 */
export void pop_event() {
    if (q_head != q_tail) {
        q_head = (q_head + 1) % QUEUE_SIZE;
    }
}

/**
 * Injects a synthetic keyboard event into the queue.
 *
 * Used for testing and automation to simulate keystrokes.
 * @param type Event type (e.g. EVT_DOWN, EVT_CHAR, EVT_UP).
 * @param code Key code or ASCII code.
 * @param mods Active modifier key mask.
 */
export void inject(i32 type, i32 code, i32 mods) {
    i32 next = (q_tail + 1) % QUEUE_SIZE;
    if (next != q_head) {
        q_type[q_tail] = type;
        q_code[q_tail] = code;
        q_mods[q_tail] = mods;
        q_tail = next;
    }
}
