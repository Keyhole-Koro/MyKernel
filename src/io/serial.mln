package serial;

import mem from "../mm/mem.mln";
import { RingBuffer } from "../../../../toolchain/MyStdLib/collections/ringbuf.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";

// Memory-mapped UART registers (must match constants.rs in the emulator).
i32 SERIAL_TX_ADDR = 0x24000000;
i32 SERIAL_RX_ADDR = 0x24000004;
i32 SERIAL_LSR_ADDR = 0x24000005;
i32 SERIAL_LSR_DR = 0x01;

/**
 * Transmits a single byte over the serial UART.
 * @param c Byte value to transmit.
 */
export void putc(i32 c) {
    mem.write_word(SERIAL_TX_ADDR, c);
}

/**
 * Checks whether a byte is waiting in the hardware UART RX register.
 * @return Non-zero if RX data is ready, 0 otherwise.
 */
export i32 rx_ready() {
    return mem.read_word(SERIAL_LSR_ADDR) & SERIAL_LSR_DR;
}

/**
 * Consumes and returns the next received byte directly from the hardware RX register.
 *
 * Should only be called when rx_ready() returns non-zero.
 * @return Received byte value in range 0-255.
 */
export i32 read_rx() {
    return mem.read_word(SERIAL_RX_ADDR) & 0xFF;
}

// --- input queue ---
// The serial IRQ handler drains hardware RX into this ring buffer; tasks read
// keystrokes from here. This resolves the contention where both the IRQ handler
// and the shell read hardware RX and one stole the other's bytes.
//
// The queue is a RingBuffer<i32> over a 128-word backing array, so it holds
// 127 pending keystrokes (one slot stays empty to distinguish full from
// empty). It drops on overflow rather than overwriting, which keeps the
// oldest keystroke -- the same behaviour this queue had when it was
// open-coded.
i32 in_storage[128];
RingBuffer<i32> in_q;
i32 in_ready = 0;

/**
 * Initializes the input ring buffer on first use if not already initialized.
 */
void ensure_queue() {
    if (in_ready == 0) {
        in_q.init(&in_storage[0], 128);
        in_ready = 1;
    }
}

/**
 * Pushes a received byte into the software input queue.
 *
 * Called by the serial IRQ handler for each incoming byte.
 * @param c Received byte to push.
 */
export void input_push(i32 c) {
    ensure_queue();
    in_q.push(c & 0xFF);
}

/**
 * Checks whether any keystrokes are waiting in the software input queue.
 * @return True if input is available, false otherwise.
 */
export bool has_input() {
    ensure_queue();
    return in_q.has();
}

/**
 * Consumes and returns the next keystroke from the input queue, if available.
 * @return Some(byte) if a keystroke was queued, or None if empty.
 */
export Option<i32> read_input() {
    ensure_queue();
    i32 value = 0;
    if (!in_q.pop(&value)) {
        return None;
    }
    return Some(value);
}
