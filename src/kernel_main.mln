import { kprintln, kprintf } from "libs/print.mln";

i32 kernel_main() {
    i32 boot_stage = 1000;
    char boot_msg[] = "kernel: boot";
    char stage_fmt[] = "kernel: stage = %i\n";
    char done_msg[] = "kernel: init complete";

    kprintln(&boot_msg[0]);
    kprintf(&stage_fmt[0], boot_stage);
    kprintln(&done_msg[0]);

    return 0;
}
