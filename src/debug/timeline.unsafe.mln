namespace timeline;

import mem from "@kernel/mm/mem.mln";

// Marks on the emulator's frame timeline (runtime/MyEmulator
// src/machine/timeline.rs): a stage of work begins, ends, or something
// happens at an instant. Each mark is two register writes, the name's length
// and then its address. The emulator reads the name at once, so it may be any
// str, and ignores both writes while it is not recording. Kernel code only:
// the registers are device memory, which a user process cannot reach.
i32 TIMELINE_LENGTH_ADDR = 0x240001C0;
i32 TIMELINE_BEGIN_ADDR  = 0x240001C4;
i32 TIMELINE_END_ADDR    = 0x240001C8;
i32 TIMELINE_MARK_ADDR   = 0x240001CC;

/**
 * Opens a span on the guest's track; end() with the same name closes it.
 * @param name What the span is: "paint", a window's title.
 */
@safe
export void begin(str name) {
    mem.write_word(TIMELINE_LENGTH_ADDR, name.length);
    mem.write_word(TIMELINE_BEGIN_ADDR, (i32)name.data);
}

/**
 * Closes the span begin() opened last.
 * @param name The name it was opened with.
 */
@safe
export void end(str name) {
    mem.write_word(TIMELINE_LENGTH_ADDR, name.length);
    mem.write_word(TIMELINE_END_ADDR, (i32)name.data);
}

/**
 * Marks an instant on the guest's track.
 * @param name What happened.
 */
@safe
export void mark(str name) {
    mem.write_word(TIMELINE_LENGTH_ADDR, name.length);
    mem.write_word(TIMELINE_MARK_ADDR, (i32)name.data);
}
