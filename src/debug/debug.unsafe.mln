package debug;

import serial from "@kernel/io/serial.mln";
import { halt_cpu } from "@kernel/arch/halt.masm";
import str from "@std/text/str.mln";
import { Text } from "@std/text/text.mln";

/**
 * Converts a 4-bit nibble into its lowercase hexadecimal ASCII character.
 * @param nibble 4-bit value (0-15).
 * @return Hexadecimal character ('0'-'9', 'a'-'f').
 */
char hex_digit(i32 nibble) {
    char *digits = "0123456789abcdef";
    return digits[nibble & 15];
}

/**
 * Outputs a string to the serial console.
 * @param s Bytes to print.
 */
@safe
export void print(str s) {
    i32 i = 0;
    while (i < s.length) {
        serial.putc(s.data[i]);
        i++;
    }
}

/**
 * Outputs a string followed by a newline to the serial console.
 * @param s Bytes to print.
 */
@safe
export void println(str s) {
    print(s);
    serial.putc('\n');
}

/**
 * The same as print(), for callers that still use this name.
 * @param s Bytes to print.
 */
@safe
export void print_str(str s) { print(s); }

/**
 * The same as println(), for callers that still use this name.
 * @param s Bytes to print.
 */
@safe
export void println_str(str s) { println(s); }

/**
 * Outputs a signed decimal integer to the serial console.
 * @param value Integer to print.
 */
@safe
export void print_i32(i32 value) { printf("%i", value); }

/**
 * Reports an unrecoverable kernel invariant failure and halts the CPU.
 * @param msg Error message describing the panic reason.
 */
@safe
export void panic(str msg) {
    print("panic: ");
    println(msg);
    halt_cpu();
}

/**
 * Prints a 32-bit integer as hexadecimal to the serial console.
 * @param value Integer value to display in hex.
 */
export void hex(i32 value) {
    i32 shift = 28;
    bool started = false;

    while (shift >= 0) {
        i32 nibble = (value >> shift) & 15;
        if (nibble != 0 || started || shift == 0) {
            serial.putc(hex_digit(nibble));
            started = true;
        }
        shift = shift - 4;
    }
}

/**
 * Formatted print to the serial console.
 *
 * Supports format specifiers: %i / %d (decimal int), %c (char), %x (hex), %% (percent).
 * @param fmt Format string.
 * @param args Variable arguments matching format specifiers.
 */
export void printf(str fmt, rest args) {
    i32 arg_index = 0;
    i32 at = 0;

    while (at < fmt.length) {
        i32 c = fmt.byte(at);
        if (c != '%') {
            serial.putc(c);
            at++;
            continue;
        }

        at++;
        if (at >= fmt.length) {
            serial.putc('%');
            break;
        }

        c = fmt.byte(at);
        if (c == '%') {
            serial.putc('%');
        } else if (c == 'i' || c == 'd') {
            // %d is accepted as an alias for %i (signed decimal integer).
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index++;
            print(value.to_string().as_str());
        } else if (c == 'c') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 ch = args[arg_index];
            arg_index++;
            serial.putc(ch);
        } else if (c == 'x') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index++;
            hex(value);
        } else {
            serial.putc('%');
            serial.putc(c);
        }

        at++;
    }
}
