package debug;

import serial from "../io/serial.mln";
import { halt_cpu } from "../arch/halt.masm";

/**
 * Converts a 4-bit nibble into its lowercase hexadecimal ASCII character.
 * @param nibble 4-bit value (0-15).
 * @return Hexadecimal character ('0'-'9', 'a'-'f').
 */
char hex_digit(i32 nibble) {
    char *digits = "0123456789abcdef";
    return digits[nibble & 15];
}

/**
 * Outputs a null-terminated string to the serial console.
 * @param s Pointer to null-terminated string to print.
 */
export void print(char* s) {
    if (s) {
        while (*s) {
            serial.putc(*s);
            s++;
        }
    }
}

/**
 * Outputs a null-terminated string followed by a newline to the serial console.
 * @param s Pointer to null-terminated string to print.
 */
export void println(char* s) {
    print(s);
    serial.putc('\n');
}

/**
 * Reports an unrecoverable kernel invariant failure and halts the CPU.
 * @param msg Error message describing the panic reason.
 */
export void panic(char* msg) {
    print("panic: ");
    println(msg);
    halt_cpu();
}

/**
 * Prints a 32-bit integer as hexadecimal to the serial console.
 * @param value Integer value to display in hex.
 */
export void hex(i32 value) {
    i32 shift = 28;
    i32 started = 0;

    while (shift >= 0) {
        i32 nibble = (value >> shift) & 15;
        if (nibble != 0 || started || shift == 0) {
            serial.putc(hex_digit(nibble));
            started = 1;
        }
        shift = shift - 4;
    }
}

/**
 * Formatted print to the serial console.
 *
 * Supports format specifiers: %s (string), %i / %d (decimal int), %c (char), %x (hex), %% (percent).
 * @param fmt Format string.
 * @param args Variable arguments matching format specifiers.
 */
export void printf(char* fmt, rest args) {
    i32 arg_index = 0;

    while (*fmt) {
        if (*fmt != '%') {
            serial.putc(*fmt);
            fmt++;
            continue;
        }

        fmt++;
        if (!*fmt) {
            serial.putc('%');
            break;
        }

        if (*fmt == '%') {
            serial.putc('%');
        } else if (*fmt == 's') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            char* s = args[arg_index];
            arg_index++;
            if (s) {
                print(s);
            } else {
                print("(null)");
            }
        } else if (*fmt == 'i' || *fmt == 'd') {
            // %d is accepted as an alias for %i (signed decimal integer).
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index++;

            // Handle negative numbers
            if (value < 0) {
                serial.putc('-');
                value = -value;
            }

            // Convert integer to string in reverse order
            char buffer[12]; // Enough for 32-bit int and sign
            i32 pos = 0;
            do {
                buffer[pos] = (char)('0' + (value % 10));
                value = value / 10;
                pos++;
            } while (value > 0);

            // Print the number in correct order
            for (i32 i = pos - 1; i >= 0; i--) {
                serial.putc(buffer[i]);
            }
        } else if (*fmt == 'c') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 ch = args[arg_index];
            arg_index++;
            serial.putc(ch);
        } else if (*fmt == 'x') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index++;
            hex(value);
        } else {
            serial.putc('%');
            serial.putc(*fmt);
        }

        fmt++;
    }
}
