package debug;

import serial from "../io/serial.mln";

char hex_digit(i32 nibble) {
    char *digits = "0123456789abcdef";
    return digits[nibble & 15];
}

export void print(char* s) {
    if (s) {
        while (*s) {
            serial.putc(*s);
            s = s + 1;
        }
    }
}

export void println(char* s) {
    print(s);
    serial.putc('\n');
}

export void hex(i32 value) {
    i32 shift = 28;
    i32 started = 0;

    while (shift >= 0) {
        i32 nibble = (value >> shift) & 15;
        if (nibble != 0 || started || shift == 0) {
            serial.putc(hex_digit(nibble));
            started = 1;
        }
        shift = shift - 4;
    }
}

export void printf(char* fmt, rest args) {
    i32 arg_index = 0;

    while (*fmt) {
        if (*fmt != '%') {
            serial.putc(*fmt);
            fmt = fmt + 1;
            continue;
        }

        fmt = fmt + 1;
        if (!*fmt) {
            serial.putc('%');
            break;
        }

        if (*fmt == '%') {
            serial.putc('%');
        } else if (*fmt == 's') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            char* s = args[arg_index];
            arg_index = arg_index + 1;
            if (s) {
                print(s);
            } else {
                print("(null)");
            }
        } else if (*fmt == 'i' || *fmt == 'd') {
            // %d is accepted as an alias for %i (signed decimal integer).
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index = arg_index + 1;

            // Handle negative numbers
            if (value < 0) {
                serial.putc('-');
                value = -value;
            }

            // Convert integer to string in reverse order
            char buffer[12]; // Enough for 32-bit int and sign
            i32 pos = 0;
            do {
                buffer[pos] = (char)('0' + (value % 10));
                value = value / 10;
                pos = pos + 1;
            } while (value > 0);

            // Print the number in correct order
            for (i32 i = pos - 1; i >= 0; i = i - 1) {
                serial.putc(buffer[i]);
            }
        } else if (*fmt == 'c') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 ch = args[arg_index];
            arg_index = arg_index + 1;
            serial.putc(ch);
        } else if (*fmt == 'x') {
            if (arg_index >= args.len) {
                print("%<missing>");
                break;
            }
            i32 value = args[arg_index];
            arg_index = arg_index + 1;
            hex(value);
        } else {
            serial.putc('%');
            serial.putc(*fmt);
        }

        fmt = fmt + 1;
    }
}
