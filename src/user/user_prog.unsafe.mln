package user_prog;

import { sys_write, sys_exit, sys_yield } from "syscall_user.masm";

/**
 * Sample user-space entry point demonstrating syscall write, yield, and exit.
 */
export void user_main() {
    i32 written = 0;
    sys_write(1, "Hello from User Space Process!\n", 31, &written);
    sys_yield();
    sys_write(1, "User Space Process Resumed!\n", 28, &written);
    sys_exit(42);
}

