package heap;

import { heap_image_end } from "heap_sym.masm";
import debug from "../debug/debug.mln";

// First-fit allocator over the region between the loaded image (`_end`, from
// heap_image_end()) and _end + HEAP_SIZE, with an address-ordered free list and
// coalescing of physically-adjacent free blocks.
//
// Every block is laid out as an 8-byte header followed by its payload:
//   word[h + 0] = size   (payload bytes, not counting the header)
//   word[h + 4] = next   (address of the next FREE block header, 0 = none)
// The free list is kept sorted by address so free() can merge neighbours.
// A block's physical end is  h + HDR_SIZE + size.

import kernel_config from "../kernel/kernel_config.mln";

i32 HDR_SIZE = 8;
i32 ALIGN = 4;

i32 g_free_head = 0;

/**
 * Reads a 32-bit word from a physical/virtual memory address.
 * @param addr Memory address to read.
 * @return 32-bit word value.
 */
i32 read_word(i32 addr) {
    i32 *p = (i32 *)addr;
    return *p;
}

/**
 * Writes a 32-bit word to a physical/virtual memory address.
 * @param addr Memory address to write.
 * @param value 32-bit word value to store.
 */
void write_word(i32 addr, i32 value) {
    i32 *p = (i32 *)addr;
    *p = value;
}

/**
 * Rounds an integer up to the 4-byte heap alignment boundary.
 * @param n Size in bytes to align.
 * @return 4-byte aligned size.
 */
i32 align_up(i32 n) {
    return (n + (ALIGN - 1)) & ~(ALIGN - 1);
}

/** Reads the payload size in bytes from a block header. */
i32 block_size(i32 h) { return read_word(h + 0); }
/** Reads the next free block address from a block header. */
i32 block_next(i32 h) { return read_word(h + 4); }
/** Sets the payload size in bytes in a block header. */
void set_size(i32 h, i32 v) { write_word(h + 0, v); }
/** Sets the next free block pointer in a block header. */
void set_next(i32 h, i32 v) { write_word(h + 4, v); }

/**
 * Calculates the physical address just past the end of block h.
 * @param h Address of block header.
 * @return One byte past the block payload.
 */
i32 block_end(i32 h) {
    return h + HDR_SIZE + block_size(h);
}

/**
 * Initializes the kernel heap manager starting after the loaded kernel image.
 *
 * Sets up a single free block spanning the whole 1 MiB heap region.
 */
export void init() {
    i32 base = heap_image_end();
    base = align_up(base);

    // One big free block spanning the whole heap region.
    set_size(base, kernel_config.HEAP_SIZE - HDR_SIZE);
    set_next(base, 0);
    g_free_head = base;
}

/**
 * Allocates a contiguous memory block of at least `size` bytes from the kernel heap.
 *
 * Uses first-fit allocation and splits remaining space when viable. Panics on OOM.
 * @param size Requested allocation size in bytes.
 * @return Pointer to allocated payload memory.
 */
export i32 alloc(i32 size) {
    if (size <= 0) {
        return 0;
    }
    size = align_up(size);

    i32 prev = 0;
    i32 cur = g_free_head;

    while (cur != 0) {
        i32 cur_size = block_size(cur);
        i32 cur_next = block_next(cur);

        if (cur_size >= size) {
            // Split if the remainder can hold another header + a little payload.
            i32 remainder = cur_size - size;
            if (remainder >= HDR_SIZE + ALIGN) {
                i32 split = cur + HDR_SIZE + size;
                set_size(split, remainder - HDR_SIZE);
                set_next(split, cur_next);
                set_size(cur, size);
                cur_next = split;
            }

            // Unlink cur from the free list.
            if (prev == 0) {
                g_free_head = cur_next;
            } else {
                set_next(prev, cur_next);
            }
            return cur + HDR_SIZE;
        }

        prev = cur;
        cur = cur_next;
    }

    debug.panic("out of memory");
    return 0; // unreachable
}

/**
 * Returns a previously allocated block to the free list.
 *
 * Maintains address order in the free list and coalesces with adjacent free neighbours.
 * @param ptr Pointer to payload memory to free (no-op if 0).
 */
export void free(i32 ptr) {
    if (ptr != 0) {
        i32 block = ptr - HDR_SIZE;

        // Find the insertion point: prev < block < cur, by address.
        i32 prev = 0;
        i32 cur = g_free_head;
        while (cur != 0 && cur < block) {
            prev = cur;
            cur = block_next(cur);
        }

        // Link block into the ordered list between prev and cur.
        set_next(block, cur);
        if (prev == 0) {
            g_free_head = block;
        } else {
            set_next(prev, block);
        }

        // Merge forward: block is immediately before cur.
        if (cur != 0 && block_end(block) == cur) {
            set_size(block, block_size(block) + HDR_SIZE + block_size(cur));
            set_next(block, block_next(cur));
        }

        // Merge backward: prev is immediately before block.
        if (prev != 0 && block_end(prev) == block) {
            set_size(prev, block_size(prev) + HDR_SIZE + block_size(block));
            set_next(prev, block_next(block));
        }
    }
}
