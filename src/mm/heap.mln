package heap;

import { heap_image_end } from "heap_sym.masm";
import debug from "../debug/debug.mln";

// First-fit allocator over the region between the loaded image (`_end`, from
// heap_image_end()) and _end + HEAP_SIZE, with an address-ordered free list and
// coalescing of physically-adjacent free blocks.
//
// Every block is laid out as an 8-byte header followed by its payload:
//   word[h + 0] = size   (payload bytes, not counting the header)
//   word[h + 4] = next   (address of the next FREE block header, 0 = none)
// The free list is kept sorted by address so free() can merge neighbours.
// A block's physical end is  h + HDR_SIZE + size.

import kernel_config from "../kernel/kernel_config.mln";
import irq from "../arch/irq.mln";
import { Result } from "@std/core/result.mln";
import int32 from "@std/core/int32.mln";
import { AllocationError } from "@std/memory/allocator.mln";

i32 HDR_SIZE = 8;
i32 ALIGN = 4;

i32 g_free_head = 0;

/**
 * Reads a 32-bit word from a physical/virtual memory address.
 * @param addr Memory address to read.
 * @return 32-bit word value.
 */
i32 read_word(i32 addr) {
    i32 *p = (i32 *)addr;
    return *p;
}

/**
 * Writes a 32-bit word to a physical/virtual memory address.
 * @param addr Memory address to write.
 * @param value 32-bit word value to store.
 */
void write_word(i32 addr, i32 value) {
    i32 *p = (i32 *)addr;
    *p = value;
}

/**
 * Rounds an integer up to the 4-byte heap alignment boundary.
 * @param n Size in bytes to align.
 * @return 4-byte aligned size.
 */
i32 align_up(i32 n) {
    return (n + (ALIGN - 1)) & ~(ALIGN - 1);
}

/**
 * Reads the payload size stored in a block header.
 * @param h Address of the block header.
 * @return Payload size in bytes, excluding the header.
 */
i32 block_size(i32 h) { return read_word(h + 0); }
/**
 * Reads the next free block address stored in a block header.
 * @param h Address of the block header.
 * @return Address of the next free block header, or 0 if there is none.
 */
i32 block_next(i32 h) { return read_word(h + 4); }
/**
 * Writes the payload size into a block header.
 * @param h Address of the block header.
 * @param v Payload size in bytes, excluding the header.
 */
void set_size(i32 h, i32 v) { write_word(h + 0, v); }
/**
 * Writes the next-free-block pointer into a block header.
 * @param h Address of the block header.
 * @param v Address of the next free block header, or 0 if there is none.
 */
void set_next(i32 h, i32 v) { write_word(h + 4, v); }

i32 g_heap_base = 0;

/**
 * Calculates the address immediately after a block's header and payload.
 * @param h Address of the block header.
 * @return End-exclusive address of the block.
 */
i32 block_end(i32 h) {
    return h + HDR_SIZE + block_size(h);
}

/**
 * Initializes the kernel heap manager starting after the loaded kernel image.
 *
 * Sets up a single free block spanning the configured heap region, beginning
 * at the aligned end of the loaded kernel image.
 */
export void init() {
    i32 base = heap_image_end();
    base = align_up(base);

    // One big free block spanning the whole heap region.
    set_size(base, kernel_config.HEAP_SIZE - HDR_SIZE);
    set_next(base, 0);
    g_free_head = base;
    g_heap_base = base;
}

/**
 * Allocates a contiguous memory block of at least `size` bytes from the kernel heap.
 *
 * Uses first-fit allocation and splits remaining space when viable.
 * The caller must provide the required exclusion when heap locking is enabled.
 * @param size Requested allocation size in bytes.
 * @return `Ok(pointer)` on success, or `Err(InvalidSize|OutOfMemory)`.
 */
Result<i32, AllocationError> alloc_unlocked(i32 size) {
    if (size <= 0 || size > int32.MAX - (ALIGN - 1)) {
        return Err(AllocationError::InvalidSize);
    }
    size = align_up(size);

    i32 prev = 0;
    i32 cur = g_free_head;

    while (cur != 0) {
        i32 cur_size = block_size(cur);
        i32 cur_next = block_next(cur);

        if (cur_size >= size) {
            // Split if the remainder can hold another header + a little payload.
            i32 remainder = cur_size - size;
            if (remainder >= HDR_SIZE + ALIGN) {
                i32 split = cur + HDR_SIZE + size;
                set_size(split, remainder - HDR_SIZE);
                set_next(split, cur_next);
                set_size(cur, size);
                cur_next = split;
            }

            // Unlink cur from the free list.
            if (prev == 0) {
                g_free_head = cur_next;
            } else {
                set_next(prev, cur_next);
            }
            return Ok(cur + HDR_SIZE);
        }

        prev = cur;
        cur = cur_next;
    }

    return Err(AllocationError::OutOfMemory);
}

/**
 * Returns a previously allocated block to the free list.
 *
 * Maintains address order in the free list and coalesces with adjacent free neighbours.
 * The caller must provide the required exclusion when heap locking is enabled.
 * @param ptr Pointer to payload memory to free (no-op if 0).
 */
void free_unlocked(i32 ptr) {
    if (ptr != 0 && g_heap_base != 0) {
        if (ptr < g_heap_base || ptr >= g_heap_base + kernel_config.HEAP_SIZE) {
            debug.printf("heap: free of a pointer outside the heap: %x\n", ptr);
            debug.panic("heap: bad free");
        }
    }
    if (ptr != 0) {
        i32 block = ptr - HDR_SIZE;

        // Find the insertion point: prev < block < cur, by address.
        i32 prev = 0;
        i32 cur = g_free_head;
        while (cur != 0 && cur < block) {
            prev = cur;
            cur = block_next(cur);
        }

        // Link block into the ordered list between prev and cur.
        set_next(block, cur);
        if (prev == 0) {
            g_free_head = block;
        } else {
            set_next(prev, block);
        }

        // Merge forward: block is immediately before cur.
        if (cur != 0 && block_end(block) == cur) {
            set_size(block, block_size(block) + HDR_SIZE + block_size(cur));
            set_next(block, block_next(cur));
        }

        // Merge backward: prev is immediately before block.
        if (prev != 0 && block_end(prev) == block) {
            set_size(prev, block_size(prev) + HDR_SIZE + block_size(block));
            set_next(prev, block_next(block));
        }
    }
}

// The heap is shared by every task and by syscalls (which run in a
// process's context on the timer's schedule), so the free list is walked
// and rewritten with interrupts off once the scheduler is live: a tick
// landing inside alloc() on one task while another task -- or a syscall
// handler -- allocates would leave two blocks overlapping. Before
// enable_locking() (boot, interrupts still off) the sections run bare, so
// they cannot switch interrupts on early.
i32 g_locking = 0;

/**
 * Enables interrupt protection around public heap allocation and free operations.
 *
 * Call once the scheduler is live. This only enables heap protection; it does
 * not itself enable hardware interrupts.
 */
export void enable_locking() { g_locking = 1; }

/**
 * Allocates a block from the kernel heap.
 *
 * Uses first-fit allocation and splits a free block when the remainder can hold
 * another header and payload. Once heap locking is enabled, interrupts are
 * disabled for the allocator's free-list updates and restored to their prior
 * state afterward.
 * @param size Requested allocation size in bytes.
 * @return `Ok(pointer)` on success, or `Err(InvalidSize|OutOfMemory)`.
 */
export Result<i32, AllocationError> alloc(i32 size) {
    if (!g_locking) { return alloc_unlocked(size); }
    i32 was = irq.save_disable();
    Result<i32, AllocationError> result = alloc_unlocked(size);
    irq.restore(was);
    return result;
}

/**
 * Returns a previously allocated block to the kernel heap.
 *
 * Inserts the block into the address-ordered free list and merges adjacent free
 * blocks. A null pointer is a no-op. Once heap locking is enabled, interrupts
 * are disabled during the free-list update and restored to their prior state.
 * @param ptr Pointer to the allocated payload, or 0.
 */
export void free(i32 ptr) {
    if (!g_locking) { free_unlocked(ptr); return; }
    i32 was = irq.save_disable();
    free_unlocked(ptr);
    irq.restore(was);
}
