package mmu;

import heap from "heap.mln";
import mem from "mem.mln";
import debug from "@kernel/debug/debug.mln";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { MmuError } from "@contracts/process/loader.contract.mln";

// =========================================================================
// MyComputer MMU & 2-Level Paging Architecture
// =========================================================================
//
// Page size: 4096 bytes (4 KiB)
// 32-bit Virtual Address breakdown:
//   [31:22] (10 bits) : Page Directory Index (PDI) -> 1024 entries
//   [21:12] (10 bits) : Page Table Index (PTI)     -> 1024 entries
//   [11: 0] (12 bits) : Page Byte Offset
//
// Page Table Entry (PTE / PDE) format (32 bits):
//   [31:12] : Physical Frame Number (base address)
//   [5]     : Dirty (D)
//   [4]     : Accessed (A)
//   [3]     : User accessible (U) - 1 = User/Kernel, 0 = Kernel only
//   [2]     : Executable (X)      - 1 = Executable, 0 = No-exec
//   [1]     : Writable (W)        - 1 = Read/Write, 0 = Read-only
//   [0]     : Valid (V)           - 1 = Present, 0 = Page fault

export const i32 PTE_VALID    = 0x01; // 1 << 0
export const i32 PTE_WRITABLE = 0x02; // 1 << 1
export const i32 PTE_EXEC     = 0x04; // 1 << 2
export const i32 PTE_USER     = 0x08; // 1 << 3
export const i32 PTE_ACCESSED = 0x10; // 1 << 4
export const i32 PTE_DIRTY    = 0x20; // 1 << 5

export const i32 PAGE_SIZE           = 4096;
export const i32 ENTRIES_PER_TABLE   = 1024;

export const i32 MMU_CTRL_ADDR        = 0x24000100;
export const i32 MMU_PDBR_ADDR        = 0x24000104;
export const i32 MMU_FAULT_ADDR       = 0x24000108;
export const i32 MMU_FAULT_STATUS_ADDR= 0x2400010C;

/** Reason recorded by the MMU for the most recent page fault. */
export enum MmuFaultStatus {
    READ,
    WRITE,
    EXECUTE,
    PRIVILEGE,
}

// Global constants for memory regions (> 21-bit immediate)
i32 KERNEL_RAM_BASE   = 0x00000000;
i32 KERNEL_RAM_SIZE   = 0x01000000; // 16 MB

i32 KERNEL_STACK_BASE = 0x1F000000;
i32 KERNEL_STACK_SIZE = 0x01000000; // 16 MB (covers up to 0x20000000 RAM_END)

i32 MMIO_BASE         = 0x24000000;
i32 MMIO_SIZE         = 0x00002000; // 8 KB

i32 VRAM_BASE         = 0x30000000;
i32 VRAM_SIZE         = 0x01000000; // Full 16 MiB board VRAM aperture; geometry is device-reported.

i32 FRAME_MASK        = 0xFFFFF000;

/**
 * Allocates a 4 KiB-aligned, zero-filled physical frame from the heap.
 * @return Some(frame_addr) on success, or None on out of memory.
 */
export Option<i32> alloc_page() {
    i32 page = case alloc_page_uninitialized() of {
        Some(p) -> p;
        None -> ({ return None; });
    };
    // Zero out the page
    i32 i = 0;
    while (i < PAGE_SIZE) {
        mem.write_word(page + i, 0);
        i = i + 4;
    }
    return Some(page);
}

/**
 * Allocates a 4 KiB-aligned frame without clearing it: for a caller that
 * fills the whole page anyway (the loader copying a segment).
 * @return Some(frame_addr) on success, or None on out of memory.
 */
export Option<i32> alloc_page_uninitialized() {
    // Keep the original heap pointer in the word immediately before the
    // aligned frame.  A frame cannot be returned directly to heap.free()
    // because alignment may have advanced the address into the allocation.
    // The extra word guarantees that the bookkeeping word never overlaps the
    // heap allocator's own header, even when `raw` was already page-aligned.
    i32 raw = case heap.alloc(PAGE_SIZE * 2 + 4) of {
        Ok(p) -> p;
        Err(_) -> ({
            debug.println("mmu: out of memory for page allocation");
            return None;
        });
    };
    i32 aligned = (raw + 4 + (PAGE_SIZE - 1)) & ~(PAGE_SIZE - 1);
    mem.write_word(aligned - 4, raw);
    return Some(aligned);
}

/**
 * Releases a frame returned by alloc_page or alloc_page_uninitialized.
 * @param frame Page-aligned frame address containing allocator bookkeeping at frame - 4.
 * @return Ok(_) after returning the raw block, or Err(UnalignedAddress).
 */
export Result<_, MmuError> free_frame(i32 frame) {
    if (frame == 0 || (frame & (PAGE_SIZE - 1))) {
        return Err(MmuError::UnalignedAddress(frame));
    }
    i32 raw = mem.read_word(frame - 4);
    heap.free(raw);
    return Ok(_);
}

/**
 * Creates and initializes a new empty Page Directory (root of page table hierarchy).
 * @return Some(pd_addr) on success, or None on out of memory.
 */
export Option<i32> create_page_directory() {
    return alloc_page();
}

/**
 * Writes a Page Directory Entry with the page table base address and permission flags.
 * @param pde_addr Address of the page directory entry in memory.
 * @param pt_base Physical address of the page table.
 * @param flags Permission flags (PTE_USER, etc.).
 */
void set_pde(i32 pde_addr, i32 pt_base, i32 flags) {
    i32 pde_flags = PTE_VALID | PTE_WRITABLE;
    if (flags & PTE_USER) {
        pde_flags = pde_flags | PTE_USER;
    }
    mem.write_word(pde_addr, (pt_base & FRAME_MASK) | pde_flags);
}

/**
 * Looks up or allocates a second-level page table for a page directory index.
 * @param pd_addr Physical address of the page directory.
 * @param pdi Page directory index (0..1023).
 * @param flags Mapping flags determining user access permissions.
 * @return Ok(pt_base) with page table physical address, or Err(AllocFailed).
 */
Result<i32, MmuError> get_or_create_page_table(i32 pd_addr, i32 pdi, i32 flags) {
    i32 pde_addr = pd_addr + (pdi * 4);
    i32 pde = mem.read_word(pde_addr);

    if (!(pde & PTE_VALID)) {
        i32 pt_base = case alloc_page() of {
            Some(pt) -> pt;
            None -> ({
                return Err(MmuError::AllocFailed);
            });
        };
        set_pde(pde_addr, pt_base, flags);
        return Ok(pt_base);
    }

    // Page table already exists: if user mapping, ensure PDE also has User flag
    if (flags & PTE_USER) {
        mem.write_word(pde_addr, pde | PTE_USER);
    }
    return Ok(pde & FRAME_MASK);
}

/**
 * Maps a single 4 KiB virtual page to a physical frame.
 * @param pd_addr Physical address of page directory.
 * @param vaddr Virtual address (must be 4 KiB aligned).
 * @param paddr Physical frame address (must be 4 KiB aligned).
 * @param flags Permission flags (PTE_USER, PTE_EXEC, PTE_WRITABLE, etc.).
 * @return Ok(_) on success, or Err(MmuError).
 */
export Result<_, MmuError> map_page(i32 pd_addr, i32 vaddr, i32 paddr, i32 flags) {
    if (pd_addr == 0) {
        return Err(MmuError::InvalidDirectory);
    }
    if (vaddr & 0xFFF) {
        return Err(UnalignedAddress(vaddr));
    }
    if (paddr & 0xFFF) {
        return Err(UnalignedAddress(paddr));
    }

    i32 pdi = (vaddr >> 22) & 0x3FF;
    i32 pti = (vaddr >> 12) & 0x3FF;

    i32 pt_base = get_or_create_page_table(pd_addr, pdi, flags)?;

    i32 pte_addr = pt_base + (pti * 4);
    i32 pte = (paddr & FRAME_MASK) | flags | PTE_VALID;
    mem.write_word(pte_addr, pte);
    return Ok(_);
}

/**
 * Removes one page-table mapping without freeing its physical frame.
 * @param pd_addr Physical page-directory base.
 * @param vaddr Page-aligned virtual address to unmap.
 * @return Ok(mapped physical frame), Ok(0) if absent, or a directory/alignment error.
 */
export Result<i32, MmuError> unmap_page(i32 pd_addr, i32 vaddr) {
    if (pd_addr == 0) {
        return Err(MmuError::InvalidDirectory);
    }
    if (vaddr & (PAGE_SIZE - 1)) {
        return Err(MmuError::UnalignedAddress(vaddr));
    }

    i32 pdi = (vaddr >> 22) & 0x3FF;
    i32 pti = (vaddr >> 12) & 0x3FF;
    i32 pde = mem.read_word(pd_addr + pdi * 4);
    if (!(pde & PTE_VALID)) { return Ok(0); }

    i32 pt_base = pde & FRAME_MASK;
    i32 pte_addr = pt_base + pti * 4;
    i32 pte = mem.read_word(pte_addr);
    if (!(pte & PTE_VALID)) { return Ok(0); }

    mem.write_word(pte_addr, 0);
    return Ok(pte & FRAME_MASK);
}

/**
 * Looks up a user-accessible mapping without changing page-table state.
 * @param pd_addr Physical page-directory base.
 * @param vaddr User virtual address within the requested page.
 * @return Some(raw PTE containing frame and flags), or None if not valid/user-accessible.
 */
export Option<i32> user_mapping(i32 pd_addr, i32 vaddr) {
    if (pd_addr == 0) { return None; }
    i32 pdi = (vaddr >> 22) & 0x3FF;
    i32 pti = (vaddr >> 12) & 0x3FF;
    i32 pde = mem.read_word(pd_addr + pdi * 4);
    if (!(pde & PTE_VALID) || !(pde & PTE_USER)) { return None; }
    i32 pte = mem.read_word((pde & FRAME_MASK) + pti * 4);
    if (!(pte & PTE_VALID) || !(pte & PTE_USER)) { return None; }
    return Some(pte);
}

/**
 * Validates every page touched by a user range against required PTE flags.
 * @param pd_addr Physical page-directory base.
 * @param addr First user virtual byte.
 * @param bytes Positive range length.
 * @param required PTE flag mask that every page must contain.
 * @return true when the full non-overflowing range is valid and satisfies required.
 */
export bool user_range_has_flags(i32 pd_addr, i32 addr, i32 bytes, i32 required) {
    if (bytes <= 0 || addr < 0 || addr + bytes < addr) { return false; }
    i32 current = addr;
    i32 end = addr + bytes;
    while (current < end) {
        i32 pte = case user_mapping(pd_addr, current) of {
            Some(value) -> value;
            None -> ({ return false; });
        };
        if ((pte & required) != required) { return false; }
        i32 next = (current & FRAME_MASK) + PAGE_SIZE;
        if (next <= current) { return false; }
        current = next;
    }
    return true;
}

/**
 * Reads an aligned user word through its physical mapping.
 * @param pd_addr Physical page-directory base.
 * @param addr Aligned user virtual word address.
 * @return Some(word) when mapped for user access; otherwise None.
 */
export Option<i32> read_user_word(i32 pd_addr, i32 addr) {
    if (addr & 3) { return None; }
    i32 pte = case user_mapping(pd_addr, addr) of {
        Some(value) -> value;
        None -> ({ return None; });
    };
    i32 physical = (pte & FRAME_MASK) + (addr & (PAGE_SIZE - 1));
    return Some(mem.read_word(physical));
}

/**
 * Writes an aligned user word through its writable physical mapping.
 * @param pd_addr Physical page-directory base.
 * @param addr Aligned user virtual word address.
 * @param value Word to copy out.
 * @return true after a successful write; false for invalid, non-user, or read-only memory.
 */
export bool write_user_word(i32 pd_addr, i32 addr, i32 value) {
    if (addr & 3) { return false; }
    i32 pte = case user_mapping(pd_addr, addr) of {
        Some(mapped) -> mapped;
        None -> ({ return false; });
    };
    if (!(pte & PTE_WRITABLE)) { return false; }
    i32 physical = (pte & FRAME_MASK) + (addr & (PAGE_SIZE - 1));
    mem.write_word(physical, value);
    return true;
}

/**
 * Maps a contiguous virtual memory range to a contiguous physical range.
 * @param pd_addr Physical address of page directory.
 * @param vstart Starting virtual address.
 * @param pstart Starting physical address.
 * @param size Range size in bytes.
 * @param flags Permission flags.
 * @return Ok(_) on success, or Err(MmuError).
 */
export Result<_, MmuError> map_range(i32 pd_addr, i32 vstart, i32 pstart, i32 size, i32 flags) {
    i32 offset = 0;
    while (offset < size) {
        i32 va = vstart + offset;
        i32 pa = pstart + offset;
        map_page(pd_addr, va, pa, flags)?;
        offset = offset + PAGE_SIZE;
    }
    return Ok(_);
}

// The kernel's page tables are shared: the first page directory that gets
// the identity mapping builds them (thousands of map_page calls, over a
// second of emulated time), and every later directory takes the same
// tables by copying the directory entries. The one table a process changes
// -- the first 4 MB, where its text and data are mapped over the identity
// range -- is copied for it, so the shared one stays the kernel's.
bool g_shared_ready = false;
i32 g_shared_pd = 0;      // kernel-only directory holding the shared tables

/**
 * Populates a page directory with kernel RAM, stack, MMIO, and VRAM mappings.
 * @param pd_addr Empty physical page-directory base.
 * @return Ok(_) when every identity range is mapped, or the first MmuError.
 */
Result<_, MmuError> build_identity_tables(i32 pd_addr) {
    // 1. Map lower 16 MB of physical RAM (Kernel image, heaps)
    // Read/Write/Execute, Kernel Mode only
    map_range(pd_addr, KERNEL_RAM_BASE, KERNEL_RAM_BASE, KERNEL_RAM_SIZE, PTE_VALID | PTE_WRITABLE | PTE_EXEC)?;

    // 2. Map high RAM stack region (0x1F000000 .. 0x20000000)
    // Read/Write, Kernel Mode only
    map_range(pd_addr, KERNEL_STACK_BASE, KERNEL_STACK_BASE, KERNEL_STACK_SIZE, PTE_VALID | PTE_WRITABLE)?;

    // 3. Map MMIO peripheral space (0x24000000 .. 0x24002000)
    // Read/Write, Kernel Mode only
    map_range(pd_addr, MMIO_BASE, MMIO_BASE, MMIO_SIZE, PTE_VALID | PTE_WRITABLE)?;

    // 4. Map VRAM framebuffer space (0x30000000 .. 0x30300000)
    // Read/Write, Kernel Mode only
    map_range(pd_addr, VRAM_BASE, VRAM_BASE, VRAM_SIZE, PTE_VALID | PTE_WRITABLE)?;

    return Ok(_);
}

/**
 * Shares the kernel identity mappings with a page directory, while giving it
 * a private low-memory table that user mappings may safely modify.
 * @param pd_addr Physical address of the page directory to initialize.
 * @return Ok(_) on success, or Err(MmuError) on allocation failure.
 */
export Result<_, MmuError> setup_identity_kernel_mapping(i32 pd_addr) {
    if (!g_shared_ready) {
        // The shared tables live in a directory of their own. Building them
        // in the first process's directory shared that process's later user
        // mappings too: every process got its stack page table, so loading
        // one process remapped every other process's stack.
        i32 template = case create_page_directory() of {
            Some(d) -> d;
            None -> ({ return Err(MmuError::AllocFailed); });
        };
        build_identity_tables(template)?;
        g_shared_pd = template;
        g_shared_ready = true;
    }
    // Share every kernel table; give this directory its own copy of the
    // first one, the only one a process overwrites entries in.
    i32 pdi = 0;
    while (pdi < 1024) {
        i32 pde = mem.read_word(g_shared_pd + pdi * 4);
        if (pde & PTE_VALID) {
            if (pdi == 0) {
                i32 copy = case alloc_page() of {
                    Some(p) -> p;
                    None -> ({ return Err(MmuError::AllocFailed); });
                };
                i32 src = pde & FRAME_MASK;
                i32 k = 0;
                while (k < PAGE_SIZE) {
                    mem.write_word(copy + k, mem.read_word(src + k));
                    k = k + 4;
                }
                mem.write_word(pd_addr + pdi * 4, (copy & FRAME_MASK) | (pde & 0xFFF));
            } else {
                mem.write_word(pd_addr + pdi * 4, pde);
            }
        }
        pdi++;
    }
    return Ok(_);
}

/** @return Kernel-only shared page-directory base, or None before setup. */
export Option<i32> kernel_page_directory() {
    if (!g_shared_ready) { return None; }
    return Some(g_shared_pd);
}

/**
 * Releases every process-private user frame and page-table frame, followed by
 * the page directory itself. Shared kernel identity page tables remain owned
 * by the kernel template and are never released here.
 * @param pd_addr Process-owned physical page-directory base.
 * @return Ok(_) after complete destruction, or the first frame/directory error.
 */
export Result<_, MmuError> destroy_user_address_space(i32 pd_addr) {
    if (pd_addr == 0 || pd_addr == g_shared_pd) {
        return Err(MmuError::InvalidDirectory);
    }

    i32 pdi = 0;
    while (pdi < ENTRIES_PER_TABLE) {
        i32 pde_addr = pd_addr + pdi * 4;
        i32 pde = mem.read_word(pde_addr);
        if (pde & PTE_VALID) {
            i32 pt = pde & FRAME_MASK;
            i32 shared_pt = 0;
            if (g_shared_ready) {
                i32 shared_pde = mem.read_word(g_shared_pd + pdi * 4);
                if (shared_pde & PTE_VALID) {
                    shared_pt = shared_pde & FRAME_MASK;
                }
            }

            if (pt != shared_pt) {
                i32 pti = 0;
                while (pti < ENTRIES_PER_TABLE) {
                    i32 pte = mem.read_word(pt + pti * 4);
                    // Only user mappings own their physical frames. The
                    // private pdi-0 table also contains copied kernel identity
                    // entries, whose physical RAM must not be freed.
                    if ((pte & PTE_VALID) && (pte & PTE_USER)) {
                        free_frame(pte & FRAME_MASK)?;
                    }
                    pti++;
                }
                free_frame(pt)?;
            }
            mem.write_word(pde_addr, 0);
        }
        pdi++;
    }

    free_frame(pd_addr)?;
    return Ok(_);
}

export void enable_paging(i32 pd_addr) {
    mem.write_word(MMU_PDBR_ADDR, pd_addr);
    mem.write_word(MMU_CTRL_ADDR, 1);
    debug.println("mmu: paging enabled");
}

/**
 * Disables hardware MMU address translation.
 */
export void disable_paging() {
    mem.write_word(MMU_CTRL_ADDR, 0);
    debug.println("mmu: paging disabled");
}

/**
 * Reads the faulting virtual address from the MMU hardware register.
 * @return Faulting memory address.
 */
export i32 get_fault_address() {
    return mem.read_word(MMU_FAULT_ADDR);
}

/**
 * Reads the fault reason code from the MMU hardware register.
 * @return Typed access reason for the most recent fault.
 */
export MmuFaultStatus get_fault_status() {
    return mem.read_word(MMU_FAULT_STATUS_ADDR);
}
