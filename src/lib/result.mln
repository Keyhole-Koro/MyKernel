// Payload-enum result value. Build it directly with `Ok(value)` / `Err(error)`
// and match it with `case`; result_take_ok()/result_take_err() are
// convenience wrappers for the common "check and consume" shape.
export enum Result<T, E> {
    Ok(T),
    Err(E),
}

export i32 result_take_ok<T, E>(Result<T, E> *result, T *out) {
    return case *result of {
        Ok(v)  -> ({ *out = v; 1; });
        Err(e) -> 0;
    };
}

export i32 result_take_err<T, E>(Result<T, E> *result, E *out) {
    return case *result of {
        Ok(v)  -> 0;
        Err(e) -> ({ *out = e; 1; });
    };
}
