package str;

// NUL-terminated byte string helpers.
//
// A "string" here is a `char*` pointing at bytes terminated by 0, the only
// string representation MyLang has today: a literal is interned into the data
// section by the compiler and its address loaded with `movi`. There is no
// length word, so every call that needs one walks the bytes.
//
// Reads mask with 0xFF because `char` sign-extends when widened to i32, which
// would make any byte >= 0x80 compare as negative.

// Number of bytes before the terminator.
export i32 len(char* s) {
    i32 n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    return n;
}

// Lexicographic comparison by unsigned byte value.
// Returns <0 if a sorts before b, 0 if equal, >0 otherwise.
export i32 cmp(char* a, char* b) {
    i32 i = 0;
    while (1) {
        i32 ca = (i32)a[i] & 0xFF;
        i32 cb = (i32)b[i] & 0xFF;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        i = i + 1;
    }
}

// Non-zero when both strings hold the same bytes.
export i32 eq(char* a, char* b) {
    if (cmp(a, b) == 0) {
        return 1;
    }
    return 0;
}

// Compare at most n bytes. Returns 0 when the first n bytes match.
export i32 ncmp(char* a, char* b, i32 n) {
    i32 i = 0;
    while (i < n) {
        i32 ca = (i32)a[i] & 0xFF;
        i32 cb = (i32)b[i] & 0xFF;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Non-zero when s begins with prefix.
export i32 starts_with(char* s, char* prefix) {
    i32 i = 0;
    while (prefix[i] != 0) {
        i32 cs = (i32)s[i] & 0xFF;
        i32 cp = (i32)prefix[i] & 0xFF;
        if (cs != cp) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// Copy src (including the terminator) into dst. Returns the length copied.
// The caller guarantees dst holds len(src) + 1 bytes.
export i32 copy(char* dst, char* src) {
    i32 i = 0;
    while (src[i] != 0) {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
    return i;
}

// Copy at most cap-1 bytes and always terminate. Returns the length written,
// so a truncated copy is visible as a return value smaller than len(src).
export i32 ncopy(char* dst, char* src, i32 cap) {
    if (cap <= 0) {
        return 0;
    }
    i32 i = 0;
    while (i < cap - 1) {
        if (src[i] == 0) {
            break;
        }
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
    return i;
}

// Append src to dst. Returns the resulting total length.
// The caller guarantees dst holds len(dst) + len(src) + 1 bytes.
export i32 cat(char* dst, char* src) {
    i32 n = len(dst);
    i32 i = 0;
    while (src[i] != 0) {
        dst[n + i] = src[i];
        i = i + 1;
    }
    dst[n + i] = 0;
    return n + i;
}

// Index of the first occurrence of byte c, or -1.
export i32 chr(char* s, i32 c) {
    i32 i = 0;
    i32 want = c & 0xFF;
    while (s[i] != 0) {
        if (((i32)s[i] & 0xFF) == want) {
            return i;
        }
        i = i + 1;
    }
    if (want == 0) {
        return i;
    }
    return -1;
}

// Index of the first occurrence of needle in haystack, or -1.
// An empty needle matches at 0.
export i32 find(char* haystack, char* needle) {
    if (needle[0] == 0) {
        return 0;
    }
    i32 i = 0;
    while (haystack[i] != 0) {
        if (starts_with(&haystack[i], needle) != 0) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Convert a 32-bit integer to a NUL-terminated string in base 10.
// Returns the number of characters written, excluding the NUL terminator.
export i32 itoa(i32 value, char* buf) {
    if (value == 0) {
        buf[0] = 48; // '0'
        buf[1] = 0;
        return 1;
    }

    i32 is_negative = 0;
    if (value < 0) {
        is_negative = 1;
        value = 0 - value;
    }

    // Count digits
    i32 temp = value;
    i32 num_digits = 0;
    while (temp > 0) {
        num_digits = num_digits + 1;
        temp = temp / 10;
    }

    i32 total_chars = num_digits;
    if (is_negative != 0) {
        total_chars = total_chars + 1;
    }

    buf[total_chars] = 0;

    temp = value;
    i32 i = total_chars - 1;

    while (temp > 0) {
        i32 d = temp % 10;
        buf[i] = 48 + d; // '0' + d
        temp = temp / 10;
        i = i - 1;
    }

    if (is_negative != 0) {
        buf[0] = 45; // '-'
    }

    return total_chars;
}

// Convert value to base 16 without a prefix, using lowercase digits.
// Returns the number of characters written, excluding the terminator.
export i32 xtoa(i32 value, char* buf) {
    if (value == 0) {
        buf[0] = 48; // '0'
        buf[1] = 0;
        return 1;
    }

    // Count nibbles, skipping leading zeros. Shifting right by 4 keeps this
    // free of the multiply and divide the target has no instruction for.
    i32 shift = 28;
    while (shift > 0) {
        if (((value >> shift) & 15) != 0) {
            break;
        }
        shift = shift - 4;
    }

    i32 n = 0;
    while (shift >= 0) {
        i32 nibble = (value >> shift) & 15;
        if (nibble < 10) {
            buf[n] = 48 + nibble;  // '0'
        } else {
            buf[n] = 87 + nibble;  // 'a' - 10
        }
        n = n + 1;
        shift = shift - 4;
    }
    buf[n] = 0;
    return n;
}

// Parse a leading optional sign followed by base-10 digits.
// Stops at the first byte that is not a digit; returns 0 when none are found.
export i32 atoi(char* s) {
    i32 i = 0;
    i32 sign = 1;

    if (s[0] == 45) {        // '-'
        sign = 0 - 1;
        i = 1;
    } else if (s[0] == 43) { // '+'
        i = 1;
    }

    i32 value = 0;
    while (1) {
        i32 c = (i32)s[i] & 0xFF;
        if (c < 48 || c > 57) {
            break;
        }
        // value * 10 as shifts: the target has no multiply instruction, so
        // codegen would otherwise expand this into a repeated-add loop.
        value = (value << 3) + (value << 1) + (c - 48);
        i = i + 1;
    }

    if (sign < 0) {
        return 0 - value;
    }
    return value;
}
