package bitset;

// Bit array over a caller-owned byte buffer.
//
// Bit i lives in byte i/8 at bit i%8, LSB first — the layout the MFS block
// allocation bitmap (MyOS src/fs/fs.mln) and a page-frame allocator both want.
// The buffer is caller-owned; a set of n bits needs bytes(n) bytes.
//
// Indices are divided and masked with shifts, not `/` and `%`: the target has
// no divide instruction, so codegen would expand those into loops.

// Bytes needed to hold n bits.
export i32 bytes(i32 n) {
    return (n + 7) >> 3;
}

// Value of bit i, as 0 or 1.
export i32 get(char* bits, i32 i) {
    i32 b = (i32)bits[i >> 3] & 0xFF;
    return (b >> (i & 7)) & 1;
}

// Set bit i to 1.
export void set(char* bits, i32 i) {
    i32 off = i >> 3;
    i32 b = (i32)bits[off] & 0xFF;
    bits[off] = b | (1 << (i & 7));
}

// Set bit i to 0.
export void clear(char* bits, i32 i) {
    i32 off = i >> 3;
    i32 b = (i32)bits[off] & 0xFF;
    bits[off] = b & ~(1 << (i & 7));
}

// Set bit i to 1 when value is non-zero, otherwise to 0.
export void put(char* bits, i32 i, i32 value) {
    if (value != 0) {
        set(bits, i);
    } else {
        clear(bits, i);
    }
}

// Flip bit i and return its new value.
export i32 toggle(char* bits, i32 i) {
    i32 off = i >> 3;
    i32 b = (i32)bits[off] & 0xFF;
    b = b ^ (1 << (i & 7));
    bits[off] = b;
    return (b >> (i & 7)) & 1;
}

// Index of the first 0 bit at or after `start`, searching up to n bits.
// Returns -1 when every bit in range is set.
//
// Whole bytes of 0xFF are skipped at once, so scanning a nearly full bitmap
// costs one load per 8 bits rather than one per bit.
export i32 find_clear(char* bits, i32 n, i32 start) {
    i32 i = start;
    if (i < 0) {
        i = 0;
    }

    while (i < n) {
        if ((i & 7) == 0) {
            while (i + 8 <= n) {
                if (((i32)bits[i >> 3] & 0xFF) != 0xFF) {
                    break;
                }
                i = i + 8;
            }
            if (i >= n) {
                return -1;
            }
        }
        if (get(bits, i) == 0) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Index of the first 1 bit at or after `start`, searching up to n bits, or -1.
export i32 find_set(char* bits, i32 n, i32 start) {
    i32 i = start;
    if (i < 0) {
        i = 0;
    }

    while (i < n) {
        if ((i & 7) == 0) {
            while (i + 8 <= n) {
                if (((i32)bits[i >> 3] & 0xFF) != 0) {
                    break;
                }
                i = i + 8;
            }
            if (i >= n) {
                return -1;
            }
        }
        if (get(bits, i) != 0) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Number of set bits among the first n bits.
export i32 count(char* bits, i32 n) {
    i32 total = 0;
    i32 i = 0;
    while (i < n) {
        total = total + get(bits, i);
        i = i + 1;
    }
    return total;
}

// Set every bit in [0, n) to 0.
export void clear_all(char* bits, i32 n) {
    i32 nbytes = bytes(n);
    i32 i = 0;
    while (i < nbytes) {
        bits[i] = 0;
        i = i + 1;
    }
}
