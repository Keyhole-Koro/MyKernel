// Payload-enum option value. Build it directly with `Some(value)` / `None`
// and match it with `case`; option_take() is a convenience for the common
// "check and consume" shape.
export enum Option<T> {
    Some(T),
    None,
}

export i32 option_take<T>(Option<T> *option, T *out) {
    return case *option of {
        Some(v) -> ({ *out = v; 1; });
        None    -> 0;
    };
}
