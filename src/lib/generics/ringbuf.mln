// Fixed-capacity FIFO over caller-owned storage. One slot remains empty to
// distinguish full from empty, so usable capacity is `cap - 1`.
export struct RingBuffer<T> {
    T *data;
    i32 cap;
    i32 head;
    i32 tail;
};

export void ring_init<T>(RingBuffer<T> *ring, T *storage, i32 cap) {
    ring->data = storage;
    ring->cap = cap;
    ring->head = 0;
    ring->tail = 0;
}

export i32 ring_count<T>(RingBuffer<T> *ring) {
    if (ring->tail >= ring->head) {
        return ring->tail - ring->head;
    }
    return ring->cap - ring->head + ring->tail;
}

export i32 ring_push<T>(RingBuffer<T> *ring, T value) {
    i32 next = ring->tail + 1;
    if (next >= ring->cap) {
        next = 0;
    }
    if (next == ring->head) {
        return 0;
    }
    T *data = ring->data;
    data[ring->tail] = value;
    ring->tail = next;
    return 1;
}

export i32 ring_pop<T>(RingBuffer<T> *ring, T *out) {
    if (ring->head == ring->tail) {
        return 0;
    }
    T *data = ring->data;
    *out = data[ring->head];
    ring->head = ring->head + 1;
    if (ring->head >= ring->cap) {
        ring->head = 0;
    }
    return 1;
}
