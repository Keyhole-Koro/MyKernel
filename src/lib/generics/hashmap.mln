// Fixed-capacity string-keyed map. Keys are borrowed NUL-terminated strings;
// capacity must be a power of two. Deletion and automatic growth are omitted.
export struct HashMap<T> {
    i32 *keys;
    T *values;
    i32 cap;
    i32 len;
};

export void hashmap_init<T>(HashMap<T> *map, i32 *keys, T *values, i32 cap) {
    map->keys = keys;
    map->values = values;
    map->len = 0;
    if (cap <= 0 || (cap & (cap - 1)) != 0) {
        map->cap = 0;
        return;
    }
    map->cap = cap;
    i32 i = 0;
    while (i < cap) {
        keys[i] = 0;
        i = i + 1;
    }
}

export i32 hashmap_put<T>(HashMap<T> *map, char *key, T value) {
    if (map->cap <= 0) {
        return 0;
    }
    i32 hash = 5381;
    i32 index = 0;
    while (key[index] != 0) {
        hash = (hash * 33) + ((i32)key[index] & 0xFF);
        index = index + 1;
    }
    i32 slot = hash & (map->cap - 1);
    i32 *keys = map->keys;
    T *values = map->values;
    i32 checked = 0;
    while (checked < map->cap) {
        char *existing = (char *)keys[slot];
        if (existing == (char *)0) {
            keys[slot] = (i32)key;
            values[slot] = value;
            map->len = map->len + 1;
            return 1;
        }
        i32 equal = 1;
        index = 0;
        while (existing[index] != 0 || key[index] != 0) {
            if (existing[index] != key[index]) {
                equal = 0;
                break;
            }
            index = index + 1;
        }
        if (equal != 0) {
            values[slot] = value;
            return 1;
        }
        slot = slot + 1;
        if (slot >= map->cap) {
            slot = 0;
        }
        checked = checked + 1;
    }
    return 0;
}

export i32 hashmap_get<T>(HashMap<T> *map, char *key, T *out) {
    if (map->cap <= 0) {
        return 0;
    }
    i32 hash = 5381;
    i32 index = 0;
    while (key[index] != 0) {
        hash = (hash * 33) + ((i32)key[index] & 0xFF);
        index = index + 1;
    }
    i32 slot = hash & (map->cap - 1);
    i32 *keys = map->keys;
    T *values = map->values;
    i32 checked = 0;
    while (checked < map->cap) {
        char *existing = (char *)keys[slot];
        if (existing == (char *)0) {
            return 0;
        }
        i32 equal = 1;
        index = 0;
        while (existing[index] != 0 || key[index] != 0) {
            if (existing[index] != key[index]) {
                equal = 0;
                break;
            }
            index = index + 1;
        }
        if (equal != 0) {
            *out = values[slot];
            return 1;
        }
        slot = slot + 1;
        if (slot >= map->cap) {
            slot = 0;
        }
        checked = checked + 1;
    }
    return 0;
}
