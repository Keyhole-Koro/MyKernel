// A singly linked intrusive list. The payload type owns its next link; callers
// pass the address of that field (for example, `&node->next`).
export struct IntrusiveList<T> {
    T *head;
    i32 len;
};

export void intrusive_list_init<T>(IntrusiveList<T> *list) {
    list->head = (T *)0;
    list->len = 0;
}

export void intrusive_push_front<T>(IntrusiveList<T> *list, T *node, T **node_next) {
    *node_next = list->head;
    list->head = node;
    list->len = list->len + 1;
}

export T *intrusive_pop_front<T>(IntrusiveList<T> *list, T **head_next) {
    T *node = list->head;
    if (node == 0) {
        return (T *)0;
    }
    list->head = *head_next;
    *head_next = (T *)0;
    list->len = list->len - 1;
    return node;
}
