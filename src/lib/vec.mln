// Fixed-capacity vector over caller-owned storage.
export struct Vec<T> {
    T *data;
    i32 len;
    i32 cap;
};

export void vec_init<T>(Vec<T> *vec, T *storage, i32 cap) {
    vec->data = storage;
    vec->len = 0;
    vec->cap = cap;
}

export i32 vec_len<T>(Vec<T> *vec) {
    return vec->len;
}

export i32 vec_push<T>(Vec<T> *vec, T value) {
    if (vec->len >= vec->cap) {
        return 0;
    }
    T *data = vec->data;
    data[vec->len] = value;
    vec->len = vec->len + 1;
    return 1;
}

export i32 vec_pop<T>(Vec<T> *vec, T *out) {
    if (vec->len == 0) {
        return 0;
    }
    vec->len = vec->len - 1;
    T *data = vec->data;
    *out = data[vec->len];
    return 1;
}

export T *vec_at<T>(Vec<T> *vec, i32 index) {
    if (index < 0 || index >= vec->len) {
        return (T *)0;
    }
    return vec->data + index;
}
