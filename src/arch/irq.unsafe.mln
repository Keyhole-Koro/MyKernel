package irq;

import { hw_irq_enable, hw_irq_disable, hw_irq_vector_target } from "interrupt.masm";
import mem from "@kernel/mm/mem.mln";

// Single fixed IRQ vector slot in the I/O region (IO_BASE + 0x80). The CPU reads
// this on an interrupt to find the handler. Must match IRQ_VECTOR_ADDR in the
// emulator (runtime/MyEmulator/src/constants.rs).
i32 IRQ_VECTOR_ADDR = 0x24000080;

/**
 * Installs the low-level trampoline as the interrupt handler.
 *
 * Until this is called, the vector slot is 0 and the emulator suppresses interrupts.
 */
export void set_handler() {
    mem.write_word(IRQ_VECTOR_ADDR, hw_irq_vector_target());
}

/**
 * Enables hardware interrupts globally.
 */
// Software mirror of the CPU's interrupt-enable bit: the ISA has no way to
// read it back, and a critical section must restore what it found rather
// than switch interrupts on -- inside a syscall or interrupt handler they
// are off, and turning them on there lets the timer switch tasks in the
// middle of the kernel's work.
bool g_enabled = false;

/**
 * Enables hardware interrupts globally and updates the software mirror of the
 * interrupt-enable state.
 */
export void enable() {
    g_enabled = true;
    hw_irq_enable();
}

/**
 * Disables hardware interrupts and saves the state that was active beforehand.
 *
 * Pass the returned value to `restore()` after the critical section.
 * This preserves a surrounding interrupt-disabled context.
 * @return True if interrupts were enabled.
 */
@safe
export bool save_disable() {
    hw_irq_disable();
    bool prev = g_enabled;
    g_enabled = false;
    return prev;
}

/**
 * Restores the interrupt-enable state saved by `save_disable()`.
 *
 * If `prev` is true, hardware interrupts are enabled and the software mirror
 * is updated. Otherwise interrupts remain disabled.
 * @param prev State returned by the matching `save_disable()` call.
 */
@safe
export void restore(bool prev) {
    if (prev) {
        g_enabled = true;
        hw_irq_enable();
    }
}

/**
 * Records the interrupt-enable state when entering an interrupt handler.
 *
 * The CPU has already disabled hardware interrupts on handler entry. This
 * function updates the software mirror to reflect that state.
 * @return Interrupt-enable state mirrored before handler entry.
 */
export bool enter_handler() {
    bool prev = g_enabled;
    g_enabled = false;
    return prev;
}

/**
 * Restores the software interrupt-enable mirror before returning from a handler.
 *
 * The interrupt return instruction restores the hardware state; this function
 * only updates the software mirror to match it.
 * @param prev State returned by `enter_handler()`.
 */
export void leave_handler(bool prev) {
    g_enabled = prev;
}
