; Thin wrappers over the EI/DI instructions so MyLang code can enable/disable
; interrupts. Same `export name: <instr>; mov pc,lr` pattern as halt.masm.
;
; irq_trampoline_addr() returns the address of the trampoline (a masm symbol
; the linker resolves) so MyLang can install it into the IRQ vector slot.
import { irq_trampoline } from "irq_trampoline.masm"

export hw_irq_enable
export hw_irq_disable
export hw_irq_vector_target

hw_irq_enable:
  ei
  mov pc, lr

hw_irq_disable:
  di
  mov pc, lr

; Returns the address of the trampoline. This is a normal synchronous
; function call during OS init, not an interrupt handler. It is perfectly
; safe to overwrite r1 here (standard MyLang ABI return register).
; Actual unexpected hardware interrupts are handled by `irq_trampoline`,
; which correctly saves and restores r1 and other registers to the stack.
hw_irq_vector_target:
  movi r1, irq_trampoline
  mov  pc, lr
