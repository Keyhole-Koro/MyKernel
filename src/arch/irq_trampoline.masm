; Low-level interrupt context helpers. The IRQ vector enters the MyLang
; irq_dispatch_entry() function; its first action is to call irq_trampoline.
; At that point MyLang's fixed entry prologue has saved the interrupted lr/bp.
;
; irq_trampoline returns an interrupt-frame pointer in r1. irq_resume accepts
; such a pointer in r5 and resumes it with iret. Neither helper contains
; dispatch policy or Result handling.
export irq_trampoline
export irq_resume

irq_trampoline:
  ; Reserve the frame tail (bp, lr, SR, PC), then save r0-r7. MyLang fills
  ; the tail from its entry frame before dispatching.
  addis sp, -16
  push r0
  push r1
  push r2
  push r3
  push r4
  push r5
  push r6
  push r7

  mov r1, sp
  mov pc, lr

irq_resume:
  mov sp, r5
  pop r7
  pop r6
  pop r5
  pop r4
  pop r3
  pop r2
  pop r1
  pop r0
  pop bp
  pop lr
  iret
