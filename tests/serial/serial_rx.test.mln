package scheduler;

import debug from "../../src/debug/debug.mln";
import heap from "../../src/mm/heap.mln";
import irq from "../../src/arch/irq.mln";

test("serial_rx", {
    stdin: "PINGq";
    expect: "PING";
    step: 10000000;
}, () => {
    debug.println("kernel: boot");
    debug.println("kernel: arch init");
    heap.init();
    debug.println("kernel: heap ready");

    irq.set_handler();
    irq.enable();
    debug.println("kernel: type to echo (q to quit)");

    while (1) {
    }
});
