import assert from "@std/testing/assert.mln";
import keyboard from "@kernel/io/keyboard.mln";
import mouse from "@kernel/io/mouse.mln";
import { KeyEventType, KeyModifier, KeyCode } from "@contracts/input/keyboard.contract.mln";
import { PointerButton } from "@contracts/input/pointer.contract.mln";

// The keyboard and mouse drivers each keep a software ring buffer that the
// IRQ handler fills from the hardware FIFO and the compositor drains. These
// tests pin the queue contract (FIFO order, pop, empty detection, overflow
// drops the newest) using the drivers' inject hooks, which bypass MMIO.

/*@Test "keyboard queue is FIFO and drops when full" {
    step: 2000000;
}*/
void keyboard_queue() {
    assert.assert_true(keyboard.has_event() == 0, "starts empty");

    keyboard.inject(KeyEventType::DOWN, 'a', 0);
    keyboard.inject(KeyEventType::CHAR, 'A', KeyModifier::SHIFT);
    keyboard.inject(KeyEventType::UP, 'a', 0);
    assert.assert_true(keyboard.has_event(), "has events");
    assert.assert_true(keyboard.event_type(), "first is DOWN");
    assert.assert_true(keyboard.event_code() == 'a', "down code");
    keyboard.pop_event();
    assert.assert_true(keyboard.event_type() == KeyEventType::CHAR, "then CHAR");
    assert.assert_true(keyboard.event_code() == 'A', "char code");
    assert.assert_true(keyboard.event_mods(), "char carries mods");
    keyboard.pop_event();
    assert.assert_true(keyboard.event_type() == KeyEventType::UP, "then UP");
    keyboard.pop_event();
    assert.assert_true(keyboard.has_event() == 0, "drained");
    keyboard.pop_event(); // popping an empty queue is harmless
    assert.assert_true(keyboard.has_event() == 0, "still empty");

    // Capacity is 64 slots, one of which stays free to tell full from empty.
    i32 i = 0;
    while (i < 70) {
        keyboard.inject(KeyEventType::CHAR, '0' + (i % 10), 0);
        i = i + 1;
    }
    i32 n = 0;
    while (keyboard.has_event()) {
        keyboard.pop_event();
        n = n + 1;
    }
    assert.assert_true(n == 63, "overflowing injects are dropped, not wrapped");
}

/*@Test "key codes are stable" {
    step: 1000000;
}*/
void key_codes() {
    // Pin the shared protocol values against the emulator's constants.rs.
    assert.assert_true(KeyCode::BACKSPACE == 8, "backspace");
    assert.assert_true(KeyCode::ENTER == 13, "enter");
    assert.assert_true(KeyCode::DELETE == 127, "delete");
    assert.assert_true(KeyCode::LEFT == 0x101, "left");
    assert.assert_true(KeyCode::RIGHT == 0x102, "right");
    assert.assert_true(KeyCode::HOME == 0x105, "home");
    assert.assert_true(KeyCode::END == 0x106, "end");
    assert.assert_true(PointerButton::LEFT == 1, "left button bit");
    assert.assert_true(PointerButton::RIGHT == 2, "right button bit");
    assert.assert_true(PointerButton::MIDDLE == 4, "middle button bit");
}
