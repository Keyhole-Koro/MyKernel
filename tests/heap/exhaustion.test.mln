import assert from "@std/testing/assert.mln";
import heap from "../../src/mm/heap.mln";
import kernel_config from "../../src/kernel/kernel_config.mln";
import { Result } from "@std/core/result.mln";
import { AllocationError } from "@std/memory/allocator.mln";

// The allocator's arena includes a block header, so a request of the whole
// configured size must fail with OutOfMemory instead of panicking.
/*@Test "heap exhaustion returns an error" { step: 1000000; }*/
void heap_exhaustion_returns_an_error() {
    heap.init();

    Result<i32, AllocationError> allocation = heap.alloc(kernel_config.HEAP_SIZE);
    bool out_of_memory = case allocation of {
        Ok(_) -> false;
        Err(AllocationError::OutOfMemory) -> true;
        Err(_) -> false;
    };
    assert.assert_true(out_of_memory, "OOM is returned as an allocation error");
}
