import heap from "@kernel/mm/heap.mln";
import { Result } from "@std/core/result.mln";

// Allocating past the heap capacity returns an allocation error.
i32 main() {
    heap.init();
    i32 i = 0;
    while (i < 100000) {
        case heap.alloc(64) of {
            Ok(_) -> ({ i = i + 1; });
            Err(_) -> ({ return 1; });
        };
    }
    return 91; // the heap should run out before this point
}
