import heap from "@kernel/mm/heap.mln";
import heap_alloc_support from "../alloc_support.mln";

// Two allocations are independently writable (no aliasing).
i32 main() {
    heap.init();
    i32 a = heap_alloc_support.alloc_or_zero(16);
    i32 b = heap_alloc_support.alloc_or_zero(16);
    if (a == 0) { return 91; }
    if (b == 0) { return 92; }

    i32 *pa = (i32 *)a;
    i32 *pb = (i32 *)b;
    *pa = 111;
    *pb = 222;
    if (*pa != 111) { return 93; }
    if (*pb != 222) { return 94; }
    return 1;
}
