import heap from "@kernel/mm/heap.mln";
import heap_alloc from "../alloc_support.mln";

// Freeing a block and allocating the same size reuses it (LIFO free list head).
i32 main() {
    heap.init();
    i32 a = heap_alloc.alloc_or_zero(16);
    i32 b = heap_alloc.alloc_or_zero(16);
    if (a == 0) { return 91; }
    if (b == 0) { return 92; }

    heap.free(a);
    i32 c = heap_alloc.alloc_or_zero(16);
    if (c != a) { return 93; }
    return 1;
}
