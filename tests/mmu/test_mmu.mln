import debug from "../../src/debug/debug.mln";
import heap from "../../src/mm/heap.mln";
import mem from "../../src/mm/mem.mln";
import mmu from "../../src/mm/mmu.mln";
import { Result } from "../../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../../toolchain/MyStdLib/option.mln";
import { assert_eq } from "../../../../toolchain/MyStdLib/assert.mln";
import { MmuError } from "../../src/mm/mmu.mln";
import { halt_cpu } from "../../src/arch/halt.masm";

i32 PTE_VALID    = 0x01;
i32 PTE_WRITABLE = 0x02;

i32 TEST_VA = 0x40000000;
i32 TEST_VAL1 = 0x12345;
i32 TEST_VAL2 = 0x67890;
i32 TEST_VAL3 = 0xABCDE;
i32 TEST_VAL4 = 0x54321;

void assert_fail(char* message) {
    debug.printf("[FAIL] %s\n", message);
    halt_cpu();
}

void kernel_main() {
    debug.println("--- Starting MMU & Virtual Memory Test ---");

    heap.init();

    i32 pd = case mmu.create_page_directory() of {
        Some(p) -> p;
        None -> ({
            debug.println("[FAIL] failed to allocate root page directory");
            return;
        });
    };
    debug.printf("mmu: root page directory at 0x%x\n", pd);

    // 1. Identity map the kernel execution space & MMIO
    Result<_, MmuError> id_res = mmu.setup_identity_kernel_mapping(pd);
    case id_res of {
        Ok(_) -> 0;
        Err(AllocFailed) -> ({
            debug.println("[FAIL] failed to setup identity kernel mapping");
            return;
        });
        Err(InvalidDirectory) -> ({
            debug.println("[FAIL] unexpected InvalidDirectory for identity mapping");
            return;
        });
        Err(UnalignedAddress(a)) -> ({
            debug.println("[FAIL] unexpected UnalignedAddress for identity mapping");
            return;
        });
    };

    // 2. Allocate a physical frame and map high virtual address 0x40000000 (1 GB) to it
    i32 pa = case mmu.alloc_page() of {
        Some(p) -> p;
        None -> ({
            debug.println("[FAIL] failed to allocate physical frame");
            return;
        });
    };
    i32 va = TEST_VA;
    
    // Write test signature physically before enabling MMU
    mem.write_word(pa, TEST_VAL1);
    mem.write_word(pa + 4, TEST_VAL2);

    Result<_, MmuError> map_res = mmu.map_page(pd, va, pa, PTE_VALID | PTE_WRITABLE);
    case map_res of {
        Ok(_) -> 0;
        Err(AllocFailed) -> ({
            debug.println("[FAIL] map_page failed");
            return;
        });
        Err(InvalidDirectory) -> ({
            debug.println("[FAIL] unexpected InvalidDirectory for map_page");
            return;
        });
        Err(UnalignedAddress(a)) -> ({
            debug.println("[FAIL] unexpected UnalignedAddress for map_page");
            return;
        });
    };

    // 3. Enable Paging
    mmu.enable_paging(pd);

    // 4. Access virtual address 0x40000000 through MMU translation
    i32 val1 = mem.read_word(va);
    i32 val2 = mem.read_word(va + 4);
    assert_eq<i32>(val1, TEST_VAL1, "virtual address read word 0 mismatch");
    assert_eq<i32>(val2, TEST_VAL2, "virtual address read word 1 mismatch");
    debug.println("mmu: virtual address read verified");

    // 5. Write through virtual address and verify
    mem.write_word(va, TEST_VAL3);
    mem.write_word(va + 4, TEST_VAL4);

    i32 val3 = mem.read_word(va);
    i32 val4 = mem.read_word(va + 4);
    assert_eq<i32>(val3, TEST_VAL3, "virtual address write word 0 mismatch");
    assert_eq<i32>(val4, TEST_VAL4, "virtual address write word 1 mismatch");
    debug.println("mmu: virtual address write verified");

    // 6. Disable Paging and verify physical memory was modified
    mmu.disable_paging();

    i32 pval1 = mem.read_word(pa);
    i32 pval2 = mem.read_word(pa + 4);
    assert_eq<i32>(pval1, TEST_VAL3, "physical backing word 0 mismatch");
    assert_eq<i32>(pval2, TEST_VAL4, "physical backing word 1 mismatch");
    debug.println("mmu: physical memory backing verified");

    // 7. Verify finer-grained MmuError reporting
    // 7a. Test InvalidDirectory error (pd_addr == 0)
    Result<_, MmuError> inv_pd_res = mmu.map_page(0, va, pa, PTE_VALID);
    i32 got_inv_pd = case inv_pd_res of {
        Ok(_) -> 0;
        Err(InvalidDirectory) -> 1;
        Err(AllocFailed) -> 0;
        Err(UnalignedAddress(a)) -> 0;
    };
    assert_eq<i32>(got_inv_pd, 1, "expected Err(InvalidDirectory) for null pd");
    debug.println("mmu: InvalidDirectory reported correctly");

    // 7b. Test UnalignedAddress error (unaligned vaddr)
    Result<_, MmuError> unalign_res = mmu.map_page(pd, va + 123, pa, PTE_VALID);
    i32 got_unaligned = case unalign_res of {
        Ok(_) -> 0;
        Err(UnalignedAddress(a)) -> a;
        Err(AllocFailed) -> 0;
        Err(InvalidDirectory) -> 0;
    };
    assert_eq<i32>(got_unaligned, va + 123, "expected Err(UnalignedAddress(va+123)) for unaligned vaddr");
    debug.println("mmu: UnalignedAddress reported correctly");

    debug.println("[TEST_MMU_SUCCESS]");
}
