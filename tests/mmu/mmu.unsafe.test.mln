import debug from "@kernel/debug/debug.mln";
import heap from "@kernel/mm/heap.mln";
import mem from "@kernel/mm/mem.mln";
import mmu from "@kernel/mm/mmu.mln";
import frames from "@kernel/mm/frames.mln";
import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";
import { assert_eq } from "@std/testing/assert.mln";
import { MmuError } from "@contracts/process/loader.contract.mln";

i32 PTE_VALID    = 0x01;
i32 PTE_WRITABLE = 0x02;

i32 TEST_VA = 0x40000000;
i32 TEST_VAL1 = 0x12345;
i32 TEST_VAL2 = 0x67890;
i32 TEST_VAL3 = 0xABCDE;
i32 TEST_VAL4 = 0x54321;

/*@Test "MMU virtual memory" {
    step: 50000000;
}*/
void mmu_virtual_memory() {
    debug.println("--- Starting MMU & Virtual Memory Test ---");

    heap.init();

    i32 pd = case mmu.create_page_directory() of {
        Some(p) -> p;
        None -> ({
            assert_eq<i32>(1, 0, "failed to allocate root page directory");
            0;
        });
    };
    debug.printf("mmu: root page directory at 0x%x\n", pd);

    // 1. Identity map the kernel execution space & MMIO
    Result<_, MmuError> id_res = mmu.setup_identity_kernel_mapping(pd);
    case id_res of {
        Ok(_) -> 0;
        Err(AllocFailed) -> ({
            assert_eq<i32>(1, 0, "failed to setup identity kernel mapping");
            0;
        });
        Err(InvalidDirectory) -> ({
            assert_eq<i32>(1, 0, "unexpected InvalidDirectory for identity mapping");
            0;
        });
        Err(UnalignedAddress(a)) -> ({
            assert_eq<i32>(1, 0, "unexpected UnalignedAddress for identity mapping");
            0;
        });
        Err(KernelRange(a)) -> ({
            assert_eq<i32>(1, 0, "unexpected KernelRange for identity mapping");
            0;
        });
    };

    // 2. Allocate a physical frame and map high virtual address 0x40000000 (1 GB) to it
    i32 pa = case mmu.alloc_page() of {
        Some(p) -> p;
        None -> ({
            assert_eq<i32>(1, 0, "failed to allocate physical frame");
            0;
        });
    };
    i32 va = TEST_VA;
    
    // Write test signature physically before enabling MMU
    mem.write_word(pa, TEST_VAL1);
    mem.write_word(pa + 4, TEST_VAL2);

    Result<_, MmuError> map_res = mmu.map_page(pd, va, pa, PTE_VALID | PTE_WRITABLE);
    case map_res of {
        Ok(_) -> 0;
        Err(AllocFailed) -> ({
            assert_eq<i32>(1, 0, "map_page failed");
            0;
        });
        Err(InvalidDirectory) -> ({
            assert_eq<i32>(1, 0, "unexpected InvalidDirectory for map_page");
            0;
        });
        Err(UnalignedAddress(a)) -> ({
            assert_eq<i32>(1, 0, "unexpected UnalignedAddress for map_page");
            0;
        });
        Err(KernelRange(a)) -> ({
            assert_eq<i32>(1, 0, "unexpected KernelRange for map_page");
            0;
        });
    };

    // 3. Enable Paging
    mmu.enable_paging(pd);

    // 4. Access virtual address 0x40000000 through MMU translation
    i32 val1 = mem.read_word(va);
    i32 val2 = mem.read_word(va + 4);
    assert_eq<i32>(val1, TEST_VAL1, "virtual address read word 0 mismatch");
    assert_eq<i32>(val2, TEST_VAL2, "virtual address read word 1 mismatch");
    debug.println("mmu: virtual address read verified");

    // 5. Write through virtual address and verify
    mem.write_word(va, TEST_VAL3);
    mem.write_word(va + 4, TEST_VAL4);

    i32 val3 = mem.read_word(va);
    i32 val4 = mem.read_word(va + 4);
    assert_eq<i32>(val3, TEST_VAL3, "virtual address write word 0 mismatch");
    assert_eq<i32>(val4, TEST_VAL4, "virtual address write word 1 mismatch");
    debug.println("mmu: virtual address write verified");

    // 6. Disable Paging and verify physical memory was modified
    mmu.disable_paging();

    i32 pval1 = mem.read_word(pa);
    i32 pval2 = mem.read_word(pa + 4);
    assert_eq<i32>(pval1, TEST_VAL3, "physical backing word 0 mismatch");
    assert_eq<i32>(pval2, TEST_VAL4, "physical backing word 1 mismatch");
    debug.println("mmu: physical memory backing verified");

    // 7. Verify finer-grained MmuError reporting
    // 7a. Test InvalidDirectory error (pd_addr == 0)
    Result<_, MmuError> inv_pd_res = mmu.map_page(0, va, pa, PTE_VALID);
    i32 got_inv_pd = case inv_pd_res of {
        Ok(_) -> 0;
        Err(InvalidDirectory) -> 1;
        Err(AllocFailed) -> 0;
        Err(UnalignedAddress(a)) -> 0;
        Err(KernelRange(a)) -> 0;
    };
    assert_eq<i32>(got_inv_pd, 1, "expected Err(InvalidDirectory) for null pd");
    debug.println("mmu: InvalidDirectory reported correctly");

    // 7b. Test UnalignedAddress error (unaligned vaddr)
    Result<_, MmuError> unalign_res = mmu.map_page(pd, va + 123, pa, PTE_VALID);
    i32 got_unaligned = case unalign_res of {
        Ok(_) -> 0;
        Err(UnalignedAddress(a)) -> a;
        Err(AllocFailed) -> 0;
        Err(InvalidDirectory) -> 0;
        Err(KernelRange(a)) -> 0;
    };
    assert_eq<i32>(got_unaligned, va + 123, "expected Err(UnalignedAddress(va+123)) for unaligned vaddr");
    debug.println("mmu: UnalignedAddress reported correctly");

    // A user page in the kernel's identity mapping would appear in every
    // process, which shares those tables: it is refused.
    i32 kernel_va = 0x00100000;
    i32 refused = case mmu.map_page(pd, kernel_va, pa, PTE_VALID | mmu.PTE_USER) of {
        Ok(_) -> -1;
        Err(KernelRange(a)) -> a;
        Err(_) -> -2;
    };
    assert_eq<i32>(refused, 0, "expected Err(KernelRange(0)) for a user page at 1 MB");

}

/** @return The frame frames.alloc handed out; the test fails on None. */
i32 take_frame(str what) {
    return case frames.alloc() of {
        Some(frame) -> frame;
        None -> ({ assert_eq<i32>(1, 0, what); 0; });
    };
}

/*@Test "frame pool hands frames out and back" {
    step: 50000000;
}*/
void frame_pool_hands_frames_out_and_back() {
    heap.init();
    i32 before = frames.available();
    assert_eq<bool>(before > 0 && before <= frames.total(), true, "the pool has free frames");

    i32 a = take_frame("first frame");
    i32 b = take_frame("second frame");
    assert_eq<i32>(a & 4095, 0, "frames are page aligned");
    assert_eq<i32>(b & 4095, 0, "every frame is page aligned");
    assert_eq<bool>(a != b, true, "two allocations give two frames");
    assert_eq<i32>(frames.available(), before - 2, "allocations leave fewer free");

    // Anything that was not handed out is refused and changes nothing.
    assert_eq<bool>(frames.free(a + 4), false, "an unaligned address is refused");
    assert_eq<bool>(frames.free(0), false, "an address below the pool is refused");
    assert_eq<bool>(frames.free(frames.POOL_END - 4096), false, "a frame never handed out is refused");
    assert_eq<bool>(frames.free(frames.POOL_END), false, "the end of the pool is refused");
    assert_eq<i32>(frames.available(), before - 2, "refused frees change nothing");

    assert_eq<bool>(frames.free(a), true, "a frame handed out is taken back");
    assert_eq<i32>(frames.available(), before - 1, "a freed frame is free again");
    assert_eq<i32>(take_frame("reused frame"), a, "the freed frame is handed out next");
    assert_eq<i32>(frames.available(), before - 2, "reuse takes it off the free list");

    assert_eq<bool>(frames.free(a), true, "first frame back");
    assert_eq<bool>(frames.free(b), true, "second frame back");
    assert_eq<i32>(frames.available(), before, "every frame is back");
}

/** Maps one fresh page at `va` in `pd` with `flags`; the test fails if it cannot. */
void map_test_page(i32 pd, i32 va, i32 flags, str what) {
    i32 frame = take_frame(what);
    bool mapped = case mmu.map_page(pd, va, frame, flags) of { Ok(_) -> true; Err(_) -> false; };
    assert_eq<bool>(mapped, true, what);
}

/** @return Whether the whole range is mapped for the user with `required`. */
bool user_range(i32 pd, i32 addr, i32 bytes, i32 required) {
    return mmu.user_range_has_flags(pd, addr, bytes, required);
}

/**
 * user_range_has_flags is the check every address a process hands a syscall
 * goes through (user_access): a range passes only when every page it touches
 * is the process's, with the flags asked for, and it never wraps. Here a
 * user page sits right below MMIO and another right above the kernel's own
 * RAM, where a range can start on one side and end on the other.
 */
/*@Test "a user range is checked whole, page by page" {
    step: 50000000;
}*/
void a_user_range_is_checked_whole_page_by_page() {
    heap.init();
    i32 pd = case mmu.create_page_directory() of {
        Some(p) -> p;
        None -> ({ assert_eq<i32>(1, 0, "page directory"); 0; });
    };
    bool shared = case mmu.setup_identity_kernel_mapping(pd) of { Ok(_) -> true; Err(_) -> false; };
    assert_eq<bool>(shared, true, "the kernel's identity mapping");
    i32 rw = PTE_VALID | PTE_WRITABLE | mmu.PTE_USER;
    i32 ro = PTE_VALID | mmu.PTE_USER;
    i32 read = mmu.PTE_USER;
    i32 write = mmu.PTE_USER | mmu.PTE_WRITABLE;
    map_test_page(pd, 0x40000000, rw, "a read-write user page");
    map_test_page(pd, 0x40001000, ro, "a read-only user page after it");
    map_test_page(pd, 0x23FFF000, rw, "a user page right below MMIO");
    map_test_page(pd, 0x20000000, rw, "a user page right above the kernel's RAM");
    map_test_page(pd, 0x7FFFF000, rw, "the last user page");

    assert_eq<bool>(user_range(pd, 0x40000000, 4096, write), true, "a whole writable page passes");
    assert_eq<bool>(user_range(pd, 0x40000FF0, 32, read), true, "a range across two user pages passes for reading");
    assert_eq<bool>(user_range(pd, 0x40000FF0, 32, write), false, "but not for writing: the second is read-only");
    assert_eq<bool>(user_range(pd, 0x40001FF0, 32, read), false, "a range that runs past the mapped pages is refused");

    assert_eq<bool>(user_range(pd, 0x00100000, 16, read), false, "the kernel's image is refused");
    assert_eq<bool>(user_range(pd, mmu.MMU_PDBR_ADDR, 4, read), false, "the MMU's registers are refused");
    assert_eq<bool>(user_range(pd, 0x30000000, 16, read), false, "VRAM is refused");
    assert_eq<bool>(user_range(pd, 0x23FFFFF0, 16, write), true, "a range that ends at the MMIO boundary passes");
    assert_eq<bool>(user_range(pd, 0x23FFFFF0, 32, read), false, "one that runs on into MMIO is refused");
    assert_eq<bool>(user_range(pd, 0x20000000, 16, write), true, "a range that starts at the kernel's boundary passes");
    assert_eq<bool>(user_range(pd, 0x1FFFFFF0, 32, read), false, "one that starts in the kernel's RAM is refused");

    assert_eq<bool>(user_range(pd, 0x7FFFF000, 4096, write), true, "a range that ends at the top of the user half passes");
    assert_eq<bool>(user_range(pd, 0x7FFFFFFC, 4, write), true, "and so does its last word");
    assert_eq<bool>(user_range(pd, 0x7FFFFFFC, 8, read), false, "a range past the top of the user half is refused");
    assert_eq<bool>(user_range(pd, 0x7FFFFFF0, 0x7FFFFFFF, read), false, "a length that wraps the sum is refused");
    assert_eq<bool>(user_range(pd, 0x7FFFFFF0, 0x40000020, read), false, "even when the sum wraps back into user pages");
    assert_eq<bool>(user_range(pd, 0xFFFFF000, 16, read), false, "an address in the top half is refused");
    assert_eq<bool>(user_range(pd, 0x40000000, 0, read), false, "an empty range is refused");
    assert_eq<bool>(user_range(pd, 0x40000000, -16, read), false, "a negative length is refused");
    assert_eq<bool>(user_range(0, 0x40000000, 16, read), false, "no page directory has no user pages");
}
