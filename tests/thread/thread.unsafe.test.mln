namespace test_thread;

import heap from "@kernel/mm/heap.mln";
import mem from "@kernel/mm/mem.mln";
import mmu from "@kernel/mm/mmu.mln";
import frames from "@kernel/mm/frames.mln";
import process from "@kernel/kernel/process.mln";
import { ProcessState } from "@kernel/kernel/process.mln";
import scheduler from "@kernel/kernel/scheduler.mln";
import thread from "@kernel/kernel/thread.mln";
import { ThreadState, JoinOutcome } from "@kernel/kernel/thread.mln";
import loader from "@kernel/kernel/loader.mln";
import syscall from "@kernel/kernel/syscall.mln";
import { SyscallError } from "@kernel/kernel/syscall.mln";
import user_access from "@kernel/kernel/user_access.mln";
import { UserAccess } from "@kernel/kernel/user_access.mln";
import serial from "@kernel/io/serial.mln";
import { UserAddress } from "@std/core/address.mln";
import { ThreadSpawnArgs, ThreadError } from "@contracts/process/thread.contract.mln";
import { Pid, ProcessExitStatus } from "@contracts/process/control.contract.mln";
import { SyscallStatus, SyscallFailure, Syscall } from "@contracts/myos/syscall.contract.mln";
import { OsServiceError } from "@contracts/myos/services.contract.mln";
import { SpawnError } from "@contracts/process/spawn.contract.mln";
import { Result } from "@std/core/result.mln";
import { assert_eq } from "@std/testing/assert.mln";
import testkit from "../../../../toolchain/MyLangTestKit/runtime/testkit.mln";

/** Starts the kernel state the tests here share, with no process yet. */
void boot() {
    heap.init();
    process.init();

    i32 kernel_pd = case mmu.create_page_directory() of {
        Some(value) -> value;
        None -> ({ assert_eq<i32>(1, 0, "kernel page directory"); 0; });
    };
    case mmu.setup_identity_kernel_mapping(kernel_pd) of {
        Ok(_) -> _;
        Err(_) -> ({ assert_eq<i32>(1, 0, "kernel identity mapping"); });
    };
    scheduler.init();
}

/**
 * A minimal MBIN v2 image: these lifecycle tests only need one executable
 * word, and never dispatch it.
 * @return Address of the 40-byte image.
 */
i32 halt_image() {
    i32 image = case heap.alloc(40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "test image allocation"); 0; });
    };
    mem.write_word(image + 0, 0x4D42494E);  // magic: 'MBIN'
    mem.write_word(image + 4, 2);           // version
    mem.write_word(image + 8, 0x40000000);  // entry_point
    mem.write_word(image + 12, 36);         // text_offset
    mem.write_word(image + 16, 4);          // text_size
    mem.write_word(image + 20, 40);         // data_offset
    mem.write_word(image + 24, 0);          // data_size
    mem.write_word(image + 28, 0);          // bss_size
    mem.write_word(image + 32, 0);          // sections_offset: none
    mem.write_word(image + 36, 0xFC000000); // halt
    return image;
}

/**
 * Exercises TCB publication, join wake/reap, futex wake, and process-wide
 * cleanup without executing the synthetic user instructions.
 */
/*@Test "user thread lifecycle" {
    step: 50000000;
}*/
void user_thread_lifecycle() {
    SyscallFailure invalid_tid_failure = SyscallFailure {
        status: SyscallStatus::InvalidThreadId,
        payload: 77,
    };
    ThreadError converted = ThreadError::from(invalid_tid_failure);
    i32 converted_tid = case converted of { ThreadError::InvalidTid(value) -> value; _ -> -1; };
    assert_eq<i32>(converted_tid, 77, "From<SyscallFailure> preserves payload");

    boot();
    i32 image = halt_image();
    Pid pid = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "main process creation"); return; });
    };
    assert_eq<i32>(process.live_thread_count(pid).unwrap_or(0), 1, "main TCB accounted");

    i32 main_slot = 1;
    i32 main_tid = thread.tid_at(main_slot).unwrap_or(0);
    thread.set_current_slot(main_slot);
    thread.make_running(main_slot);

    ThreadSpawnArgs args = ThreadSpawnArgs {
        entry: 0x40000000,
        arg0: 11,
        arg1: 22,
        stack_bytes: 8192,
    };
    i32 worker_tid = case thread.spawn_user_thread(pid, args) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "worker creation"); 0; });
    };
    assert_eq<bool>(worker_tid != main_tid, true, "TID differs from main");
    assert_eq<i32>(process.live_thread_count(pid).unwrap_or(0), 2, "worker live count");
    i32 worker_slot = thread.slot_for_tid(worker_tid).unwrap_or(-1);

    i32 scratch_address = loader.USER_STACK_BASE;
    bool joined_now = case thread.join_thread(worker_tid) of {
        Ok(outcome) -> case outcome of { JoinOutcome::Completed(_) -> true; JoinOutcome::Waiting -> false; };
        Err(_) -> ({ assert_eq<i32>(1, 0, "join registration"); true; });
    };
    assert_eq<bool>(joined_now, false, "live target blocks joiner");
    bool main_blocked = case thread.state_at(main_slot) of {
        Some(state) -> case state of { ThreadState::Blocked(_) -> true; _ -> false; };
        None -> false;
    };
    assert_eq<bool>(main_blocked, true, "joiner is blocked");

    thread.set_current_slot(worker_slot);
    thread.make_running(worker_slot);
    thread.exit_current_thread(37);
    thread.finish_deferred_cleanup(worker_slot);
    i32 pdbr = process.get_pdbr(pid).unwrap_or(0);
    assert_eq<i32>(mem.read_word(thread.saved_kernel_sp(main_slot) + 24), (i32)SyscallStatus::Ok, "join status returned in r1");
    assert_eq<i32>(mem.read_word(thread.saved_kernel_sp(main_slot) + 20), 37, "join exit code returned in r2");
    assert_eq<i32>(process.retained_thread_count(pid).unwrap_or(0), 1, "joined TCB reaped");
    bool main_runnable = case thread.state_at(main_slot) of {
        Some(state) -> case state of { ThreadState::Runnable -> true; _ -> false; };
        None -> false;
    };
    assert_eq<bool>(main_runnable, true, "joiner was woken");

    thread.set_current_slot(main_slot);
    thread.make_running(main_slot);
    i32 futex_addr = scratch_address + 4;
    mmu.write_user_word(pdbr, futex_addr, 2);
    case thread.futex_wait(futex_addr, 2, 0, 0) of {
        Ok(_) -> _;
        Err(_) -> ({ assert_eq<i32>(1, 0, "futex wait registration"); });
    };
    ThreadSpawnArgs second_args = ThreadSpawnArgs {
        entry: 0x40000000,
        arg0: 33,
        arg1: 44,
        stack_bytes: 8192,
    };
    i32 second_tid = case thread.spawn_user_thread(pid, second_args) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "futex waker creation"); 0; });
    };
    i32 second_slot = thread.slot_for_tid(second_tid).unwrap_or(-1);
    thread.set_current_slot(second_slot);
    thread.make_running(second_slot);
    i32 woken = case thread.futex_wake(futex_addr, 1) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "futex wake"); 0; });
    };
    assert_eq<i32>(woken, 1, "one futex waiter woke");
    assert_eq<i32>(mem.read_word(thread.saved_kernel_sp(main_slot) + 24), (i32)SyscallStatus::Ok, "futex wake status returned in r1");
    assert_eq<i32>(mem.read_word(thread.saved_kernel_sp(main_slot) + 20), 0, "futex wake value returned in r2");
    main_runnable = case thread.state_at(main_slot) of {
        Some(state) -> case state of { ThreadState::Runnable -> true; _ -> false; };
        None -> false;
    };
    assert_eq<bool>(main_runnable, true, "futex waiter runnable");

    ProcessExitStatus status = ProcessExitStatus::Code(9);
    thread.exit_process_threads(pid, status);
    thread.finish_deferred_cleanup(second_slot);
    bool zombie = case process.get_state(pid) of {
        Some(state) -> case state of { ProcessState::Zombie(_) -> true; _ -> false; };
        None -> false;
    };
    assert_eq<bool>(zombie, true, "process reaches Zombie after resource cleanup");
    assert_eq<i32>(process.retained_thread_count(pid).unwrap_or(-1), 0, "all TCBs released");

    heap.free(image);
    testkit.pass("user thread lifecycle");
}

/**
 * Ends a process from outside while one of its threads is still parked for
 * the next reschedule. Terminating must take that thread off the scheduler's
 * hands: its slot is free afterwards, and a thread reusing it is not retired.
 */
/*@Test "terminating a process drops its parked thread" {
    step: 50000000;
}*/
void terminating_a_process_drops_its_parked_thread() {
    boot();
    i32 image = halt_image();
    i32 kernel_slot = 0;
    Pid pid = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "victim creation"); return; });
    };
    i32 main_slot = 1;
    thread.set_current_slot(main_slot);
    thread.make_running(main_slot);
    ThreadSpawnArgs args = ThreadSpawnArgs {
        entry: 0x40000000,
        arg0: 0,
        arg1: 0,
        stack_bytes: 8192,
    };
    i32 worker_tid = case thread.spawn_user_thread(pid, args) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "worker creation"); 0; });
    };
    i32 worker_slot = thread.slot_for_tid(worker_tid).unwrap_or(-1);

    // The worker exits and is switched away: its cleanup waits for a reschedule.
    thread.set_current_slot(worker_slot);
    thread.make_running(worker_slot);
    thread.exit_current_thread(5);
    scheduler.reschedule(0);

    // From here this test is the kernel task doing the terminating.
    thread.set_current_slot(kernel_slot);
    ProcessExitStatus hangup = ProcessExitStatus::Code(9);
    scheduler.terminate(pid, hangup);
    bool zombie = case process.get_state(pid) of {
        Some(state) -> case state of { ProcessState::Zombie(_) -> true; _ -> false; };
        None -> false;
    };
    assert_eq<bool>(zombie, true, "the process is a Zombie when terminate returns");
    assert_eq<i32>(process.retained_thread_count(pid).unwrap_or(-1), 0, "all its TCBs are released");
    assert_eq<bool>(thread.occupied(worker_slot), false, "the parked thread's slot is free");

    // Terminating is for an Alive process; doing it again changes nothing.
    ProcessExitStatus again = ProcessExitStatus::Code(1);
    scheduler.terminate(pid, again);
    i32 code = case process.get_exit_status(pid) of {
        Some(status) -> case status of { ProcessExitStatus::Code(value) -> value; _ -> -1; };
        None -> -1;
    };
    assert_eq<i32>(code, 9, "the first status stands");

    // A new thread takes the slot before the reschedule that had it parked.
    Pid next = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "next process creation"); return; });
    };
    i32 reused_tid = case thread.spawn_user_thread(next, args) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "reusing thread creation"); 0; });
    };
    assert_eq<i32>(thread.slot_for_tid(reused_tid).unwrap_or(-1), worker_slot, "the slot is reused");
    scheduler.reschedule(0);
    bool retired = case thread.state_at(worker_slot) of {
        Some(state) -> case state of { ThreadState::Zombie(_) -> true; _ -> false; };
        None -> true;
    };
    assert_eq<bool>(retired, false, "the reschedule leaves the new thread alone");

    heap.free(image);
    testkit.pass("terminating a process drops its parked thread");
}

/**
 * Time goes to what was running: the process of a user thread, the kernel for
 * a kernel thread, idle when nothing ran. A process's pages are its program
 * and its main stack.
 */
/*@Test "time is charged to what was running" {
    step: 50000000;
}*/
void time_is_charged_to_what_was_running() {
    boot();
    i32 image = halt_image();
    Pid pid = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "process creation"); return; });
    };
    i32 kernel_slot = 0;
    i32 main_slot = 1;
    assert_eq<i32>(process.cpu_time(pid).unwrap_or(-1), 0, "a new process has used no time");

    i32 kernel_before = scheduler.kernel_time();
    i32 idle_before = scheduler.idle_time();
    scheduler.charge_to(Some(main_slot));
    scheduler.charge(512);
    scheduler.charge_to(Some(kernel_slot));
    scheduler.charge(256);
    scheduler.charge_to(None);
    scheduler.charge(300);

    assert_eq<i32>(process.cpu_time(pid).unwrap_or(-1), 512, "the process's thread ran for two ticks");
    assert_eq<i32>(scheduler.kernel_time() - kernel_before, 256, "a kernel thread's time is the kernel's");
    assert_eq<i32>(scheduler.idle_time() - idle_before, 300, "time with nothing running is idle");

    i32 pdbr = process.get_pdbr(pid).unwrap_or(0);
    assert_eq<i32>(mmu.count_user_pages(pdbr), 5, "one page of program and four of stack");
    assert_eq<i32>(mmu.count_user_pages(0), 0, "no directory, no pages");

    heap.free(image);
    testkit.pass("time is charged to what was running");
}

/** @return The break sys_sbrk handed back, or -1 when it failed. */
i32 sbrk_value(Result<i32, SyscallError> result) {
    return case result of { Ok(value) -> value; Err(_) -> -1; };
}

/** @return Whether sys_sbrk refused with HeapOverflow. */
bool sbrk_overflowed(Result<i32, SyscallError> result) {
    return case result of { Err(SyscallError::HeapOverflow) -> true; _ -> false; };
}

/**
 * sys_sbrk grows the heap a page at a time and never past the stack region,
 * however large the increment: a sum that wraps past i32 is refused too.
 */
/*@Test "sbrk stays below the stack region" {
    step: 50000000;
}*/
void sbrk_stays_below_the_stack_region() {
    boot();
    i32 image = halt_image();
    Pid pid = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "process creation"); return; });
    };
    thread.set_current_slot(1);
    thread.make_running(1);
    i32 pdbr = process.get_pdbr(pid).unwrap_or(0);
    i32 start = process.get_heap_break(pid).unwrap_or(0);

    assert_eq<i32>(sbrk_value(syscall.sys_sbrk(0)), start, "sbrk(0) returns the break");
    assert_eq<i32>(sbrk_value(syscall.sys_sbrk(4096)), start, "sbrk returns the old break");
    i32 grown = process.get_heap_break(pid).unwrap_or(0);
    assert_eq<i32>(grown, start + 4096, "the break moved by the increment");
    assert_eq<bool>(mmu.user_range_has_flags(pdbr, start, 4096, mmu.PTE_USER | mmu.PTE_WRITABLE), true,
                    "the new heap page is mapped for the user");

    assert_eq<i32>(sbrk_value(syscall.sys_sbrk(-4096)), grown, "a negative increment returns the break");
    assert_eq<i32>(process.get_heap_break(pid).unwrap_or(0), grown, "a negative increment does not move it");

    assert_eq<bool>(sbrk_overflowed(syscall.sys_sbrk(thread.USER_STACK_REGION_BASE - grown)), true,
                    "reaching the stack region is refused");
    assert_eq<bool>(sbrk_overflowed(syscall.sys_sbrk(0x7FFFFFFF)), true,
                    "an increment that wraps is refused");
    assert_eq<i32>(process.get_heap_break(pid).unwrap_or(0), grown, "refusals leave the break alone");

    heap.free(image);
    testkit.pass("sbrk stays below the stack region");
}

/** @return Whether sys_sbrk refused with OutOfMemory. */
bool sbrk_ran_out(Result<i32, SyscallError> result) {
    return case result of { Err(SyscallError::OutOfMemory) -> true; _ -> false; };
}

/**
 * Takes frames until only `left` are free. Each frame's first word names the
 * one taken before it, so give_back_frames can find them all.
 * @return The last frame taken, or 0 when none was.
 */
i32 take_frames_until(i32 left) {
    i32 chain = 0;
    while (frames.available() > left) {
        i32 frame = frames.alloc().unwrap_or(0);
        if (frame == 0) { return chain; }
        mem.write_word(frame, chain);
        chain = frame;
    }
    return chain;
}

/** Hands back every frame of a chain take_frames_until made. */
void give_back_frames(i32 chain) {
    i32 frame = chain;
    while (frame != 0) {
        i32 next = mem.read_word(frame);
        frames.free(frame);
        frame = next;
    }
}

/**
 * When the frames run out halfway, sys_sbrk unmaps and frees the pages it
 * had already mapped: the break does not move, so nothing else would give
 * them back, and the next sbrk would map over them.
 */
/*@Test "a failed sbrk gives back the pages it mapped" {
    step: 200000000;
}*/
void a_failed_sbrk_gives_back_the_pages_it_mapped() {
    boot();
    i32 image = halt_image();
    Pid pid = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "process creation"); return; });
    };
    thread.set_current_slot(1);
    thread.make_running(1);
    i32 pdbr = process.get_pdbr(pid).unwrap_or(0);
    // One page first, so the heap's page table is there before frames run short.
    i32 start = process.get_heap_break(pid).unwrap_or(0);
    assert_eq<i32>(sbrk_value(syscall.sys_sbrk(4096)), start, "the first heap page");
    i32 brk = process.get_heap_break(pid).unwrap_or(0);
    i32 pages = mmu.count_user_pages(pdbr);

    i32 held = take_frames_until(2);
    assert_eq<i32>(frames.available(), 2, "two frames are left");
    assert_eq<bool>(sbrk_ran_out(syscall.sys_sbrk(3 * 4096)), true, "three pages do not fit in two frames");
    assert_eq<i32>(frames.available(), 2, "the two pages it mapped are free again");
    assert_eq<i32>(mmu.count_user_pages(pdbr), pages, "and mapped no more");
    assert_eq<i32>(process.get_heap_break(pid).unwrap_or(0), brk, "the break stays");

    assert_eq<i32>(sbrk_value(syscall.sys_sbrk(2 * 4096)), brk, "two pages still fit");
    assert_eq<i32>(frames.available(), 0, "in the two frames");
    assert_eq<i32>(mmu.count_user_pages(pdbr), pages + 2, "both mapped");

    give_back_frames(held);
    heap.free(image);
    testkit.pass("a failed sbrk gives back the pages it mapped");
}

/** @return Whether a console syscall was refused with BadAddress. */
bool refused_address(Result<i32, SyscallError> result) {
    return case result of { Err(SyscallError::BadAddress) -> true; _ -> false; };
}

/**
 * The serial console the kernel starts with reads and writes only the
 * caller's own user pages: a kernel address moves no bytes either way, and
 * the syscall says why.
 */
/*@Test "the serial console refuses kernel buffers" {
    step: 50000000;
}*/
void the_serial_console_refuses_kernel_buffers() {
    boot();
    i32 image = halt_image();
    Pid pid = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "process creation"); return; });
    };
    thread.set_current_slot(1);
    thread.make_running(1);

    i32 kernel_buf = case heap.alloc(8) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "kernel buffer allocation"); 0; });
    };
    mem.write_word(kernel_buf, 0);
    assert_eq<bool>(refused_address(syscall.sys_write(1, UserAddress(kernel_buf), 4)), true,
                    "write from a kernel address is refused");

    serial.input_push('A');
    assert_eq<bool>(refused_address(syscall.sys_read(0, UserAddress(kernel_buf), 1)), true,
                    "read into a kernel address is refused");
    assert_eq<i32>(mem.read_word(kernel_buf), 0, "the kernel buffer is unchanged");
    assert_eq<i32>(serial.read_input().unwrap_or(-1), 'A', "and the input is still there");

    heap.free(kernel_buf);
    heap.free(image);
    testkit.pass("the serial console refuses kernel buffers");
}

// --- user_access: the one way into a process's memory -------------------------------

/** Starts halt_image's process and makes it current on slot 1, as a syscall finds it. */
Pid start_caller() {
    boot();
    i32 image = halt_image();
    Pid pid = case loader.spawn_from_buffer(None, image, 40) of {
        Ok(value) -> value;
        Err(_) -> ({ assert_eq<i32>(1, 0, "process creation"); return Pid(0); });
    };
    thread.set_current_slot(1);
    thread.make_running(1);
    return pid;
}

/** @return A kernel heap word holding `value`: memory no process may name. */
i32 kernel_word(i32 value) {
    i32 address = case heap.alloc(4) of {
        Ok(pointer) -> pointer;
        Err(_) -> ({ assert_eq<i32>(1, 0, "kernel buffer allocation"); 0; });
    };
    mem.write_word(address, value);
    return address;
}

i32 refused_at() {
    return case user_access.refused() of { Some(address) -> (i32)address; None -> 0; };
}

/**
 * user_access copies through the frames the process maps a range to, after
 * checking all of it: a range that is not all the process's moves nothing
 * and fails the syscall at its first address. Paging is off here, so a copy
 * that took the address as it is would reach the kernel's own memory.
 */
/*@Test "user_access moves only the caller's own memory" {
    step: 50000000;
}*/
void user_access_moves_only_the_callers_own_memory() {
    Pid pid = start_caller();
    i32 pdbr = process.get_pdbr(pid).unwrap_or(0);
    i32 stack = loader.USER_STACK_BASE;
    i32 secret = kernel_word(0x5EC2E7);
    i32 target = kernel_word(0x7A26E7);

    // Across the boundary between two stack pages, and back.
    char out[8];
    char back[8];
    i32 k = 0;
    while (k < 8) { out[k] = (char)(65 + k); back[k] = (char)0; k++; }
    user_access.begin();
    assert_eq<bool>(user_access.copy_to(pid, UserAddress(stack + 4092), &out[0], 8), true, "a copy out across two pages");
    assert_eq<i32>(mmu.read_user_word(pdbr, stack + 4092).unwrap_or(0), 0x41424344, "lands in the first page");
    assert_eq<i32>(mmu.read_user_word(pdbr, stack + 4096).unwrap_or(0), 0x45464748, "and the second");
    assert_eq<bool>(user_access.copy_from(pid, UserAddress(stack + 4092), &back[0], 8), true, "a copy in across them");
    assert_eq<i32>((i32)back[7], 72, "brings every byte back");
    assert_eq<bool>(user_access.refused().is_none(), true, "and nothing was refused");

    // The kernel's memory, either way: nothing moves, and the call fails there.
    assert_eq<bool>(user_access.copy_from(pid, UserAddress(secret), &back[0], 4), false, "a kernel word is not read");
    assert_eq<i32>((i32)back[0], 65, "and the buffer keeps what it had");
    assert_eq<bool>(user_access.copy_to(pid, UserAddress(target), &out[0], 4), false, "a kernel word is not written");
    assert_eq<i32>(mem.read_word(target), 0x7A26E7, "and keeps its value");
    assert_eq<i32>(refused_at(), secret, "the call fails at the first address refused");

    // The process's own text is for reading.
    user_access.begin();
    assert_eq<bool>(user_access.check(pid, UserAddress(0x40000000), 4, UserAccess::READ), true, "its text can be read");
    assert_eq<bool>(user_access.refused().is_none(), true, "and a check that passes fails nothing");
    assert_eq<bool>(user_access.check(pid, UserAddress(0x40000000), 4, UserAccess::WRITE), false, "but not written");
    assert_eq<i32>(refused_at(), 0x40000000, "which fails the call there");

    // Ranges that wrap, straddle, or are empty.
    user_access.begin();
    assert_eq<bool>(user_access.check(pid, UserAddress(stack + 16), 0x7FFFFFF0, UserAccess::READ), false,
                    "a length that wraps is refused");
    assert_eq<bool>(user_access.check(pid, UserAddress(stack - 16), 32, UserAccess::READ), false,
                    "a range from below the stack into it is refused");
    assert_eq<bool>(user_access.check(pid, UserAddress(0x7FFFF000), 4096, UserAccess::WRITE), true,
                    "the top stack page, up to the end of the user half, passes");
    assert_eq<bool>(user_access.check(pid, UserAddress(0x7FFFFFFC), 8, UserAccess::READ), false,
                    "a range past the end of the user half is refused");
    assert_eq<bool>(user_access.check(pid, UserAddress(stack), 0, UserAccess::READ), false, "an empty range is refused");
    assert_eq<bool>(user_access.check(pid, UserAddress(stack), -4, UserAccess::READ), false, "so is a negative one");
    assert_eq<i32>(refused_at(), stack + 16, "the first refusal is the one reported");
    assert_eq<bool>(user_access.copy_from(pid, UserAddress(secret), &back[0], 0), true, "an empty copy moves nothing");
    assert_eq<bool>(user_access.check(Pid(0), UserAddress(stack), 4, UserAccess::READ), false, "no process has no memory");

    user_access.begin();
    assert_eq<bool>(user_access.refused().is_none(), true, "begin() starts the next syscall clean");
    testkit.pass("user_access moves only the caller's own memory");
}

/** A frame as the caller's trap leaves it: r1 the number, r5..r7 the arguments. */
i32 g_frame[16];

/**
 * Makes a syscall as the current process does, through dispatch.
 * @param value Gets r2: the value, or the error's detail.
 * @return r1: the status.
 */
SyscallStatus call(i32 number, i32 arg1, i32 arg2, i32 arg3, i32 *value) {
    i32 frame = (i32)(&g_frame[0]);
    i32 offset = 0;
    while (offset < 64) {
        mem.write_word(frame + offset, 0);
        offset = offset + 4;
    }
    mem.write_word(frame + 24, number);
    mem.write_word(frame + 8, arg1);
    mem.write_word(frame + 4, arg2);
    mem.write_word(frame + 0, arg3);
    SyscallStatus status = SyscallStatus::Ok;
    case syscall.dispatch(frame) of {
        Ok(outcome) -> ({ status = outcome.status; *value = outcome.value; });
        Err(error) -> ({ status = syscall.error_status(error); *value = 0; });
    };
    return status;
}

/** An OS_CALL handler that reads a word of its record, as MyOS's endpoints do. */
Result<i32, OsServiceError> probing_os_handler(Pid pid, i32 service, UserAddress args) {
    char record[4];
    if (!user_access.copy_from(pid, args, &record[0], 4)) { return Ok(0); }
    if (service == 99) { return Err(OsServiceError::UnknownService(service)); }
    return Ok(7);
}

/** A SYS_SPAWN hook that reads its path, as MyOS's does, and never starts anything. */
Result<Pid, SpawnError> probing_spawn_handler(UserAddress path) {
    char first[1];
    Pid pid = thread.current_pid().unwrap_or(Pid(0));
    if (!user_access.copy_from(pid, path, &first[0], 1)) { return Err(SpawnError::NotFound); }
    return Err(SpawnError::NoHandler);
}

/**
 * A syscall that names memory the caller does not have answers BadAddress
 * with that address in r2, the way THREAD_SPAWN does: SYS_READ and SYS_WRITE
 * before the console hook runs, SYS_SPAWN and OS_CALL whatever their hook or
 * handler returns once it was refused.
 */
/*@Test "a syscall that names kernel memory answers BadAddress" {
    step: 50000000;
}*/
void a_syscall_that_names_kernel_memory_answers_bad_address() {
    Pid pid = start_caller();
    i32 stack = loader.USER_STACK_BASE;
    i32 secret = kernel_word(0x5EC2E7);
    i32 value = 0;
    i32 bad = (i32)SyscallStatus::BadAddress;

    assert_eq<i32>((i32)call(Syscall::WRITE, 1, secret, 4, &value), bad, "SYS_WRITE from kernel memory");
    assert_eq<i32>(value, secret, "names the address in r2");
    assert_eq<i32>((i32)call(Syscall::WRITE, 1, stack, 4, &value), (i32)SyscallStatus::Ok, "SYS_WRITE from its stack");
    assert_eq<i32>(value, 4, "writes every byte");
    assert_eq<i32>((i32)call(Syscall::WRITE, 1, secret, 0, &value), (i32)SyscallStatus::Ok, "an empty write");
    assert_eq<i32>(value, 0, "moves nothing, wherever it points");

    serial.input_push('Q');
    assert_eq<i32>((i32)call(Syscall::READ, 0, secret, 1, &value), bad, "SYS_READ into kernel memory");
    assert_eq<i32>(mem.read_word(secret), 0x5EC2E7, "leaves it alone");
    assert_eq<i32>((i32)call(Syscall::READ, 0, 0x40000000, 1, &value), bad, "SYS_READ into its read-only text");
    assert_eq<i32>(value, 0x40000000, "names that address");
    assert_eq<i32>((i32)call(Syscall::READ, 0, stack, 1, &value), (i32)SyscallStatus::Ok, "SYS_READ into its stack");
    assert_eq<i32>(value, 1, "takes the input that waited");

    syscall.set_os_handler(probing_os_handler);
    assert_eq<i32>((i32)call(Syscall::OS_CALL, 1, stack, 0, &value), (i32)SyscallStatus::Ok, "an OS_CALL record on its stack");
    assert_eq<i32>(value, 7, "gets the handler's answer");
    assert_eq<i32>((i32)call(Syscall::OS_CALL, 1, secret, 0, &value), bad, "an OS_CALL record in kernel memory");
    assert_eq<i32>(value, secret, "fails at it, whatever the handler returned");
    assert_eq<i32>((i32)call(Syscall::OS_CALL, 99, stack, 0, &value), (i32)SyscallStatus::UnknownService,
                   "a refusal does not outlive its call");

    syscall.set_spawn_handler(probing_spawn_handler);
    assert_eq<i32>((i32)call(Syscall::SPAWN, secret, 0, 0, &value), bad, "SYS_SPAWN with a path in kernel memory");
    assert_eq<i32>(value, secret, "names the path");
    assert_eq<i32>((i32)call(Syscall::SPAWN, stack, 0, 0, &value), (i32)SyscallStatus::SpawnFailed,
                   "with a path of its own, the hook's own answer stands");
    testkit.pass("a syscall that names kernel memory answers BadAddress");
}
