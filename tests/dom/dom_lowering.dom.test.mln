import assert from "../../../../toolchain/MyStdLib/assert.mln";

// End-to-end check of the .dom.mln lowering contract: a tag calls the function
// of the same name, a property is handed to the parameter of the same name
// whatever order it is written in, and children are attached with append_child.

i32 g_clicks = 0;
i32 g_appends = 0;

void on_click(i32 id) {
    assert.assert_true(id == 99, "Button onClick receives the indirect-call id");
    g_clicks = g_clicks + 1;
}

i32 Window(char *title, i32 x, i32 y, i32 w, i32 h) {
    assert.assert_str_eq(title, "Root", "Window title property");
    assert.assert_true(x == 1 && y == 2 && w == 3 && h == 4,
                       "Window properties map by name");
    return 10;
}

i32 Button(char *text, i32 x, i32 y, i32 w, i32 h, i32 onClick) {
    assert.assert_str_eq(text, "OK", "Button text property");
    assert.assert_true(x == 5 && y == 6 && w == 7 && h == 8,
                       "Button out-of-order properties map by name");
    onClick(99);
    return 20;
}

i32 Text(char *text, i32 x, i32 y) {
    assert.assert_str_eq(text, "hi", "Text property");
    assert.assert_true(x == 9 && y == 10, "Text coordinates");
    return 30;
}

i32 Box(i32 x, i32 y, i32 w, i32 h, i32 background, i32 border) {
    assert.assert_true(x == 10 && y == 13 && w == 15 && h == 14
                       && background == 11 && border == 12,
                       "Box out-of-order properties map by name");
    return 40;
}

i32 Column(i32 x, i32 y, i32 w, i32 h, i32 padding, i32 gap) {
    assert.assert_true(x == 30 && y == 31 && w == 40 && h == 50
                       && padding == 5 && gap == 6,
                       "Column out-of-order properties map by name");
    return 50;
}

void append_child(i32 parent, i32 child) {
    if (g_appends == 0) {
        assert.assert_true(parent == 10 && child == 20, "Button appends to Window first");
    } else if (g_appends == 1) {
        assert.assert_true(parent == 10 && child == 40, "Box appends to Window second");
    } else if (g_appends == 2) {
        assert.assert_true(parent == 10 && child == 50, "Column appends to Window third");
    } else if (g_appends == 3) {
        assert.assert_true(parent == 10 && child == 30, "Text appends to Window fourth");
    } else {
        assert.assert_true(0, "unexpected DOM append");
    }
    g_appends = g_appends + 1;
}

/*@Test "dom lowering" {
    step: 10000000;
}*/
void dom_lowering() {
    // Properties are deliberately written out of signature order.
    i32 root = <Window title="Root" x={1} y={2} w={3} h={4}>
        <Button x={5} text="OK" onClick={on_click} y={6} w={7} h={8} />
        <Box background={11} h={14} x={10} border={12} y={13} w={15} />
        <Column gap={6} x={30} h={50} y={31} padding={5} w={40} />
        <Text text="hi" x={9} y={10} />
    </Window>;

    assert.assert_true(root == 10, "Window return value becomes root expression");
    assert.assert_true(g_clicks == 1, "Button callback is invoked once");
    assert.assert_true(g_appends == 4, "every direct Window child is appended once");
}
